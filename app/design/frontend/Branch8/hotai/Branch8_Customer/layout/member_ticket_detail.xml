<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd" layout="1column">
    <update handle="customer_account"/>
    <head>
        <title>票券詳情</title>
    </head>
    <body>
        <referenceContainer name="content">
            <block class="Branch8\Customer\Block\Ticket\Detail"
                   name="branch8_customer_account_ticket_detail"
                   template="Branch8_Customer::ticket/detail.phtml"
                   cacheable="false"
                   />
        </referenceContainer>

        <referenceBlock name="breadcrumbs">
            <action method="addCrumb">
                <argument name="crumbName" xsi:type="string" translate="true">回到票券主頁</argument>
                <argument name="crumbInfo" xsi:type="array">
                    <item name="label" xsi:type="string" translate="true">回到票券主頁</item>
                    <item name="title" xsi:type="string" translate="true">回到票券主頁</item>
                    <item name="link" xsi:type="string">/member/ticket/index</item>
                </argument>
            </action>
        </referenceBlock>

        <move element="breadcrumbs" destination="page.top" after="-"/>
    </body>
</page>
