<layout xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_layout.xsd">
    <update handle="1column" />
    <body>
        <attribute name="class" value="category-promotion-listing-page"/>
    </body>
    <referenceContainer name="page.wrapper">
        <block class="Magento\Framework\View\Element\Template" name="landing.script" template="Magento_Catalog::category/script.phtml" after="footer-container"/>
    </referenceContainer>
    <referenceBlock name="category.image" remove="true" />
    <referenceBlock name="product_recommendations_category_below_content" remove="true" />
    <referenceBlock name="product_recommendations_category_before_content" remove="true" />
</layout>
