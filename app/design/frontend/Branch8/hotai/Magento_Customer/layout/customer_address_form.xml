<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd" layout="1column">
    <referenceBlock name="breadcrumbs">
        <action method="addCrumb">
            <argument name="crumbName" xsi:type="string" translate="true">回到地址管理</argument>
            <argument name="crumbInfo" xsi:type="array">
                <item name="label" xsi:type="string" translate="true">回到地址管理</item>
                <item name="title" xsi:type="string" translate="true">回到地址管理</item>
                <item name="link" xsi:type="string">/customer/address</item>
            </argument>
        </action>
    </referenceBlock>
    <move element="breadcrumbs" destination="page.top" after="-"/>
</page>
