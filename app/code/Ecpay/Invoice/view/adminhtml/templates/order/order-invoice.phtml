            "encryptData": <?php echo $block->getEncryptData(); ?>,
            "invoiceData": <?php echo $block->getInvoiceData(); ?>,
            "invoiceModuleEnable": <?php echo $block->getIvoiceModuleEnable(); ?>
        }
    }
}
</script>

<script>
require([
    'jquery',
    'domReady!'
], function ($) {
    'use strict';


    // 發票方式選擇邏輯 - 使用事件委派
    $(document).on('change', '#manual_invoice_type', function() {
        var selectedValue = $(this).val();
        var companyFields = $('.company-fields');

        if (selectedValue === 'company') {
            companyFields.css('display', 'block').show();
        } else {
            companyFields.css('display', 'none').hide();
            // 清空公司相關欄位
            $('#manual_company_name, #manual_tax_id').val('');
        }
    });

    // 編輯按鈕功能
    $('#manual-edit-invoice-btn').on('click', function() {
        var formFields = $('#manual-invoice-form input, #manual-invoice-form select');
        var editBtn = $('#manual-edit-invoice-btn');
        var saveBtn = $('#manual-save-invoice-btn');
        var invoiceTypeSelect = $('#manual_invoice_type');

        // 啟用所有欄位
        formFields.prop('disabled', false);

        // 切換按鈕顯示
        editBtn.hide();
        saveBtn.show();

        // 隱藏錯誤消息
        $('.admin__field').removeClass('_error');

        // 清空訊息容器
        $('#manual-invoice-message-container').empty().show();
    });

    // 確定按鈕功能
    $('#manual-save-invoice-btn').on('click', function() {
        var isValid = validateManualForm();

        if (isValid) {
            // 收集表單資料
            var formData = {
                'invoice': {
                    'invoice_number': $('#manual_invoice_number').val(),
                    'invoice_date': $('#manual_invoice_date').val(),
                    'random_number': $('#manual_random_number').val(),
                    'invoice_type': $('#manual_invoice_type').val(),
                    'invoice_info_type': $('#manual_invoice_info_type').val(),
                    'transaction_number': $('#manual_transaction_number').val(),
                    'company_name': $('#manual_company_name').val(),
                    'tax_id': $('#manual_tax_id').val()
                }
            };

            // 取得訂單 ID
            var orderId = getOrderIdFromUrl();

            // AJAX 提交
            $.ajax({
                url: '<?= $block->getUrl('manual_invoice/order/saveInvoice') ?>',
                type: 'POST',
                data: {
                    'order_id': orderId,
                    'invoice': formData.invoice
                },
                showLoader: true,
                success: function(response) {
                    if (response.success) {
                        // 成功時禁用所有欄位
                        var formFields = $('#manual-invoice-form input, #manual-invoice-form select');
                        formFields.prop('disabled', true);

                        // 切換按鈕顯示
                        $('#manual-save-invoice-btn').hide();
                        $('#manual-edit-invoice-btn').show();

                        // 隱藏錯誤狀態
                        $('.admin__field').removeClass('_error');

                        // 顯示成功訊息
                        $('#manual-invoice-message-container').html('<div class="message message-success">' + response.message + '</div>');
                        setTimeout(function() {
                            $('#manual-invoice-message-container').fadeOut();
                        }, 3000);
                    } else {
                        $('#manual-invoice-message-container').html('<div class="message message-error">' + (response.message || 'Save failed') + '</div>');
                    }
                },
                error: function() {
                    $('#manual-invoice-message-container').html('<div class="message message-error">Network error, please try again later</div>');
                }
            });
        }
    });

    // 手動發票表單驗證函數
    function validateManualForm() {
        var isValid = true;
        var requiredFields = [
            '#manual_invoice_number',
            '#manual_invoice_date',
            '#manual_random_number',
            '#manual_invoice_type',
            '#manual_invoice_info_type',
            '#manual_transaction_number'
        ];

        // 如果選擇了統編，則公司欄位也是必填
        if ($('#manual_invoice_type').val() === 'company') {
            requiredFields.push('#manual_company_name', '#manual_tax_id');
        }

        // 清除之前的錯誤狀態
        $('.admin__field').removeClass('_error');

        // 檢查每個必填欄位 (只在欄位啟用時檢查)
        requiredFields.forEach(function(fieldId) {
            var field = $(fieldId);
            var fieldContainer = field.closest('.admin__field');

            // 只檢查啟用的欄位
            if (!field.prop('disabled') && (!field.val() || field.val().trim() === '')) {
                fieldContainer.addClass('_error');
                isValid = false;
            }
        });

        // 顯示或隱藏錯誤消息
        if (!isValid) {
            $('#manual-invoice-message-container').html('<div class="message message-error"><?= __('Please fill in the correct information');?></div>');
        } else {
            $('#manual-invoice-message-container').empty();
        }

        return isValid;
    }

    // 從 URL 取得訂單 ID 的函數
    function getOrderIdFromUrl() {
        var url = window.location.href;
        var matches = url.match(/\/order_id\/(\d+)/);
        return matches ? matches[1] : null;
    }

    // 頁面載入時檢查並顯示公司欄位
    $(document).ready(function() {
        var invoiceTypeSelect = $('#manual_invoice_type');
        var currentInvoiceType = invoiceTypeSelect.val();

        if (currentInvoiceType === 'company') {
            $('.company-fields').css('display', 'block').show();
        }
    });
});
</script>
