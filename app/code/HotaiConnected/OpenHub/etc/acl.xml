<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="HotaiConnected_OpenHub::config" title="OpenHub API Configuration" />
                        </resource>
                    </resource>
                </resource>
                <resource id="HotaiConnected_OpenHub::openhub" title="OpenHub API Management">
                    <resource id="HotaiConnected_OpenHub::management" title="Configuration Management" />
                    <resource id="HotaiConnected_OpenHub::retry_queue" title="Retry Queue Management" />
                    <resource id="HotaiConnected_OpenHub::tickets" title="Ticket Management" />
                </resource>
            </resource>
        </resources>
    </acl>
</config>