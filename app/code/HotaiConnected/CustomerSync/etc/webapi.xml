<?xml version="1.0" ?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <route url="/V1/hotaiconnected-customersync" method="POST">
        <service class="HotaiConnected\CustomerSync\Api\CustomerSyncManagementInterface" method="deleteCustomerSync"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
    <route url="/V1/hotaiconnected-customersync-status" method="POST">
        <service class="HotaiConnected\CustomerSync\Api\CustomerSyncManagementInterface" method="getCustomerSync"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
</routes>
