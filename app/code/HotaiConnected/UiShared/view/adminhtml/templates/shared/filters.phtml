    <!-- 篩選器內容（使用正確的結構） -->
    <form class="admin__data-grid-filters-wrap" id="filters-form" data-part="filter-form">

        <fieldset class="admin__fieldset admin__data-grid-filters">
            <legend class="admin__filters-legend">
                <span><?= __('Advanced filter') ?></span>
            </legend>

            <?php foreach ($filtersData as $data) : ?>

                <!-- <?= $data['note'] ?> -->
                <fieldset class="admin__form-field">
                    
                    <div class="admin__form-field-label">
                        <span><?= __($data['label']) ?></span>
                    </div>
                    <div class="admin__form-field-control" data-type="<?= $data['type'] ?>">
                        
                        <?php if ($data['type'] === 'text') : ?>
                            <input 
                                type="text"
                                name="<?= $data['name'] ?>"
                                class="admin__control-text"
                                placeholder="<?= __($data['placeholder']) ?>" 
                                <?php if (isset($data['maxlength']) && (int)$data['maxlength'] > 0) : ?>
                                    maxlength="<?= $data['maxlength'] ?>"
                                <?php endif; ?>
                            />
                        <?php endif; ?>

                        <?php if ($data['type'] === 'date-range') : ?>
                            <div>
                                <label for="<?= $data['date_from']['name'] ?>" class="date-label">
                                    <span><?= __('From:') ?></span>
                                </label>
                                <input type="text" 
                                    id="<?= $data['date_from']['name'] ?>" 
                                    name="<?= $data['date_from']['name'] ?>" 
                                    class="admin__control-text" 
                                    readonly
                                    <?php if ($data['date_from']['required']) : ?>
                                        required
                                    <?php endif; ?>
                                    <?php if ($data['date_from']['validate']) : ?>
                                        data-validate="{required: true}"

                                        <?php if ($data['date_from']['msg_required']) : ?>
                                        data-msg-required="<?= __($data['date_from']['msg_required']) ?>"
                                        <?php endif; ?>

                                    <?php endif; ?>
                                >
                            </div>
                            <div>
                                <label for="<?= $data['date_to']['name'] ?>" class="date-label">
                                    <span><?= __('To:') ?></span>
                                </label>
                                <input type="text" 
                                    id="<?= $data['date_to']['name'] ?>" 
                                    name="<?= $data['date_to']['name'] ?>" 
                                    class="admin__control-text" 
                                    readonly
                                    <?php if ($data['date_to']['required']) : ?>
                                        required
                                    <?php endif; ?>
                                    <?php if ($data['date_to']['validate']) : ?>
                                        data-validate="{required: true}"

                                        <?php if ($data['date_to']['msg_required']) : ?>
                                        data-msg-required="<?= __($data['date_to']['msg_required']) ?>"
                                        <?php endif; ?>

                                    <?php endif; ?>
                                >
                            </div>
                        <?php endif; ?>

                        <?php if ($data['type'] === 'multiselect') : ?>
                            <select id="<?= $data['name'] ?>" 
                                    name="<?= $data['name'] ?>" 
                                    multiple 
                                    class="admin__control-select"
                                    data-placeholder="<?= $data['placeholder'] ?>"
                                >
                                <!-- 選項由 JavaScript 動態建立 -->
                                
                                <?php if (!empty($data['options'])) : ?>
                                    <?php foreach ($data['options'] as $option) : ?>
                                        <option value="<?= $option['value'] ?>"><?= $option['label'] ?></option>
                                    <?php endforeach; ?>
                                <?php endif; ?>
                            </select>
                        <?php endif; ?>

                        <?php if ($data['type'] === 'select') : ?>
                            <select id="<?= $data['name'] ?>" 
                                name="<?= $data['name'] ?>" 
                                class="admin__control-select" 
                                data-placeholder="<?= $data['placeholder'] ?>"
                                <?php if (isset($data['required']) && $data['required']) : ?>
                                    required
                                <?php endif; ?>
                                <?php if (isset($data['validate']) && $data['validate']) : ?>
                                    data-validate="{required: true}"
                                    <?php if (isset($data['msg_required'])) : ?>
                                    data-msg-required="<?= __($data['msg_required']) ?>"
                                    <?php endif; ?>
                                <?php endif; ?>
                            >
                                <option value=""><?= __($data['placeholder']) ?></option>
                                <?php if (!empty($data['options'])) : ?>
                                    <?php foreach ($data['options'] as $option) : ?>
                                    <option value="<?= $option['value'] ?>"><?= $option['label'] ?></option>
                                    <?php endforeach; ?>
                                <?php endif; ?>
                            </select>
                        <?php endif; ?>

                    </div>
                </fieldset>
            <?php endforeach; ?>

        </fieldset>

        <div class="admin__data-grid-filters-footer">
            <div class="admin__footer-main-actions">
                <button class="action-tertiary" type="button" data-action="grid-filter-clear" id="clear-filters">
                    <span><?= __('Clear') ?></span>
                </button>
                <button class="action-secondary" type="button" data-action="grid-filter-apply" id="apply-filters">
                    <span><?= __('Search') ?></span>
                </button>
            </div>
        </div>
    </form>
</div>