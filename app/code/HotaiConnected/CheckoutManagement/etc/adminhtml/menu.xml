<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Backend:etc/menu.xsd">
    <menu>
        <!-- 主選單設定 -->
        <add id="HotaiConnected_CheckoutManagement::menu" sortOrder="10" title="Financial Reconciliation" module="HotaiConnected_CheckoutManagement"
             resource="HotaiConnected_FinancialReconciliation::finance_automation"/>

        <!-- Checkout Area / 結帳專區 -->
        <add id="HotaiConnected_CheckoutManagement::checkout_area" title="Checkout Area" module="HotaiConnected_CheckoutManagement" sortOrder="10"
             parent="HotaiConnected_CheckoutManagement::menu" action="checkout_management/checkoutarea"
             resource="HotaiConnected_FinancialReconciliation::checkout_area"/>
        
        <!-- Export Order Checkout Data / 訂單結帳匯出 -->
        <add id="HotaiConnected_CheckoutManagement::export_order_checkout_data" title="Export Order Checkout Data" module="HotaiConnected_CheckoutManagement" sortOrder="20"
             parent="HotaiConnected_CheckoutManagement::menu" action="checkout_management/exportordercheckoutdata"
