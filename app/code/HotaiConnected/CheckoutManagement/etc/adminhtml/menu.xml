        <!-- Approval Functionality / 審核功能 -->
        <add id="HotaiConnected_CheckoutManagement::approval_functionality" title="Approval Functionality" module="HotaiConnected_CheckoutManagement" sortOrder="30"
             parent="HotaiConnected_CheckoutManagement::menu" action="checkout_management/approvalfunctionality"
             resource="HotaiConnected_FinancialReconciliation::review_function"/>
        
        <!-- Voucher Reconciliation Area / 票券對帳專區 -->
        <add id="HotaiConnected_CheckoutManagement::voucher_reconciliation_area" title="Voucher Reconciliation Area" module="HotaiConnected_CheckoutManagement" sortOrder="40"
             parent="HotaiConnected_CheckoutManagement::menu" action="checkout_management/voucherreconciliationarea"
             resource="HotaiConnected_FinancialReconciliation::ticket_reconciliation"/>
    </menu>
</config>

