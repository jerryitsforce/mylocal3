<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="seller-2columns-left" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="marketplace_styles"/>
    <head>
        <css src="HotaiConnected_UiShared::css/vendor/tabulator/tabulator.min.css"/>
        <css src="HotaiConnected_UiShared::css/vendor/sumoselect/sumoselect.min.css"/>
        <css src="HotaiConnected_CheckoutManagement::css/checkoutarea/index.css"/>
    </head>
    <body>
        <referenceContainer name="seller.content">
            <!-- 共用資料區塊（透過 js-config 注入，集中管理 token / key / header 等） -->
            <block class="HotaiConnected\UiShared\Block\Frontend\Common\JSConfig" name="shared.jsconfig" template="HotaiConnected_UiShared::shared/js-config.phtml" before="hotai_connected_checkout_management_checkoutarea_content"/>
            <!-- 對帳管理主內容 Block：包含列表與篩選區塊 -->
            <block name="hotai_connected_checkout_management_checkoutarea_content" template="HotaiConnected_CheckoutManagement::checkoutarea/index.phtml">
                <block class="Magento\Framework\View\Element\Template" name="shared.filters" template="HotaiConnected_UiShared::shared/filters.phtml"/>
            </block>
        </referenceContainer>
    </body>
</page>

