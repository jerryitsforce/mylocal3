<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="HotaiConnected_UiShared::css/vendor/tabulator/tabulator.min.css"/>
        <css src="HotaiConnected_UiShared::css/vendor/sumoselect/sumoselect.min.css"/>
        <css src="HotaiConnected_CheckoutManagement::css/exportordercheckoutdata/index.css"/>
    </head>
    <body>
        <referenceContainer name="content">
            <!-- 共用資料區塊（透過 js-config 注入，集中管理 token / key / header 等） -->
            <block class="HotaiConnected\UiShared\Block\Adminhtml\Common\JSConfig" name="shared.jsconfig" template="HotaiConnected_UiShared::shared/js-config.phtml" before="export_order_checkout_data_content"/>
            
            <!-- 訂單結帳資料匯出主內容 Block：包含共用篩選器 -->
            <block class="Magento\Backend\Block\Template" name="export_order_checkout_data_content" template="HotaiConnected_CheckoutManagement::exportordercheckoutdata/index.phtml">
                <block class="Magento\Backend\Block\Template" name="shared.filters" template="HotaiConnected_UiShared::shared/filters.phtml"/>
            </block>
        </referenceContainer>
    </body>
</page>
