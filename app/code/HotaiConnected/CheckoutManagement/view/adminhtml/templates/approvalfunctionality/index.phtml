    <!-- Magento 標準篩選器區塊（共用模板） -->
    <?php
    // 將 filtersData 傳遞給子 block
    $sharedFiltersBlock = $block->getChildBlock('shared.filters');
    if ($sharedFiltersBlock) {
        $sharedFiltersBlock->setData('filters_data', $filtersData);
    }
    echo $block->getChildHtml('shared.filters');
    ?>

    <div class="approval-functionality__table">
        <!-- 批量操作選擇器 -->
        <div class="approval-functionality__table__actions">
            <?php if(is_array($batchActions) && count($batchActions) > 0): ?>
            <select id="batch-action-select" name="batch_action" class="admin__control-select">
                <option value=""><?= __('Select Options') ?></option>
                <?php foreach ($batchActions as $action): ?>
                    <option value="<?= $block->escapeHtmlAttr($action['value']) ?>">
                        <?= $block->escapeHtml($action['label']) ?>
                    </option>
                <?php endforeach; ?>
            </select>
            <?php endif; ?>
        </div>
        
        <!-- Tabulator 表格容器（遠端分頁模式）-->
        <div id="tabulator-grid"></div>
    </div>
</div>
