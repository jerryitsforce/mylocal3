// 從 Block 取得 filtersData 和 batchActions（由 Controller 設定）
$filtersData = $block->getData('filters_data') ?: [];
$batchActions = $block->getData('batch_actions') ?: [];
?>
<div class="approval-functionality fade-up-initial">
    <!-- 空白頁面內容將在此處添加 -->

