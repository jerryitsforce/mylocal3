<?xml version="1.0"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <route url="/V1/ticketApi/family-notify" method="POST">
        <service class="HotaiConnected\TicketApi\Api\FamilyNotifyInterface" method="handle"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
    <route url="/V1/qware-ticket" method="POST">
        <service class="HotaiConnected\TicketApi\Api\QwareNotifyInterface" method="handle"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
</routes>
