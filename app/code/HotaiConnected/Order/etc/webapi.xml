<?xml version="1.0" ?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
	<route url="/V1/hotaiconnected-order/order" method="POST">
		<service class="HotaiConnected\Order\Api\OrderManagementInterface" method="postOrder"/>
		<resources>
			<resource ref="self"/>
		</resources>
	</route>
	<route url="/V1/hotaiconnected-order/order/:orderNo" method="PUT">
		<service class="HotaiConnected\Order\Api\OrderManagementInterface" method="updateOrder"/>
		<resources>
			<resource ref="self"/>
		</resources>
	</route>
	<route url="/V1/hotaiconnected-order/order/:orderNo" method="GET">
		<service class="HotaiConnected\Order\Api\OrderManagementInterface" method="getOrder"/>
		<resources>
			<resource ref="self"/>
		</resources>
	</route>
	<route url="/V1/hotaiconnected-order/order/:orderNo" method="DELETE">
		<service class="HotaiConnected\Order\Api\OrderManagementInterface" method="deleteOrder"/>
		<resources>
			<resource ref="self"/>
		</resources>
	</route>
	<route url="/V1/hotaiconnected-order/order-existence" method="POST">
		<service class="HotaiConnected\Order\Api\OrderExistenceManagementInterface" method="postOrderExistence"/>
		<resources>
			<resource ref="self"/>
		</resources>
	</route>
</routes>
