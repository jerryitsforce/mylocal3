<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="raw_product_view_log" resource="default" engine="innodb" comment="Raw Product View Log from BigQuery">
        <column xsi:type="bigint" name="event_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="varchar" name="uid" length="255" nullable="true" comment="User ID / One ID"/>
        <column xsi:type="varchar" name="product_id" length="255" nullable="true" comment="Product Item ID"/>
        <column xsi:type="varchar" name="device_category" length="50" nullable="true" comment="Device Category"/>
        <column xsi:type="varchar" name="platform" length="50" nullable="true" comment="Platform"/>
        <column xsi:type="datetime" name="event_timestamp" nullable="false" comment="BigQuery Event Created At (UTC+8)"/>
        <column xsi:type="datetime" name="created_at" nullable="false" comment="Created At (UTC+8)"/>
        
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="event_id"/>
        </constraint>
        
        <index referenceId="RAW_PRODUCT_VIEW_LOG_UID" indexType="btree">
            <column name="uid"/>
        </index>
        <index referenceId="RAW_PRODUCT_VIEW_LOG_PRODUCT_ID" indexType="btree">
            <column name="product_id"/>
        </index>
    </table>
    <table name="static_keyword_list" resource="default" engine="innodb" comment="Static Keyword List">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="varchar" name="keyword" length="255" nullable="false" comment="Keyword"/>
        <column xsi:type="varchar" name="version" length="50" nullable="false" comment="Version Tag (e.g. 2024Q1)"/>
        <column xsi:type="boolean" name="is_active" nullable="false" default="0" comment="Is this version active?"/>
        <column xsi:type="datetime" name="created_at" nullable="false" comment="Created At"/>

        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>

        <index referenceId="STATIC_KEYWORD_LIST_KEYWORD" indexType="btree">
            <column name="keyword"/>
        </index>
        <index referenceId="STATIC_KEYWORD_LIST_VERSION" indexType="btree">
            <column name="version"/>
        </index>
    </table>
</schema>
