<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <job name="hotai_bigquery_sync_events" instance="HotaiConnected\BigQuery\Cron\SyncEvents" method="execute">
            <schedule>0 11 * * *</schedule>
        </job>
        <job name="hotai_bigquery_update_keyword_aggregation" instance="HotaiConnected\BigQuery\Cron\UpdateKeywordAggregation" method="execute">
            <schedule>0 5 * * *</schedule>
        </job>
    </group>
</config>
