<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    
    <!-- Repository interface preferences -->
    <preference for="HotaiConnected\Qware\Api\QwareTicketRecordRepositoryInterface" 
                type="HotaiConnected\Qware\Model\QwareTicketRecordRepository"/>
    
    <!-- Gallery CopyHandler Plugin to fix null return value issue -->
    <type name="Magento\Catalog\Model\Product\Gallery\CopyHandler">
        <plugin name="qware_copy_handler_fix" 
                type="HotaiConnected\Qware\Plugin\CopyHandlerPlugin" 
                sortOrder="10" 
                disabled="false"/>
    </type>
    
</config>