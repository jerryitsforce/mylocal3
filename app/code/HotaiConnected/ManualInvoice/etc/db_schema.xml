<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <!-- Manual Invoice Table -->
    <table name="manual_invoice" resource="default" engine="innodb" comment="Manual Invoice Table">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="order_id" unsigned="true" nullable="false" comment="Order ID"/>
        <column xsi:type="varchar" name="invoice_number" length="10" nullable="true" comment="手開發票號碼"/>
        <column xsi:type="datetime" name="invoice_created_at" nullable="true" comment="發票開立時間 (+8)"/>
        <column xsi:type="int" name="random_code" unsigned="true" nullable="true" comment="隨機碼"/>
        <column xsi:type="varchar" name="invoice_type" length="5" nullable="false" default="p" comment="發票類型 (p:個人發票, c:統編發票)"/>
        <column xsi:type="int" name="invoice_status" unsigned="true" nullable="false" default="1" comment="發票資訊類型 (1:開立, 2:作廢, 3:折讓)"/>
        <column xsi:type="varchar" name="trans_no" length="255" nullable="true" comment="交易編號"/>
        <column xsi:type="varchar" name="company_name" length="255" nullable="true" comment="公司行號 (統編才會出現)"/>
        <column xsi:type="varchar" name="invoice_customer_identifier" length="10" nullable="true" comment="統一編號 (統編才會出現)"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At (+8)"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated At (+8)"/>
        <column xsi:type="int" name="updated_by" unsigned="true" nullable="false" comment="後台使用者ID"/>
        
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        
        <constraint xsi:type="foreign" referenceId="MANUAL_INVOICE_ORDER_ID_SALES_ORDER_ENTITY_ID" 
                   table="manual_invoice" column="order_id" 
                   referenceTable="sales_order" referenceColumn="entity_id" 
                   onDelete="CASCADE"/>
        
        <constraint xsi:type="foreign" referenceId="MANUAL_INVOICE_UPDATED_BY_ADMIN_USER_USER_ID" 
                   table="manual_invoice" column="updated_by" 
                   referenceTable="admin_user" referenceColumn="user_id" 
                   onDelete="CASCADE"/>
        
        <index referenceId="MANUAL_INVOICE_ORDER_ID" indexType="btree">
            <column name="order_id"/>
        </index>
        
        <index referenceId="MANUAL_INVOICE_UPDATED_BY" indexType="btree">
            <column name="updated_by"/>
        </index>
    </table>
    
    <!-- Add column to sales_order table -->
    <table name="sales_order" resource="default">
        <column xsi:type="tinyint" name="is_manual_invoice" unsigned="true" nullable="false" default="0" comment="是否手開發票 (若manual_invoice有對應發票則為1)"/>
        
        <index referenceId="SALES_ORDER_IS_MANUAL_INVOICE" indexType="btree">
            <column name="is_manual_invoice"/>
        </index>
    </table>
</schema>