<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="hotaiconnected_hotaipoint" translate="label" sortOrder="135" showInDefault="1" showInWebsite="1" showInStore="1">
            <class>separator-top</class>
            <label>Hotai Point Notification</label>
            <tab>hotaiconnected</tab>
            <resource>HotaiConnected_HotaiPoint::config</resource>
            <group id="ftp_download" showInDefault="1" showInStore="1" showInWebsite="1" sortOrder="10" translate="label">
                <label>FTP Download</label>
                <field id="enable" translate="label" type="select" sortOrder="1" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Enable FTP download for daily point file.</comment>
                </field>
                <field id="host" translate="label" type="text" sortOrder="2" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Host</label>
                </field>
                <field id="port" translate="label" type="text" sortOrder="3" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Port</label>
                    <validate>validate-digits</validate>
                </field>
                <field id="username" translate="label" type="text" sortOrder="4" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Username</label>
                </field>
                <field id="password" translate="label" type="text" sortOrder="5" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Password</label>
                </field>
                <field id="remote_path" translate="label" type="text" sortOrder="6" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Remote Path</label>
                    <comment>Default: /Export</comment>
                </field>
            </group>
            <group id="point_notification" showInDefault="1" showInStore="1" showInWebsite="1" sortOrder="20" translate="label">
                <label>Notification API</label>
                <field id="enable" translate="label" type="select" sortOrder="1" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Enable sending push notification after FTP download.</comment>
                </field>
                <field id="api_url" translate="label" type="text" sortOrder="2" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>API URL</label>
                </field>
                <field id="min_points" translate="label" type="text" sortOrder="3" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Minimum Points Threshold</label>
                    <validate>validate-digits validate-greater-than-zero</validate>
                    <comment>Only notify when TotalPoints exceeds this value. Default: 100</comment>
                </field>
            </group>
        </section>
    </system>
</config>
