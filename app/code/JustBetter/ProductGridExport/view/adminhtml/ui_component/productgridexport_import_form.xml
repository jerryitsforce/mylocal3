<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">productgridexport_import_form.productgridexport_import_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Import Inventory</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="save">
                <class>primary</class>
                <label translate="true">Upload and Import</label>
            </button>
        </buttons>
        <namespace>productgridexport_import_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>productgridexport_import_form.productgridexport_import_form_data_source</dep>
        </deps>
    </settings>
    <dataSource name="productgridexport_import_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="productgridexport/import/upload"/>
        </settings>
        <aclResource>JustBetter_ProductGridExport::import</aclResource>
        <dataProvider class="JustBetter\ProductGridExport\Model\DataProvider" name="productgridexport_import_form_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="general">
        <settings>
            <label translate="true">File to Import</label>
        </settings>
        <file name="import_file">
            <settings>
                <label translate="true">Select File to Import</label>
                <dataScope>import_file</dataScope>
                <required>true</required>
            </settings>
        </file>
    </fieldset>
</form>