<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="sales_parent_order_detail" resource="default" engine="innodb"
           comment="Marketplace Parent Order Detail Table">
        <column xsi:type="varchar" name="ecpay_payment_merchant_trade_no" nullable="true" length="255"/>
        <column xsi:type="varchar" name="ecpay_logistic_cvs_store_id" nullable="true" length="10"/>
        <column xsi:type="varchar" name="ecpay_logistic_cvs_store_name" nullable="true" length="10"/>
        <column xsi:type="varchar" name="ecpay_logistic_cvs_store_address" nullable="true" length="60"/>
        <column xsi:type="varchar" name="ecpay_logistic_cvs_store_telephone" nullable="true" length="20"/>
        <column xsi:type="varchar" name="ecpay_invoice_carruer_type" nullable="true" length="50"/>
        <column xsi:type="varchar" name="ecpay_invoice_customer_identifier" nullable="true" length="50"/>
        <column xsi:type="varchar" name="ecpay_invoice_customer_company" nullable="true" length="50"/>
        <column xsi:type="varchar" name="ecpay_invoice_love_code" nullable="true" length="50"/>
        <column xsi:type="varchar" name="ecpay_invoice_carruer_num" nullable="true" length="50"/>
    </table>
</schema>
