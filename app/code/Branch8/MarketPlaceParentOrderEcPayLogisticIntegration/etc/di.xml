<?xml version="1.0"?>

<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!--Payment Debug Config-->
    <virtualType name="ecPayPaymentWithParentOrderDebugRequest"
                 type="Magento\Framework\Logger\Handler\Base">
        <arguments>
            <argument name="fileName" xsi:type="string">/var/log/ecpay_parentorder/payment_request.log</argument>
        </arguments>
    </virtualType>
    <virtualType name="ecPayPaymentWithParentRequestOrderDebugLogger" type="Magento\Framework\Logger\Monolog">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="debug" xsi:type="object">ecPayPaymentWithParentOrderDebugRequest</item>
            </argument>
        </arguments>
    </virtualType>

    <virtualType name="ecPayPaymentWithParentResponseOrderDebugResponse"
                 type="Magento\Framework\Logger\Handler\Base">
        <arguments>
            <argument name="fileName" xsi:type="string">/var/log/ecpay_parentorder/payment_response.log</argument>
        </arguments>
    </virtualType>
    <virtualType name="ecPayPaymentWithParentResponseOrderDebugResponseLogger" type="Magento\Framework\Logger\Monolog">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="debug" xsi:type="object">ecPayPaymentWithParentResponseOrderDebugResponse</item>
            </argument>
        </arguments>
    </virtualType>


    <!--Logistic Debug config-->
    <virtualType name="ecPayLogisticWithParentOrderDebugRequest"
                 type="Magento\Framework\Logger\Handler\Base">
        <arguments>
            <argument name="fileName" xsi:type="string">/var/log/ecpay_parentorder/logistic_request.log</argument>
        </arguments>
    </virtualType>
    <virtualType name="ecPayLogisticWithParentOrderDebugRequestLogger" type="Magento\Framework\Logger\Monolog">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="debug" xsi:type="object">ecPayLogisticWithParentOrderDebugRequest</item>
            </argument>
        </arguments>
    </virtualType>


    <virtualType name="ecPayLogisticWithParentOrderDebugResponse"
                 type="Magento\Framework\Logger\Handler\Base">
        <arguments>
            <argument name="fileName" xsi:type="string">/var/log/ecpay_parentorder/logistic_response.log</argument>
        </arguments>
    </virtualType>
    <virtualType name="ecPayLogisticWithParentOrderDebugResponseLogger" type="Magento\Framework\Logger\Monolog">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="debug" xsi:type="object">ecPayLogisticWithParentOrderDebugResponse</item>
            </argument>
        </arguments>
    </virtualType>
</config>
