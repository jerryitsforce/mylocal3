<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="checkout_submit_all_after">
        <observer name="save_rule_name" instance="Branch8\Sales\Observer\SaveRuleName" />
    </event>
    <event name="branch8_set_order_status">
        <observer name="branch8_sales_AutoChangeOrderStatusForNewOrder_observer"
                  instance="Branch8\Sales\Observer\AutoChangeOrderStatusForNewOrderObserver"/>
    </event>
    <event name="update_order_item_status_after_save_comment">
        <observer name="update_order_item_status_after_save_comment" instance="Branch8\Sales\Observer\UpdateOrderItemStatusAfterSaveComment" />
    </event>
    <event name="branch8_split_order_item_success">
        <observer name="b8_save_commission_percent" instance="Branch8\Sales\Observer\CommissionPercent" />
        <observer name="update_order_item_status" instance="Branch8\Sales\Observer\UpdateOrderItemStatus" />
        <observer name="set_order_itme_product_options" instance="Branch8\Sales\Observer\SetOrderItemProductOptions" />
        <observer name="Branch8_Sales::order_item_rule_applier" instance="Branch8\Sales\Observer\OrderItemRuleApplier"/>
    </event>
    <event name="email_shipment_set_template_vars_before">
        <observer name="branch_email_shipment_set_template_vars_before" instance="Branch8\Sales\Observer\ShipmentSender" />
    </event>
    <event name="sales_model_service_quote_submit_before">
        <observer name="b8_set_custom_data_to_order_for_report" instance="Branch8\Sales\Observer\SaveCustomFieldToOrder" />
    </event>

    <event name="sales_order_save_after">
        <observer name="update_status_parent_order"
                  instance="Branch8\Sales\Observer\UpdateStatusParentOrder" disabled="true"/>
    </event>
    <event name="update_is_paid_for_point_only_order">
        <observer name="update_is_paid_for_point_only_order_observer"
                  instance="Branch8\Sales\Observer\PointOnlyOrderIsPaid"/>
    </event>

    <!-- <event name="marketplace_mpsplitorder_save_commit_after">
         <observer name="auto_resolve_order_status"
                   instance="Branch8\MarketPlaceParentOrder\Observer\ParentOrderSaveCommitComeback" />
     </event>-->
    <!-- <event name="sales_order_invoice_save_after">
        <observer name="branch8_sales_not_allow_issue_when_order_pending_payment"
                  instance="Branch8\Sales\Observer\NotAllowIssueInvoiceWhenOrderPendingPayment"/>

    </event> -->
    <event name="sales_order_shipment_save_after">
		<observer name="branch8_sales_observer_sales_ordershipmentsaveafter_sales_order_shipment_save_after" instance="Branch8\Sales\Observer\Sales\OrderShipmentSaveAfter"/>
	</event>
    <event name="sales_order_status_history_save_before">
        <observer name="branch8_log_order_history_resource" instance="Branch8\Sales\Observer\LogOrderStatusChange" />
        <observer name="branch8_strip_tag_comment" instance="Branch8\Sales\Observer\OrderCommentStripTagBefore" />
    </event>
    <event name="cron_job_run">
        <observer name="branch8_log_register_flag" instance="Branch8\Sales\Observer\RegisterCronFlag" />
    </event>

    <event name="sales_order_shipment_save_before">
        <observer name="branch8_sales_duplicate_shipment_observer"
                  instance="Branch8\Sales\Observer\BlockDuplicateShipmentObserver" />
    </event>
    <event name="sales_order_creditmemo_save_before">
        <observer name="branch8_sales_duplicate_creditmemo_observer"
                  instance="Branch8\Sales\Observer\BlockDuplicateCreditmemoObserver" />
    </event>
    <event name="marketplace_mpsplitorder_submit_after">
        <observer name="branch8_fill_in_postcode_if_needed" instance="Branch8\Sales\Observer\FillInPostcodeIfNeeded" />
        <observer name="update_full_point_parent_order_status" instance="Branch8\Sales\Observer\UpdateFullPointOrderStatus" />
    </event>
    <event name="controller_action_predispatch_sales_order_index">
        <observer name="branch8_sales_log_order_index_access" instance="Branch8\Sales\Observer\LogOrderViewAccess" />
    </event>
    <event name="controller_action_predispatch_sales_order_view">
        <observer name="branch8_sales_log_order_view_access" instance="Branch8\Sales\Observer\LogOrderViewAccess" />
    </event>
    <event name="controller_action_predispatch_marketplace_order_view">
        <observer name="branch8_sales_log_marketplace_order_view_access" instance="Branch8\Sales\Observer\LogOrderViewAccess" />
    </event>
    <event name="controller_action_predispatch_sales_parent_order_index">
        <observer name="branch8_sales_log_parent_order_index_access" instance="Branch8\Sales\Observer\LogOrderViewAccess" />
    </event>
    <event name="controller_action_predispatch_sales_parent_order_view">
        <observer name="branch8_sales_log_parent_order_view_access" instance="Branch8\Sales\Observer\LogOrderViewAccess" />
    </event>
    <event name="controller_action_predispatch_marketplace_order_history">
        <observer name="branch8_sales_log_marketplace_order_history_access" instance="Branch8\Sales\Observer\LogOrderViewAccess" />
    </event>
</config>
