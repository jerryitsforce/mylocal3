<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="b8sales" translate="label" type="text" sortOrder="111" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Sales</label>
            <tab>branch8</tab>
            <resource>Branch8_Sales::config</resource>
            <group id="shipping" translate="label" type="text" sortOrder="100" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Shipping Settings</label>
                <field id="logistics_company" translate="label comment" type="text" sortOrder="100" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="0">
                    <label>Logistics Company</label>
                    <frontend_model>Branch8\Sales\Block\Adminhtml\Form\Field\LogisticsCompany</frontend_model>
                    <backend_model>Magento\Config\Model\Config\Backend\Serialized\ArraySerialized</backend_model>
                </field>
            </group>
            <group id="order_status" translate="label" type="text" sortOrder="100" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Order Status Settings</label>
                <field id="allow_specific" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="0">
                    <label>Order Statuses Applicable for Filtering</label>
                    <source_model>Branch8\Sales\Model\Config\Source\AllSpecificStatuses</source_model>
                </field>
                <field id="statuses_filter_apply" translate="label" type="multiselect" sortOrder="20" showInDefault="1" showInWebsite="0">
                    <label>Specific Order Statuses</label>
                    <source_model>Branch8\Sales\Model\Config\Source\OrderStatus</source_model>
                    <can_be_empty>1</can_be_empty>
                    <depends>
                        <field id="allow_specific">1</field>
                    </depends>
                </field>
            </group>
        </section>
        <section id="sales_email">
            <group id="general" type="text" sortOrder="0" showInDefault="1">
                <field id="subject_prefix" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Subject Prefix</label>
                    <comment>Prefix for the subject of all emails</comment>
                </field>
            </group>
        </section>
    </system>
</config>
