<script>
    require(
        [
            'jquery',
            'Magento_Ui/js/modal/modal'
        ],
        function(
            $,
            modal
        ) {
            var options = {
                title: $.mage.__('訂單篩選'),
                type: 'popup',
                responsive: true,
                innerScroll: true,
                buttons: [
                    {
                        text: $.mage.__('重新篩選'),
                        class: 're-filter',
                        click: function () {
                            this.closeModal();
                        }
                    },
                    {
                    text: $.mage.__('確定'),
                    class: 'confirm',
                    click: function () {
                        this.closeModal();
                    }
                }]
            };

            var popup = modal(options, $('#popup-order-filter'));
            $(".btn-filter").on('click',function(){
                $("#popup-order-filter").modal("openModal");
            });
        }
    );
</script>
