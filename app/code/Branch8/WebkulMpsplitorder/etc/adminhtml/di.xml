<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Webkul\Mpsplitorder\Model\AdminQuoteManagement"
                type="Branch8\WebkulMpsplitorder\Model\QuoteManagementPlugin"/>

    <preference for="Webkul\Mpsplitorder\Controller\Adminhtml\Order\Create\Save"
                type="Branch8\WebkulMpsplitorder\Controller\Adminhtml\Order\Create\Save" />

    <preference for="Webkul\Mpsplitorder\Model\AdminOrder\Create"
                type="Branch8\WebkulMpsplitorder\Model\AdminOrder\Create" />

    <type name="Branch8\WebkulMpsplitorder\Model\VerifyQuote\VerifyQuoteComposite">
        <arguments>
            <argument name="composite" xsi:type="array">
                <item name="edit_parent_order" xsi:type="object">Branch8\WebkulMpsplitorder\Model\ParentOrder\EditParentOrderVerify</item>
                <item name="reorder_parent_order" xsi:type="object">Branch8\WebkulMpsplitorder\Model\ParentOrder\ReorderParentOrderVerify</item>
            </argument>
        </arguments>
    </type>
    <type name="Magento\Quote\Model\ValidationRules\QuoteValidationComposite">
        <arguments>
            <argument name="validationRules" xsi:type="array">
                <item name="checkQuoteItemsBeforeSubmit" xsi:type="object">Branch8\WebkulMpsplitorder\Model\Quote\ValidationRules\ValidateQuoteItemsBeforeSubmit</item>
            </argument>
        </arguments>
    </type>
</config>
