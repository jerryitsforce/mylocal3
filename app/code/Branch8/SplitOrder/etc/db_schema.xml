<?xml version="1.0" ?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
	<table name="order_relation" resource="default" engine="innodb" comment="order_relation Table">
		<column xsi:type="int" name="order_relation_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Entity Id"/>
		<constraint xsi:type="primary" referenceId="PRIMARY">
			<column name="order_relation_id"/>
		</constraint>
		<column xsi:type="int" name="parent_order_id" unsigned="true" nullable="false" identity="false" default="0" padding="10" comment="Parent Order Id"/>
		<column xsi:type="int" name="child_order_id" unsigned="true" nullable="false" identity="false" default="0" padding="10" comment="Magento Order Id"/>
		
		<constraint xsi:type="foreign" referenceId="ORDER_RELATION_PARENT_ORDER_ID_SALES_ORDER_ENTITY_ID" table="order_relation" column="parent_order_id" referenceTable="marketplace_mpsplitorder" referenceColumn="index_id" onDelete="CASCADE"/>
		<constraint xsi:type="foreign" referenceId="ORDER_RELATION_CHILD_ORDER_ID_SALES_ORDER_ENTITY_ID" table="order_relation" column="child_order_id" referenceTable="sales_order" referenceColumn="entity_id" onDelete="CASCADE"/>
		<index referenceId="ORDER_RELATION_PARENT_ORDER_ID" indexType="btree">
			<column name="parent_order_id"/>
		</index>
        <index referenceId="ORDER_RELATION_CHILD_ORDER_ID_SALES_ORDER_ENTITY_ID" indexType="btree">
            <column name="child_order_id"/>
        </index>
	</table>
</schema>
