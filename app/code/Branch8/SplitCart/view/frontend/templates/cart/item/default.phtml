$shippingMethod = $shippingMethod === 'electronic' ? '' : $shippingMethod;
$shippingMethods = $shippingMethod? explode(',',$product->getData('shipping_method')) : [];

unset($shippingMethods['electronic']);

$shippingSize = sizeof($shippingMethods);

// $objectManager =  \Magento\Framework\App\ObjectManager::getInstance();
// $stockRegistry = $objectManager->get('\Magento\CatalogInventory\Model\StockRegistry');
$productId = $_item->getProduct()->getId(); // YOUR PRODUCT ID
// $productStock = $stockRegistry->getStockItem($productId);
// $isInStock = $productStock->getIsInStock();
// $isAvailable = $product->isSaleable() && $stockHelper->isItemProducInStock($_item);
// var_dump($isInStock, $product->isSaleable(), $stockHelper->isItemProducInStock($_item));
// $isOOS = !$isInStock || !$product->isSaleable() || !$stockHelper->isItemProducInStock($_item);
// $itemHasError = ($block->getItem()->getHasError() === true);
$availableToCheckout = (bool)$_item->getAvailableToCheckout();
$availableToCheckoutHtml = $_item->getAvailableToCheckout() ? "checked='checked'" : '';
$helperLabel = $this->helper(\Branch8\PromotionPage\Helper\Data::class);
$pointMoneyCollectHelper = $this->helper(\Branch8\PointMoneyCollect\Helper\Data::class);
$itemLimitPoint = $pointMoneyCollectHelper->getLimitByQuoteItem($_item);
$splitCartHelperData = $this->helper(Branch8\SplitCart\Helper\Data::class);
$quickCartItemViewModel = $block->getQuickCartItemViewModel() ? $block->getQuickCartViewModel() : Magento\Framework\App\ObjectManager::getInstance()->get(
    \Branch8\QuickEditCartItem\ViewModel\Cart::class
);
$shouldShowEditLink = $quickCartItemViewModel->shouldShowEditLink($_item);
$giftType = $_item->getProductType();
$isGift = $giftType === 'freeproduct_gift';
$giftClass = $isGift? 'gift' : '';
// $isDisabled = $itemHasError && !$isAvailable;
$productStatus = $product->getStatus();

$preorderHelper = $this->helper(\Webkul\MarketplacePreorder\Helper\Data::class);

$itemHasError = ($block->getItem()->getHasError() === true) && !$preorderHelper->isPreorder($productId);
$isLimitPurchasedError = false;
$maxAllowedQty = null;
$_messages = $block->getMessages();

$objectManager = \Magento\Framework\App\ObjectManager::getInstance();
$scopeConfig = $objectManager->get(\Magento\Framework\App\Config\ScopeConfigInterface::class);
$isLimitPurchasedEnabled = $scopeConfig->isSetFlag('limit_purchased/general/enabled', \Magento\Store\Model\ScopeInterface::SCOPE_STORE);

if ($isLimitPurchasedEnabled) {
    // 1. Check Error Code (most robust)
    $errorInfos = $_item->getErrorInfos();
    foreach ($errorInfos as $error) {
        if (isset($error['code']) && in_array($error['code'], ['limit-purchased', 'is_correct_qty-limit_purchased'])) {
            $isLimitPurchasedError = true;
            break;
        }
    }

    // 2. Check persistent flag from DB
    $ad = (string)$_item->getAdditionalData();
    if (strpos($ad, 'limit_error') !== false) {
        $isLimitPurchasedError = true;
        if (!$maxAllowedQty && preg_match('/limit_error\|qty:(\d+)/', $ad, $matches)) {
            $maxAllowedQty = (int)$matches[1];
        }
    }

    // 3. Parse messages for textual matches and extract max qty
    if (is_array($_messages)) {
        foreach ($_messages as $_msg) {
            $text = $_msg['text'];
            $isMatch = strpos($text, 'LIMIT_PURCHASE_ERROR|') !== false
                || strpos($text, "\xE2\x80\x8B\xE2\x80\x8B\xE2\x80\x8B") !== false
                || strpos($text, '最多只能購買') !== false
                || strpos($text, 'purchase up to') !== false
                || strpos($text, '商品數量超出') !== false
                || strpos($text, '商品超過購買數量') !== false;

            if ($isMatch) {
                $isLimitPurchasedError = true;
                if (!$maxAllowedQty && preg_match('/(\d+)/', $text, $matches)) {
                    $maxAllowedQty = (int)$matches[1];
                }
                if ($maxAllowedQty) break; 
            }
        }
    }

    // 4. Fallback: if we have the error but message was wiped by collectTotals, re-inject it
    if ($isLimitPurchasedError) {
        $itemHasError = true;

        // Try to fetch limit from ViewModel (Bulk query cached)
        if (!$maxAllowedQty) {
            $limitPurchasedViewModel = $objectManager->get(\Branch8\LimitPurchased\ViewModel\Cart\LimitPurchased::class);
            $limitData = $limitPurchasedViewModel->getItemLimits();
            $maxAllowedQty = $limitData['limits'][$_item->getId()] ?? null;
        }

        $hasTextMsg = false;
        foreach ($_messages as $m) {
            if (strpos($m['text'], '最多只能購買') !== false || strpos($m['text'], '商品數量超出') !== false || strpos($m['text'], '商品超過購買數量') !== false) {
                $hasTextMsg = true;
                break;
            }
        }
        if (!$hasTextMsg) {
            $fallbackMsg = ($maxAllowedQty) ? __("此商品最多只能購買%1個", $maxAllowedQty) : __("商品超過購買數量限制");
            $_messages[] = ['text' => $fallbackMsg, 'type' => 'error'];
        }
    }
}

// $itemHasError = $isOOS && !$preorderHelper->isPreorder($productId);
$isDisabled = $productStatus == \Magento\Catalog\Model\Product\Attribute\Source\Status::STATUS_DISABLED;

$checkIsTicketProduct = $this->helper(\Branch8\Checkout\Helper\Data::class);
$isTicketBatch = false;
$_options = $block->getOptionList();
$ticketOptionValue = '';
$requestQty = $block->getQty();
$checkOOSBatch = false;
$checkTicketAvailable = null;
$hasAvailableIssueWithTicketBatch = false;
$hasQtyIssueWithTicketBatch = false;
foreach($_options as $option){
  if($option['label'] === \Branch8\HotaiCore\Helper\VirtualProduct::TICKET_BATCH_SETTING_OPTION_TITLE){
    $isTicketBatch = true;
    $ticketOptionValue = html_entity_decode($option['value']);
    break;
  }
}
if($isTicketBatch) {
  $availableToBatchData = $checkIsTicketProduct->getTicketAvailableBatchData($productId);
  $checkTicketAvailable = $checkIsTicketProduct->checkIfQuantityEnoughByCustomOptionAndRequestQuantity($productId, $ticketOptionValue, $requestQty);
  if ($availableToBatchData === []) {
    $checkOOSBatch = true;
    $itemHasError = true;
  } else if (is_array($checkTicketAvailable) && isset($checkTicketAvailable['result']) && $checkTicketAvailable['result'] === false) {
    if($checkTicketAvailable['reason'] === \Branch8\HotaiCore\Model\Ticket\Reason::REASON_FOR_OOS_CHECK_PRODUCT_NOT_A_BATCH_IMPORT_TICKET ||
       $checkTicketAvailable['reason'] === \Branch8\HotaiCore\Model\Ticket\Reason::REASON_FOR_OOS_CHECK_BATCH_SETTING_NOT_FOUND ||
       $checkTicketAvailable['reason'] === \Branch8\HotaiCore\Model\Ticket\Reason::REASON_FOR_OOS_CHECK_OUT_OF_SALE_TIME_WINDOW ||
       $checkTicketAvailable['reason'] === \Branch8\HotaiCore\Model\Ticket\Reason::REASON_FOR_OOS_CHECK_QUANTITY_VIRTUAL_PRODUCT_TYPE_NOT_SUPPORTED ||
       $checkTicketAvailable['reason'] === \Branch8\HotaiCore\Model\Ticket\Reason::REASON_FOR_OOS_CHECK_BATCH_SETTING_EXIST_BUT_ZERO_QUANTITY_LEFT){
      $hasAvailableIssueWithTicketBatch = true;
    } elseif($checkTicketAvailable['reason'] === \Branch8\HotaiCore\Model\Ticket\Reason::REASON_FOR_OOS_CHECK_QUANTITY_NOT_ENOUGH){
      $hasQtyIssueWithTicketBatch = true;
    }
  }
}
