<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="before.body.end">
            <block class="Magento\Framework\View\Element\Template"
                   ifconfig="single_device_login/general/enable_and_use_socket"
                   name="single_login_detection" template="Branch8_SingleDeviceLogin::singlelogin.phtml" >
                <arguments>
                    <argument name="view_model" xsi:type="object">Branch8\SingleDeviceLogin\ViewModel\Config</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
