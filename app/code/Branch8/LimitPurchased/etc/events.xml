<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">

    <event name="catalog_product_load_after">
        <observer name="branch8_limitPurchased_default_multiselect" instance="Branch8\LimitPurchased\Observer\DefaultMultiselect"/>
    </event>

    <event name="sales_model_service_quote_submit_before">
        <observer name="branch8_limitPurchased_checkout_submit_before" instance="Branch8\LimitPurchased\Observer\CheckoutSubmitBefore" />
    </event>

    <event name="controller_action_predispatch_checkout_cart_index">
        <observer name="branch8_limitPurchased_check_cart_limit" instance="Branch8\LimitPurchased\Observer\CheckCartLimit" />
    </event>
    <event name="controller_action_predispatch_checkout_cart_updateitemqty">
        <observer name="branch8_limitPurchased_check_update_item_qty" instance="Branch8\LimitPurchased\Observer\CheckCartLimit" />
    </event>
    <event name="checkout_cart_update_items_after">
        <observer name="branch8_limitPurchased_check_cart_limit_update" instance="Branch8\LimitPurchased\Observer\CheckCartLimit" />
    </event>
    <event name="checkout_cart_product_add_after">
        <observer name="branch8_limitPurchased_check_cart_limit_add" instance="Branch8\LimitPurchased\Observer\CheckCartLimit" />
    </event>
    <event name="branch8_splitcart_update_post_after">
        <observer name="branch8_limitPurchased_check_splitcart_update_post" instance="Branch8\LimitPurchased\Observer\CheckCartLimit" />
    </event>
    <event name="controller_action_predispatch_checkout_index_index">
        <observer name="branch8_limitPurchased_check_checkout_limit" instance="Branch8\LimitPurchased\Observer\CheckCartLimit" />
    </event>

</config>