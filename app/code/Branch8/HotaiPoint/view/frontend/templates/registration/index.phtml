                    <input type="text"
                           maxlength="13"
                           minlength="13"
                           data-validate="{required:true, maxlength: 13, minlength: 13, 'validate-fullwidth-special': true}"
                           class="input-text required-entry"
                           title="<?= $block->escapeHtml(__("請輸入序號")); ?>"
                           name="serial-number"
                           id="serial-number"
                           value="<?= $block->escapeHtml($serialNumber) ?>"
                           placeholder="<?= $block->escapeHtml(__("請輸入序號")); ?>"
                           aria-required="true">
                </div>
            </div>
        </fieldset>

        <div class="hotai-point-additional-content">
            <?= /* @noEscape */ $block->getRegistrationStaticContent()?>
        </div>

        <div class="actions-toolbar">
            <div class="primary">
                <button class="action primary action-submit" id="registration-submit-btn" disabled>
                    <span><?php /* @escapeNotVerified */ echo __('確定') ?></span>
                </button>
            </div>
        </div>
    </form>
</div>
