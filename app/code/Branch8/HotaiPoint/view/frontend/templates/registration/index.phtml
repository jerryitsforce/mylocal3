$request = $block->getRequest();

// Get the serial parameter from the request
$serialNumber = $request->getParam('serial') ?? '';

?>
<div class="hotai-point-form-container  hotai-point-registration-container">
    <!-- <div class="hotai-point-qrcode">
        <div class="hotai-point-qrcode-img">
            <img src="<?= $block->getQRCodeUrl() ?>" alt="<?= __('QR Code') ?>">
        </div>
