    </event>
    <event name="hotai_point_api_success_return_point">
        <observer name="hotai_point_api_record_writer_observer" instance="Branch8\HotaiPoint\Observer\ApiRecordWriterObserver" />
    </event>
    <event name="hotai_point_api_success_add_point_non">
        <observer name="hotai_point_api_record_writer_observer" instance="Branch8\HotaiPoint\Observer\ApiRecordWriterObserver" />
    </event>
    <event name="hotai_point_api_success_commit">
        <observer name="hotai_point_api_record_writer_observer" instance="Branch8\HotaiPoint\Observer\ApiRecordWriterObserver" />
    </event>
</config>
