<layout xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/layout_generic.xsd">
    <container name="root" label="Root">
        <block class="Branch8\AdvancedPermissions\Block\Adminhtml\Role\Tab\Block" name="amrolepermissions.blocks.tab" >
            <block class="Branch8\AdvancedPermissions\Block\Adminhtml\Role\Tab\Block\Grid"
                name="amrolepermissions.allowed_blocks.grid" as="grid" />
        </block>
        <block class="Magento\Backend\Block\Widget\Grid\Serializer" name="amrolepermissions_grid_serializer">
            <arguments>
                <argument name="grid_block" xsi:type="string">amrolepermissions.allowed_blocks.grid</argument>
                <argument name="callback" xsi:type="string">getSelectedRuleBlocks</argument>
                <argument name="input_element_name" xsi:type="string">amrolepermissions[blocks]</argument>
                <argument name="reload_param_name" xsi:type="string">amrolepermissions_allowed_blocks</argument>
            </arguments>
        </block>
    </container>
</layout>
