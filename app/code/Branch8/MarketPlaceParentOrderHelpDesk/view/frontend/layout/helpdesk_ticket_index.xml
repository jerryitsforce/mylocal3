<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="2columns-left"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <title>客服表單</title>
        <!-- <css src="Branch8_HelpDesk::css/backend.css"/> -->
    </head>
    <update handle="customer_account"/>
    <body>
        <referenceContainer name="content">
            <block name="helpdesk.ticket.list"
                   class="Magento\Ui\Block\Wrapper"
                   template="Branch8_HelpDesk::ticket/list.phtml"
                   cacheable="false"
            >
                <arguments>
                    <argument name="uiComponent" xsi:type="string">customer_ticket_listing</argument>
                </arguments>
            </block>
            <block name="helpdesk.ticket.created.form"
                   class="Branch8\HelpDesk\Block\Ticket\Form"
                   template="Branch8_HelpDesk::ticket/form.phtml"
                   cacheable="false"
            >
                <arguments>
                    <argument name="jsLayout" xsi:type="array">
                        <item name="components" xsi:type="array">
                            <item name="ticketCreateForm" xsi:type="array">
                                <item name="component" xsi:type="string">Branch8_HelpDesk/js/view/new-ticket-form</item>
                                <item name="config" xsi:type="array">
                                    <item name="configurations" xsi:type="helper" helper="Branch8\HelpDesk\ViewModel\TicketFormConfig::getConfigurations"/>
                                </item>
                                <item name="children" xsi:type="array">
                                    <item name="messages" xsi:type="array">
                                        <item name="component" xsi:type="string">Magento_Ui/js/view/messages</item>
                                        <item name="displayArea" xsi:type="string">messages</item>
                                    </item>
                                    <item name="findYourOrder" xsi:type="array">
                                        <item name="component" xsi:type="string">Branch8_HelpDesk/js/view/find-your-order</item>
                                        <item name="displayArea" xsi:type="string">findYourOrder</item>
                                        <item name="config" xsi:type="array">
                                            <item name="configuration" xsi:type="helper" helper="Branch8\HelpDesk\ViewModel\TicketFormConfig::getFindYourOrderConfig"/>
                                        </item>
                                    </item>
                                    <item name="attachment" xsi:type="array">
                                        <item name="component" xsi:type="string">Branch8_HelpDesk/js/view/file-uploader</item>
                                        <item name="config" xsi:type="array">
                                            <item name="isMultipleFiles" xsi:type="boolean">true</item>
                                            <item name="template" xsi:type="string">ui/form/element/uploader/uploader</item>
                                            <item name="previewTmpl" xsi:type="string">Branch8_HelpDesk/form/element/attachment-preview</item>
                                            <item name="elementTmpl" xsi:type="string">ui/form/element/uploader/image</item>
                                            <item name="maxImageUploadCount" xsi:type="helper" helper="Branch8\HelpDesk\ViewModel\TicketData::getMaxImageUploadCount"/>
                                            <item name="uploaderConfig" xsi:type="helper" helper="Branch8\HelpDesk\ViewModel\TicketData::getUploaderConfig"/>
                                        </item>
                                        <item name="dataScope" xsi:type="string">attachment</item>
                                        <item name="displayArea" xsi:type="string">attachment</item>
                                    </item>
                                </item>
                            </item>
                        </item>
                    </argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
