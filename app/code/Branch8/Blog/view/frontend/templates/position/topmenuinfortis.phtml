<?php
/**
 *
 * @category    Branch8
 * @package     Branch8_Blog
 */

use Branch8\Blog\Helper\Data;
use Magento\Framework\Escaper;

/** @var Escaper $escaper */
$helper = $this->helper(Data::class);

if ($helper->isEnabled() && $helper->getBlogConfig('display/toplinks')) : ?>
    <li class="nav-item level0 nav-5 level-top classic">
        <a href="<?= $escaper->escapeUrl($helper->getBlogUrl('')) ?>" class="level-top">
            <span><?= $helper->getBlogConfig('display/name') ?: $escaper->escapeHtml(__('Blog')) ?></span>
        </a>
    </li>
<?php endif; ?>
