<?xml version="1.0"?>
<!--
/**
 *
 * @category    Branch8
 * @package     Branch8_Blog
 */
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="blog_design"/>
    <body>
        <referenceContainer name="content">
            <block class="Branch8\Blog\Block\Author\Listpost" name="blog.post.list" template="Branch8_Blog::post/list.phtml"/>
        </referenceContainer>
        <referenceContainer name="blog.sidebar.main">
            <block class="Branch8\Blog\Block\Author\Widget" after="blog.sidebar.mostview" name="blog.view.sidebar.author" template="Branch8_Blog::author/widget.phtml"/>
        </referenceContainer>
        <referenceBlock name="blog.sidebar.category" remove="true"/>
        <referenceBlock name="blog.sidebar.monthly" remove="true"/>
        <referenceBlock name="blog.sidebar.topic" remove="true"/>
        <referenceBlock name="blog.sidebar.tag" remove="true"/>
    </body>
</page>
