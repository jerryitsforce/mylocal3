<?xml version="1.0"?>
<!--
/**
 *
 * @category    Branch8
 * @package     Branch8_Blog
 */
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="1column" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="blog_author"/>
    <body>
        <referenceContainer name="content">
            <block class="Branch8\Blog\Block\Post\AuthorPost" name="blog.author.post" as="blog_post" template="Branch8_Blog::post/author_post.phtml" cacheable="false">
                <block class="Branch8\Blog\Block\Post\ManagePost" name="blog.manage.post" as="blog_manage_post" template="Branch8_Blog::post/manage_post.phtml">
                    <block name="field_additional"/>
                </block>
            </block>
        </referenceContainer>
    </body>
</page>

