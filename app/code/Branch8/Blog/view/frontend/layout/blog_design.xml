<?xml version="1.0"?>
<!--
/**
 *
 * @category    Branch8
 * @package     Branch8_Blog
 */
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="1column" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="Mageplaza_Core::css/grid-mageplaza.css"/>
        <css src="Mageplaza_Core::css/font-awesome.min.css"/>
        <css src="Mageplaza_Core::css/owl.carousel.css"/>
        <css src="Mageplaza_Core::css/owl.theme.css"/>
    </head>
    <body>
        <referenceContainer name="columns">
            <container name="div.sidebar.main" htmlTag="div" htmlClass="sidebar sidebar-main" after="main">
                <container name="blog.sidebar.main" as="sidebar_main" label="Sidebar Main">
                    <block class="Branch8\Blog\Block\Sidebar\Search" name="blog.sidebar.search" template="Branch8_Blog::sidebar/search.phtml" ifconfig="blog/sidebar/search/enable_search"/>
                    <block class="Branch8\Blog\Block\Sidebar\MostView" name="blog.sidebar.mostview" template="Branch8_Blog::sidebar/mostview.phtml" ifconfig="blog/sidebar/recent_post/enable_widget"/>
                    <block class="Branch8\Blog\Block\Category\Widget" name="blog.sidebar.category" template="Branch8_Blog::category/widget.phtml"/>
                    <block class="Branch8\Blog\Block\MonthlyArchive\Widget" name="blog.sidebar.monthly" template="Branch8_Blog::monthly/widget.phtml"/>
                    <block class="Branch8\Blog\Block\Topic\Widget" name="blog.sidebar.topic" template="Branch8_Blog::topic/widget.phtml"/>
                    <block class="Branch8\Blog\Block\Tag\Widget" name="blog.sidebar.tag" template="Branch8_Blog::tag/widget.phtml"/>
                </container>
            </container>
        </referenceContainer>
        <referenceBlock name="head.additional">
            <block class="Branch8\Blog\Block\Design" name="blog.design" template="Branch8_Blog::design.phtml"/>
        </referenceBlock>
    </body>
</page>
