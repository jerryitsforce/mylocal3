<?xml version="1.0"?>
<!--
/**
 *
 * @category    Branch8
 * @package     Branch8_Blog
 */
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="1column" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="blog_design"/>
    <body>
        <referenceContainer name="content">
            <block class="Branch8\Blog\Block\Topic\Listpost" name="mp.blog.topic.post.list" template="Branch8_Blog::post/list.phtml"/>
        </referenceContainer>
        <referenceContainer name="page.top">
         <block class="Branch8\Blog\Block\Topic\Listpost" name="topic.title" template="Branch8_Blog::topic/title.phtml" before="-"/>
        </referenceContainer>
        <move element="page.main.title" destination="topic.title" />
        <referenceContainer name="div.sidebar.main" remove="true" />
    </body>
</page>
