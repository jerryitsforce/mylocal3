<?xml version="1.0"?>
<!--
/**
 *
 * @category    Branch8
 * @package     Branch8_Blog
 */
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="1column" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="blog_design"/>
    <body>
        <referenceBlock name="head.additional">
            <block class="Branch8\Blog\Block\Post\View" name="blog.post.head" template="Branch8_Blog::post/head.phtml"/>
        </referenceBlock>
        <referenceContainer name="content">
            <block class="Branch8\Blog\Block\Post\View" name="blog.post.view" template="Branch8_Blog::post/view.phtml" cacheable="false">
                <block class="Branch8\Blog\Block\Post\RelatedProduct" name="related.category.products" as="related_products" template="Branch8_Blog::product/list.phtml"/>
            </block>
        </referenceContainer>
    </body>
</page>
