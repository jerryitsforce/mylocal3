<?xml version="1.0"?>
<!--
/**
 *
 * @category    Branch8
 * @package     Branch8_Blog
 */
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magento_Backend::content">
                    <resource id="Branch8_Blog::blog" title="Better Blog" sortOrder="25">
                        <resource id="Branch8_Blog::post" title="Posts" sortOrder="10"/>
                        <!--<resource id="Branch8_Blog::tag" title="Tags" sortOrder="20"/>-->
                        <resource id="Branch8_Blog::topic" title="Topics" sortOrder="30"/>
                        <resource id="Branch8_Blog::category" title="Categories" sortOrder="40"/>
                        <resource id="Branch8_Blog::author" title="Author Information" sortOrder="50"/>
                        <resource id="Branch8_Blog::comment" title="Manage Comments" sortOrder="60"/>
                    </resource>
                </resource>
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="Branch8_Blog::configuration" title="Better Blog"/>
                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
