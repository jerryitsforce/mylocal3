<?xml version="1.0" ?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">product_status_history_listing.product_status_history_listing_data_source</item>
        </item>
        <item name="spinner" xsi:type="string">columns</item>
    </argument>
    <settings>
        <spinner>columns</spinner>
        <deps>
            <dep>product_status_history_listing.product_status_history_listing_data_source</dep>
        </deps>
        <buttons/>
    </settings>
    <dataSource name="product_status_history_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">history_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>Magento_Catalog::products</aclResource>
        <dataProvider name="product_status_history_listing_data_source" class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>history_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="columns">
        <column name="created_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date" sortOrder="10">
            <settings>
                <dataType>date</dataType>
                <label translate="true">Changed At</label>
                <sorting>desc</sorting>
            </settings>
        </column>
        <column name="before_value" class="Branch8\Catalog\Ui\Component\Listing\Columns\Product\Status" sortOrder="20">
            <settings>
                <label translate="true">Value Before Change</label>
            </settings>
        </column>
        <column name="after_value" class="Branch8\Catalog\Ui\Component\Listing\Columns\Product\Status" sortOrder="30">
            <settings>
                <label translate="true">Value After Change</label>
            </settings>
        </column>
        <column name="changed_by" class="Branch8\Catalog\Ui\Component\Listing\Columns\Product\ChangedBy" sortOrder="40">
            <settings>
                <label translate="true">Changed By</label>
            </settings>
        </column>
        <column name="changed_by_id" sortOrder="50">
            <settings>
                <label translate="true">User</label>
            </settings>
        </column>
        <actionsColumn name="updated_in_bulk_view" class="Branch8\Catalog\Ui\Component\Listing\Columns\Product\UpdatedInBulk" sortOrder="100">
            <settings>
                <label translate="true">Updated in Bulk</label>
                <indexField>history_id</indexField>
            </settings>
        </actionsColumn>
    </columns>
</listing>
