                type="Branch8\Catalog\Plugin\Magento\Catalog\Controller\Adminhtml\Product\Action\Attribute\Save" sortOrder="10" disabled="false"/>
    </type>
    <preference for="Magento\Catalog\Controller\Adminhtml\Product\Save"
