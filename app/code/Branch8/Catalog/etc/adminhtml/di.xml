                <item name="commission_source" xsi:type="array">
                    <item name="class" xsi:type="string">Branch8\Catalog\Ui\DataProvider\Product\Form\Modifier\CommissionSource</item>
                    <item name="sortOrder" xsi:type="number">20</item>
                </item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="Magento\CatalogStaging\Ui\DataProvider\Product\Form\Modifier\Pool" type="Magento\Ui\DataProvider\Modifier\Pool">
        <arguments>
            <argument name="modifiers" xsi:type="array">
                <item name="main_category" xsi:type="array">
                    <item name="class" xsi:type="string">Branch8\Catalog\Ui\DataProvider\Product\Form\Modifier\MainCategory</item>
                    <item name="sortOrder" xsi:type="number">20</item>
                </item>
                <item name="product_visibility" xsi:type="array">
                    <item name="class" xsi:type="string">Branch8\Catalog\Ui\DataProvider\Product\Form\Modifier\Visibility</item>
                    <item name="sortOrder" xsi:type="number">300</item>
                </item>
                <item name="brand" xsi:type="array">
                    <item name="class" xsi:type="string">Branch8\Catalog\Ui\DataProvider\Product\Form\Modifier\Brand</item>
                    <item name="sortOrder" xsi:type="number">20</item>
                </item>
                <item name="commission_source" xsi:type="array">
                    <item name="class" xsi:type="string">Branch8\Catalog\Ui\DataProvider\Product\Form\Modifier\CommissionSource</item>
                    <item name="sortOrder" xsi:type="number">20</item>
                </item>
            </argument>
        </arguments>
