                    <item name="sortOrder" xsi:type="number">200</item>
                </item>
                <item name="product_general_stg_modifier" xsi:type="array">
                    <item name="class" xsi:type="string">Branch8\Catalog\Ui\DataProvider\Product\RemovePreorderAttrFromStg</item>
