<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="campaign_report_data_source" xsi:type="string">CampaignReportCollection</item>
            </argument>
        </arguments>
    </type>
    <preference for="Webkul\SpinToWin\Controller\Index\Check"
        type="Branch8\Spin2Win\Rewrite\Controller\Index\Check"/>

    <preference for="Webkul\SpinToWin\Controller\Index\Index"
        type="Branch8\Spin2Win\Rewrite\Controller\Index\Index"/>
    <type name="Webkul\SpinToWin\Helper\Data">
        <plugin name="branch8_add_more_spin_display" type="Branch8\Spin2Win\Plugin\Helper\Data" sortOrder="10" disabled="false"  />
    </type>

    <preference for="Webkul\SpinToWin\Logger\Logger"
        type="Branch8\Spin2Win\Logger\Logger"/>
</config>
