<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">hifi_sales_report_sub_record_listing.hifi_sales_report_sub_record_listing_data_source</item>
            <item name="deps" xsi:type="string">hifi_sales_report_sub_record_listing.hifi_sales_report_sub_record_listing_data_source</item>
        </item>
        <item name="spinner" xsi:type="string">hifi_sales_report_sub_record_listing_columns</item>
    </argument>
    <dataSource name="hifi_sales_report_sub_record_listing_data_source">
        <argument name="dataProvider" xsi:type="configurableObject">
            <argument name="class" xsi:type="string">Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider</argument>
            <argument name="name" xsi:type="string">hifi_sales_report_sub_record_listing_data_source</argument>
            <argument name="primaryFieldName" xsi:type="string">record_id</argument>
            <argument name="requestFieldName" xsi:type="string">id</argument>
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="component" xsi:type="string">Magento_Ui/js/grid/provider</item>
                    <item name="update_url" xsi:type="url" path="mui/index/render"/>
                    <item name="storageConfig" xsi:type="array">
                        <item name="indexField" xsi:type="string">record_id</item>
                    </item>
                </item>
            </argument>
        </argument>
    </dataSource>
    <listingToolbar name="listing_top">
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <paging name="listing_paging"/>
        <massaction name="listing_massaction">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="selectProvider" xsi:type="string">hifi_sales_report_sub_record_listing.hifi_sales_report_sub_record_listing.hifi_sales_report_sub_record_listing_columns.ids
                    </item>
                    <item name="component" xsi:type="string">Magento_Ui/js/grid/tree-massactions</item>
                    <item name="indexField" xsi:type="string">record_id</item>
                </item>
            </argument>
            <action name="sync">
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="type" xsi:type="string">sync_to_hifi</item>
                        <item name="label" xsi:type="string" translate="true">Sync To HIFI</item>
                        <item name="url" xsi:type="url" path="hifi_sales_report/massAction/subRecordSync"/>
                        <item name="confirm" xsi:type="array">
                            <item name="title" xsi:type="string" translate="true">Sync To HIFI</item>
                            <item name="message" xsi:type="string" translate="true">Are you sure you want to sync selected sub records to HIFI?</item>
                        </item>
                    </item>
                </argument>
            </action>
            <action name="display_sync_data">
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="type" xsi:type="string">display_sync_to_hifi_data</item>
                        <item name="label" xsi:type="string" translate="true">Display Sync To HIFI Data</item>
                        <item name="url" xsi:type="url" path="hifi_sales_report/massAction/displaySubRecordSyncData"/>
                    </item>
                </argument>
            </action>
        </massaction>
    </listingToolbar>
    <columns name="hifi_sales_report_sub_record_listing_columns">
        <selectionsColumn name="ids">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="indexField" xsi:type="string">record_id</item>
                </item>
            </argument>
        </selectionsColumn>
        <column name="record_id">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="filter" xsi:type="string">textRange</item>
                    <item name="sorting" xsi:type="string">desc</item>
                    <item name="label" xsi:type="string" translate="true">Hifi ID</item>
                </item>
            </argument>
        </column>
        <column name="parent_id">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="filter" xsi:type="string">textRange</item>
                    <item name="label" xsi:type="string" translate="true">Parent ID</item>
                </item>
            </argument>
        </column>
        <column name="batch_code">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="filter" xsi:type="string">text</item>
                    <item name="label" xsi:type="string" translate="true">Batch Code</item>
                </item>
            </argument>
        </column>
        <column name="invoice_status">
            <argument name="data" xsi:type="array">
                <item name="options" xsi:type="object">Branch8\HifiSalesReport\Model\HifiSalesReportSubRecord\Source\InvoiceStatus</item>
                <item name="config" xsi:type="array">
                    <item name="filter" xsi:type="string">select</item>
                    <item name="component" xsi:type="string">Magento_Ui/js/grid/columns/select</item>
                    <item name="dataType" xsi:type="string">select</item>
                    <item name="label" xsi:type="string" translate="true">Invoice Status</item>
                </item>
            </argument>
        </column>
        <column name="invoice_change_date" class="Magento\Ui\Component\Listing\Columns\Date">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="filter" xsi:type="string">dateRange</item>
                    <item name="dateFormat" xsi:type="string">yyyy-MM-dd</item>
                    <item name="component" xsi:type="string">Magento_Ui/js/grid/columns/date</item>
                    <item name="dataType" xsi:type="string">date</item>
                    <item name="label" xsi:type="string" translate="true">Invoice Change Date</item>
                </item>
            </argument>
        </column>
        <actionsColumn class="Branch8\HifiSalesReport\Ui\Component\Listing\Column\SubQuickView" name="sales_report_sub_quick_view">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="indexField" xsi:type="string">record_id</item>
                    <item name="label" xsi:type="string" translate="true">Hifi Quick View</item>
                </item>
            </argument>
        </actionsColumn>
        <actionsColumn class="Branch8\HifiSalesReport\Ui\Component\Listing\Column\DownloadFilteredMainFile" name="download_filtered_main_file">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="indexField" xsi:type="string">record_id</item>
                    <item name="label" xsi:type="string" translate="true">Download Filtered Main File</item>
                </item>
            </argument>
        </actionsColumn>
        <actionsColumn class="Branch8\HifiSalesReport\Ui\Component\Listing\Column\DownloadFilteredDetailFile" name="download_filtered_detail_file">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="indexField" xsi:type="string">record_id</item>
                    <item name="label" xsi:type="string" translate="true">Download Filtered Detail File</item>
                </item>
            </argument>
        </actionsColumn>
        <column name="sync_status">
            <argument name="data" xsi:type="array">
                <item name="options" xsi:type="object">Branch8\HifiSalesReport\Model\HifiSalesReportSubRecord\Source\SyncStatus</item>
                <item name="config" xsi:type="array">
                    <item name="filter" xsi:type="string">select</item>
                    <item name="component" xsi:type="string">Magento_Ui/js/grid/columns/select</item>
                    <item name="dataType" xsi:type="string">select</item>
                    <item name="label" xsi:type="string" translate="true">Sync Status</item>
                </item>
            </argument>
        </column>
        <column name="sync_result">
            <argument name="data" xsi:type="array">
                <item name="options" xsi:type="object">Branch8\HifiSalesReport\Model\HifiSalesReportSubRecord\Source\SyncResult</item>
                <item name="config" xsi:type="array">
                    <item name="filter" xsi:type="string">select</item>
                    <item name="component" xsi:type="string">Magento_Ui/js/grid/columns/select</item>
                    <item name="dataType" xsi:type="string">select</item>
                    <item name="label" xsi:type="string" translate="true">Sync Result</item>
                </item>
            </argument>
        </column>
    </columns>
</listing>
