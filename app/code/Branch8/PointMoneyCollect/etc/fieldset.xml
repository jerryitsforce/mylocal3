<?xml version="1.0" ?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:DataObject/etc/fieldset.xsd">
    <scope id="global">
        <fieldset id="sales_convert_quote">
            <field name="point_used_total">
                <aspect name="to_order" />
            </field>
            <field name="point_discount_total">
                <aspect name="to_order" />
            </field>
        </fieldset>

        <fieldset id="sales_convert_quote_item">
            <field name="row_total_point_used">
                <aspect name="to_order_item" />
            </field>
            <field name="row_total_point_discount">
                <aspect name="to_order_item" />
            </field>
            <field name="special_price">
                <aspect name="to_order_item" />
            </field>
        </fieldset>

        <fieldset id="sales_convert_quote_address">
            <field name="row_total_point_used">
                <aspect name="to_order_address" />
            </field>
            <field name="row_total_point_discount">
                <aspect name="to_order_address" />
            </field>
        </fieldset>

        <fieldset id="quote_convert_item">
            <field name="row_total_point_used">
                <aspect name="to_order_item" />
            </field>
            <field name="row_total_point_discount">
                <aspect name="to_order_item" />
            </field>
            <field name="special_price">
                <aspect name="to_order_item" />
            </field>
        </fieldset>

        <fieldset id="quote_convert_address_item">
            <field name="row_total_point_used">
                <aspect name="to_order_item" />
            </field>
            <field name="row_total_point_discount">
                <aspect name="to_order_item" />
            </field>
        </fieldset>
        <fieldset id="sales_convert_master_quote_item_to_sub_quote_item">
            <field name="row_total_point_used">
                <aspect name="to_sub_quote_item" />
            </field>
            <field name="row_total_point_discount">
                <aspect name="to_sub_quote_item" />
            </field>
        </fieldset>
    </scope>
</config>
