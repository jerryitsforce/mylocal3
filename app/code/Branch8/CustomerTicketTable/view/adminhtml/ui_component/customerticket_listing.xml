<?xml version="1.0"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Ui/etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">customerticket_listing.customerticket_listing_data_source</item>
            <item name="deps" xsi:type="string">customerticket_listing.customerticket_listing_data_source</item>
        </item>
        <item name="spinner" xsi:type="string">customerticket_columns</item>
    </argument>
    <dataSource name="customerticket_listing_data_source">
        <argument name="dataProvider" xsi:type="configurableObject">
            <argument name="class" xsi:type="string">CustomerTicketGridDataProvider</argument>
            <argument name="name" xsi:type="string">customerticket_listing_data_source</argument>
            <argument name="primaryFieldName" xsi:type="string">record_id</argument>
            <argument name="requestFieldName" xsi:type="string">record_id</argument>
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="component" xsi:type="string">Magento_Ui/js/grid/provider</item>
                    <item name="update_url" xsi:type="url" path="mui/index/render"/>
                    <item name="storageConfig" xsi:type="array">
                        <item name="indexField" xsi:type="string">record_id</item>
                    </item>
                </item>
            </argument>
        </argument>
    </dataSource>
    <container name="listing_top">
        <argument name="data" xsi:type="array">
            <item name="config" xsi:type="array">
                <item name="template" xsi:type="string">ui/grid/toolbar</item>
                <item name="stickyTmpl" xsi:type="string">ui/grid/sticky/toolbar</item>
            </item>
        </argument>
        <argument name="data" xsi:type="array">
            <item name="config" xsi:type="array">
                <item name="template" xsi:type="string">ui/grid/toolbar</item>
                <item name="stickyTmpl" xsi:type="string">ui/grid/sticky/toolbar</item>
            </item>
        </argument>
        <bookmark name="bookmarks">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="storageConfig" xsi:type="array">
                        <item name="namespace" xsi:type="string">customerticket_listing</item>
                    </item>
                </item>
            </argument>
        </bookmark>
        <component name="columns_controls">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="columnsData" xsi:type="array">
                        <item name="provider" xsi:type="string">customerticket_listing.customerticket_listing.customerticket_columns</item>
                    </item>
                    <item name="component" xsi:type="string">Magento_Ui/js/grid/controls/columns</item>
                    <item name="displayArea" xsi:type="string">dataGridActions</item>
                </item>
            </argument>
        </component>
        <exportButton name="export_button">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="selectProvider" xsi:type="string">customerticket_listing.customerticket_listing.customerticket_columns.ids</item>
                </item>
            </argument>
        </exportButton>
        <component name="columns_controls">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="columnsData" xsi:type="array">
                        <item name="provider" xsi:type="string">customerticket_listing.customerticket_listing.customerticket_columns</item>
                    </item>
                    <item name="component" xsi:type="string">Magento_Ui/js/grid/controls/columns</item>
                    <item name="displayArea" xsi:type="string">dataGridActions</item>
                </item>
            </argument>
        </component>
        <filters name="listing_filters">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="columnsProvider" xsi:type="string">customerticket_listing.customerticket_listing.customerticket_columns</item>
                    <item name="storageConfig" xsi:type="array">
                        <item name="provider" xsi:type="string">customerticket_listing.customerticket_listing.listing_top.bookmarks</item>
                        <item name="namespace" xsi:type="string">current.filters</item>
                    </item>
                    <item name="templates" xsi:type="array">
                        <item name="filters" xsi:type="array">
                            <item name="select" xsi:type="array">
                                <item name="component" xsi:type="string">Magento_Ui/js/form/element/ui-select</item>
                                <item name="template" xsi:type="string">ui/grid/filters/elements/ui-select</item>
                            </item>
                        </item>
                    </item>
                    <item name="childDefaults" xsi:type="array">
                        <item name="provider" xsi:type="string">customerticket_listing.customerticket_listing.listing_top.listing_filters</item>
                        <item name="imports" xsi:type="array">
                            <item name="visible" xsi:type="string">customerticket_listing.customerticket_listing.customerticket_columns.${ $.index }:visible</item>
                        </item>
                    </item>
                </item>
                <item name="observers" xsi:type="array">
                    <item name="column" xsi:type="string">column</item>
                </item>
            </argument>
        </filters>
        <paging name="listing_paging">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="storageConfig" xsi:type="array">
                        <item name="provider" xsi:type="string">customerticket_listing.customerticket_listing.listing_top.bookmarks</item>
                        <item name="namespace" xsi:type="string">current.paging</item>
                    </item>
                    <item name="selectProvider" xsi:type="string">customerticket_listing.customerticket_listing.customerticket_columns.ids</item>
                </item>
            </argument>
        </paging>
    </container>
    <columns name="customerticket_columns">
        <selectionsColumn name="ids">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="resizeEnabled" xsi:type="boolean">false</item>
                    <item name="resizeDefaultWidth" xsi:type="string">55</item>
                    <item name="indexField" xsi:type="string">record_id</item>
                </item>
            </argument>
        </selectionsColumn>
        <column name="record_id">
            <settings>
                <filter>text</filter>
                <label translate="true">Record ID</label>
            </settings>
        </column>

        <column name="type">
            <settings>
                <filter>text</filter>
                <label translate="true">Virtual Product Type</label>
            </settings>
        </column>

        <column name="ticket_table_name">
            <settings>
                <filter>text</filter>
                <label translate="true">Ticket Table Name</label>
            </settings>
        </column>

        <column name="ticket_table_record_id">
            <settings>
                <filter>text</filter>
                <label translate="true">Ticket Table Record ID</label>
            </settings>
        </column>

        <column name="batch_code">
            <settings>
                <filter>text</filter>
                <label translate="true">Batch Code</label>
            </settings>
        </column>

        <column name="customer_id">
            <settings>
                <filter>text</filter>
                <label translate="true">Customer ID</label>
            </settings>
        </column>
        <column name="member_seq">
            <settings>
                <filter>text</filter>
                <label translate="true">Member seq</label>
            </settings>
        </column>

        <column name="sales_order_item_id">
            <settings>
                <filter>text</filter>
                <label translate="true">Sales Order Number</label>
            </settings>
        </column>

        <column name="belong_to_product_id">
            <settings>
                <filter>text</filter>
                <label translate="true">Product ID</label>
            </settings>
        </column>

        <column name="seller_id">
            <settings>
                <filter>text</filter>
                <label translate="true">Seller ID</label>
            </settings>
        </column>

        <column name="ticket_unique_content" class="Branch8\CustomerTicketTable\Component\Listing\Columns\SerialNumber">
            <settings>
                <filter>text</filter>
                <label translate="true">Ticket Unique Content</label>
            </settings>
        </column>

        <column name="use_start_time" class="Branch8\CustomerTicketTable\Ui\Source\TicketDate">
            <settings>
                <filter>dateRange</filter>
                <label translate="true">Use Start Time</label>
            </settings>
        </column>

        <column name="use_end_time" class="Branch8\CustomerTicketTable\Ui\Source\TicketDate">
            <settings>
                <filter>dateRange</filter>
                <label translate="true">Use End Time</label>
            </settings>
        </column>
        <column name="status" component="Magento_Ui/js/grid/columns/select">
            <settings>
                <options class="Branch8\HotaiCore\Model\Ticket\Status"/>
                <filter>select</filter>
                <editor>
                    <editorType>select</editorType>
                </editor>
                <dataType>select</dataType>
                <label translate="true">Status</label>
            </settings>
        </column>

        <column name="memo">
            <settings>
                <filter>text</filter>
                <label translate="true">Memo</label>
            </settings>
        </column>

        <column name="created_at" class="Magento\Ui\Component\Listing\Columns\Date">
            <settings>
                <filter>dateRange</filter>
                <label translate="true">Created At</label>
            </settings>
        </column>

        <column name="updated_at" class="Magento\Ui\Component\Listing\Columns\Date">
            <settings>
                <filter>dateRange</filter>
                <label translate="true">Updated At</label>
            </settings>
        </column>
        <column name="redeemed_at" class="Branch8\CustomerTicketTable\Ui\Source\TicketDate">
            <settings>
                <filter>dateRange</filter>
                <label translate="true">Redeemed At</label>
            </settings>
        </column>
    </columns>
</listing>
