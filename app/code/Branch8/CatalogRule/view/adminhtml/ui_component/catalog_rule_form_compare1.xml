<?xml version="1.0"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd" extends="catalog_rule_form">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">catalog_rule_form_compare1.catalog_rule_form_compare1_data_source</item>
            <item name="deps" xsi:type="string">catalog_rule_form_compare1.catalog_rule_form_compare1_data_source</item>
        </item>
    </argument>
    <settings>
        <buttons>
            <button name="back" class="Branch8\CatalogRule\Block\Adminhtml\Edit\BackButton" />
        </buttons>
    </settings>
    

    <dataSource name="catalog_rule_form_compare1_data_source">
        <argument name="dataProvider" xsi:type="configurableObject">
            <argument name="class" xsi:type="string">Magento\CatalogRule\Model\Rule\DataProvider</argument>
            <argument name="name" xsi:type="string">catalog_rule_form_compare1_data_source</argument>
            <argument name="primaryFieldName" xsi:type="string">rule_id</argument>
            <argument name="requestFieldName" xsi:type="string">id</argument>
        </argument>
    </dataSource>
    <fieldset name="rule_information">
        <settings>
            <collapsible>true</collapsible>
            <opened>true</opened>
        </settings>
    </fieldset>
    <fieldset name="actions">
        <settings>
            <collapsible>true</collapsible>
            <opened>true</opened>
        </settings>
    </fieldset>
    <htmlContent name="block_promo_catalog_edit_tab_conditions">
        <argument name="data" xsi:type="array">
            <item name="wrapper" xsi:type="array">
                <item name="collapsible" xsi:type="boolean">true</item>
                <item name="opened" xsi:type="boolean">true</item>
            </item>
        </argument>
    </htmlContent>
    <htmlContent name="catalogrule.related.banners.content">
        <argument name="data" xsi:type="array">
            <item name="wrapper" xsi:type="array">
                <item name="collapsible" xsi:type="boolean">true</item>
                <item name="opened" xsi:type="boolean">true</item>
            </item>
        </argument>
    </htmlContent>
</form>
