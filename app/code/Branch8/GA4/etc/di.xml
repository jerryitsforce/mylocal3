<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
     <type name="Magento\Checkout\Model\ShippingInformationManagement">
        <plugin name="branch8-ga4-checkout-shippinginformation"
                type="Branch8\GA4\Plugin\ShippingInformation" sortOrder="10"/>
    </type>
    <type name="Magento\Checkout\Model\PaymentInformationManagement">
        <plugin name="branch8-ga4-checkout-paymentinformation"
                type="Branch8\GA4\Plugin\PaymentInformation" sortOrder="10"/>
    </type>
    <type name="Magento\Checkout\Model\GuestPaymentInformationManagement">
        <plugin name="branch8-ga4-checkout-guestpaymentinformation"
                type="Branch8\GA4\Plugin\GuestPaymentInformation" sortOrder="10"/>
    </type>
    <type name="Magento\Wishlist\Model\Item">
        <plugin name="branch8-ga4-wishlist-addtocart"
                type="Branch8\GA4\Plugin\WishlistAddToCart" sortOrder="10"/>
    </type>
    <preference for="Magento\Checkout\Controller\Cart\UpdateItemQty" type="Branch8\GA4\Controller\Cart\UpdateItemQty"/>
    <preference for="Magento\MultipleWishlist\Helper\Data" type="Branch8\GA4\Helper\WishlistHelperData"/>
    <preference for="Magento\Catalog\Helper\Product\Compare" type="Branch8\GA4\Helper\Product\Compare"/>
    <preference for="Magento\Wishlist\Controller\Index\Fromcart" type="Branch8\GA4\Controller\Index\Fromcart"/>
    <type name="Magento\Framework\Session\SessionManager">
        <plugin name="branch8_ga4_session_plugin" type="Branch8\GA4\Plugin\SessionManager" sortOrder="10"/>
    </type>
    <type name="Magento\CatalogWidget\Block\Product\ProductsList">
        <plugin name="b8_ga4_pagebuilder_product_list" type="Branch8\GA4\Plugin\Catalog\Block\Product\ProductsListPlugin" sortOrder="1"/>
    </type>
</config>
