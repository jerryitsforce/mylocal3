<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Framework\Console\CommandListInterface">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="importSubAccount" xsi:type="object">Branch8\MarketplaceSubAccount\Console\ImportSubAccount</item>
            </argument>
        </arguments>
    </type>
    <type name="Webkul\SellerSubAccount\Controller\Adminhtml\Account\Save">
        <plugin name="branch8_send_mail_new_sub_account" type="Branch8\MarketplaceSubAccount\Plugin\SendMainAdminCreateSubAccount"/>
    </type>
    <type name="Webkul\SellerSubAccount\Controller\Account\Save">
        <plugin name="branch8_custom_create_subaccount_at_seller" type="Branch8\MarketplaceSubAccount\Plugin\CustomCreateSubaccountAtSeller"/>
    </type>
    <type name="Webkul\SellerSubAccount\Helper\Data">
        <plugin name="branch8_send_mail_new_sub_account" type="Branch8\MarketplaceSubAccount\Plugin\Helper\Data"/>
    </type>
</config>