<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <virtualType name="B8ExportProductLog" type="Magento\Framework\Logger\Handler\Base">
        <arguments>
            <argument name="fileName" xsi:type="string">/var/log/branch8.product.export.synchronization.log</argument>
        </arguments>
    </virtualType>
    <virtualType name="B8ExportProductLogger" type="Magento\Framework\Logger\Monolog">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="debug" xsi:type="object">B8ExportProductLog</item>
            </argument>
        </arguments>
    </virtualType>
    <type name="Branch8\ProductExportRabbitMQ\Model\Queue\Consumer">
        <arguments>
            <argument name="logger" xsi:type="object">B8ExportProductLogger</argument>
        </arguments>
    </type>
</config>
