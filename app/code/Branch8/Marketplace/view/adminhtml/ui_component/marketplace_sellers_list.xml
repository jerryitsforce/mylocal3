<?xml version="1.0" encoding="UTF-8"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Ui/etc/ui_configuration.xsd">
    <container name="listing_top">
        <massaction name="listing_massaction">
            <action name="reset2fa">
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="type" xsi:type="string">reset2fa</item>
                        <item name="label" xsi:type="string" translate="true">Reset 2FA</item>
                        <item name="url" xsi:type="url" path="marketplace/tfa/resetSeller"/>
                        <item name="confirm" xsi:type="array">
                            <item name="title" xsi:type="string" translate="true">Reset Seller 2FA</item>
                            <item name="message" xsi:type="string" translate="true">Are you sure you want to RESET 2FA for these item(s)?</item>
                        </item>
                    </item>
                </argument>
            </action>
        </massaction>
    </container>
</listing>
