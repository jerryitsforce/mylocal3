$scriptString = <<<script

require(['prototype', 'jquery', 'Magento_Ui/js/modal/confirm'], function(prototype, \$j, confirm) {
//<![CDATA[
    function selectCarrierAll(elem) {
        var option = elem.options[elem.selectedIndex];
        \$j(elem).parent().parent().find('input[name="carrier_title_all"]').val(option.value && option.value != 'custom' ? option.text : '');
    }
    function selectCarrier(elem) {
        var option = elem.options[elem.selectedIndex];
        \$j(elem).parent().parent().find('input.carrier_title').val(option.value && option.value != 'custom' ? option.text : '');
    }
    \$j('select[name="carrier_all"]').change(function(){
        selectCarrierAll($(this));
    });
    \$j('select.carrier').change(function(){
        selectCarrier($(this));
    });
    
});
script;
?>
