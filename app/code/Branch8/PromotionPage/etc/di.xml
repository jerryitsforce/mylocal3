<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
   <!-- <type name="Magento\CatalogRule\Model\CatalogRuleRepository">
        <plugin name="branch_promotionpage_catalog_rule_plugin" type="Branch8\PromotionPage\Plugin\CatalogRulePlugin" />
    </type>-->
    <virtualType name="promotionPageLoggerDebug" type="Magento\Framework\Logger\Handler\Base">
        <arguments>
            <argument name="fileName" xsi:type="string">/var/log/promotionPageLoggerDebug.log</argument>
        </arguments>
    </virtualType>
    <virtualType name="promotionPageLoggerDebugLogger" type="Magento\Framework\Logger\Monolog">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="debug" xsi:type="object">promotionPageLoggerDebug</item>
            </argument>
        </arguments>
    </virtualType>

    <type name="Branch8\PromotionPage\Helper\Logger">
        <arguments>
            <argument name="logger" xsi:type="object">promotionPageLoggerDebugLogger</argument>
        </arguments>
    </type>
</config>
