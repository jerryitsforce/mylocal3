<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="promotion_page" translate="label" type="text" sortOrder="140" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Promotion Page, Vip Label</label>
            <tab>branch8</tab>
            <resource>Branch8_PromotionPage::config</resource>
            <group id="promotion_categories" translate="label" type="text" sortOrder="500" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Promotion Categories</label>
                <field id="root_category" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Promotion Root Category</label>
                    <source_model>Branch8\PromotionPage\Model\Config\Source\Category</source_model>
                </field>
                <field id="vip_category" translate="label" type="select" sortOrder="11" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Vip Category</label>
                    <source_model>Branch8\PromotionPage\Model\Config\Source\Category</source_model>
                </field>
            </group>
        </section>
        <section id="branch8_debug">
            <group id="branch8_promotionpage" translate="label" type="text" sortOrder="70" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Promotion Page</label>
                <field id="log_file" translate="label" type="multiselect" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Log Files</label>
                    <source_model>Branch8\PromotionPage\Model\Config\Source\LogTypes</source_model>
                    <can_be_empty>1</can_be_empty>
                </field>
            </group>
        </section>
    </system>
</config>
