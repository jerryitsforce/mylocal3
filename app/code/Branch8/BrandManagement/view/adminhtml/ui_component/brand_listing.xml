<?xml version="1.0" encoding="UTF-8"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">brand_listing.brand_listing_data_source</item>
            <item name="deps" xsi:type="string">brand_listing.brand_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <buttons>
            <button name="add">
                <url path="*/*/new"/>
                <class>primary</class>
                <label translate="true">Add New Brand</label>
                <aclResource>Branch8_BrandManagement::brand_create</aclResource>
            </button>
        </buttons>
        <spinner>brand_columns</spinner>
        <deps>
            <dep>brand_listing.brand_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="brand_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">option_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>      
        </settings>
        <aclResource>Branch8_BrandManagement::brand_view</aclResource>
        <dataProvider class="Branch8\BrandManagement\Ui\Component\Listing\DataProvider\BrandDataProvider" name="brand_listing_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>option_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filterSearch name="fulltext">
            <settings>
                <label translate="true">Search by keyword</label>
                <placeholder translate="true">Search by keyword</placeholder>
            </settings>
        </filterSearch>
        <filters name="listing_filters">
            <!-- 使用列配置的筛选器，这里保持空 -->
        </filters>
        <massaction name="listing_massaction">
            <action name="delete">
                <settings>
                    <confirm>
                        <message translate="true">Are you sure you want to delete selected brand options?</message>
                        <title translate="true">Delete items</title>
                    </confirm>
                    <url path="brandmanagement/brand/massDelete"/>
                    <type>delete</type>
                    <label translate="true">Delete</label>
                </settings>
            </action>
        </massaction>
        <paging name="listing_paging">
            <settings>
                <options>
                    <option name="20" xsi:type="array">
                        <item name="value" xsi:type="number">20</item>
                        <item name="label" xsi:type="string">20</item>
                    </option>
                    <option name="30" xsi:type="array">
                        <item name="value" xsi:type="number">30</item>
                        <item name="label" xsi:type="string">30</item>
                    </option>
                    <option name="50" xsi:type="array">
                        <item name="value" xsi:type="number">50</item>
                        <item name="label" xsi:type="string">50</item>
                    </option>
                    <option name="100" xsi:type="array">
                        <item name="value" xsi:type="number">100</item>
                        <item name="label" xsi:type="string">100</item>
                    </option>
                    <option name="200" xsi:type="array">
                        <item name="value" xsi:type="number">200</item>
                        <item name="label" xsi:type="string">200</item>
                    </option>
                </options>
                <pageSize>50</pageSize>
            </settings>
        </paging>
    </listingToolbar>
    <columns name="brand_columns">
        <argument name="data" xsi:type="array">
            <item name="config" xsi:type="array">
                <item name="editorConfig" xsi:type="array">
                    <item name="selectProvider" xsi:type="string">brand_listing.brand_listing.brand_columns.ids</item>
                    <item name="enabled" xsi:type="boolean">true</item>
                    <item name="indexField" xsi:type="string">option_id</item>
                    <item name="clientConfig" xsi:type="array">
                        <item name="saveUrl" xsi:type="url" path="brandmanagement/brand/inlineEdit"/>
                        <item name="validateBeforeSave" xsi:type="boolean">false</item>
                    </item>
                </item>
                <item name="childDefaults" xsi:type="array">
                    <item name="fieldAction" xsi:type="array">
                        <item name="provider" xsi:type="string">brand_listing.brand_listing.brand_columns_editor</item>
                        <item name="target" xsi:type="string">startEdit</item>
                        <item name="params" xsi:type="array">
                            <item name="0" xsi:type="string">${ $.$data.rowIndex }</item>
                            <item name="1" xsi:type="boolean">true</item>
                        </item>
                    </item>
                </item>
            </item>
        </argument>
        <selectionsColumn name="ids">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="resizeEnabled" xsi:type="boolean">false</item>
                    <item name="resizeDefaultWidth" xsi:type="string">55</item>
                    <item name="indexField" xsi:type="string">option_id</item>
                </item>
            </argument>
        </selectionsColumn>
        <column name="option_id" sortOrder="10">
            <settings>
                <filter>text</filter>
                <label translate="true">Option ID</label>
                <sorting>asc</sorting>
            </settings>
        </column>
        <column name="value" sortOrder="20">
            <settings>
                <filter>text</filter>
                <label translate="true">Brand Name</label>
                <sorting>asc</sorting>
                <editor>
                    <editorType>text</editorType>
                    <validation>
                        <rule name="required-entry" xsi:type="boolean">true</rule>
                    </validation>
                </editor>
            </settings>
        </column>
        <column name="sort_order" sortOrder="30">
            <settings>
                <filter>text</filter>
                <label translate="true">Sort Order</label>
                <sorting>asc</sorting>
                <editor>
                    <editorType>text</editorType>
                    <validation>
                        <rule name="validate-number" xsi:type="boolean">true</rule>
                    </validation>
                </editor>
            </settings>
        </column>
        <actionsColumn name="actions" class="Branch8\BrandManagement\Ui\Component\Listing\Column\Actions">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="resizeEnabled" xsi:type="boolean">false</item>
                    <item name="resizeDefaultWidth" xsi:type="string">107</item>
                    <item name="indexField" xsi:type="string">option_id</item>
                </item>
            </argument>
        </actionsColumn>
    </columns>
</listing>
