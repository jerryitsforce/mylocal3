<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_PageBuilder:etc/content_type.xsd">
    <type name="image">
        <appearances>
            <appearance name="full-width"
                        master_template="Branch8_PageBuilder/content-type/image/full-width/master">
                <elements>
                    <element name="main">
                        <attribute name="ga4_enable" source="data-ga4-enable"/>
                        <attribute name="creative_name" source="data-creative-name"/>
                        <attribute name="creative_slot" source="data-creative-slot"/>
                        <attribute name="promotion_id" source="data-promotion-id"/>
                        <attribute name="promotion_name" source="data-promotion-name"/>
                    </element>
                </elements>
            </appearance>
        </appearances>
    </type>
</config>
