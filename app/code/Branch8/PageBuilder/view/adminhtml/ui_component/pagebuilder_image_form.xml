<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd" extends="pagebuilder_base_form">
    <fieldset name="ga4_settings" sortOrder="25">
        <settings>
            <label translate="true">Google Analytics 4</label>
            <collapsible>true</collapsible>
            <opened>true</opened>
        </settings>

        <field name="ga4_enable" sortOrder="5" formElement="checkbox">
            <settings>
                <dataType>boolean</dataType>
                <label translate="true">Enable</label>
                <dataScope>ga4_enable</dataScope>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="string">disabled</map>
                            <map name="true" xsi:type="string">enabled</map>
                        </valueMap>
                        <prefer>toggle</prefer>
                    </settings>
                </checkbox>
            </formElements>
        </field>
        <field name="creative_name" sortOrder="10" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Creative Name</label>
                <dataScope>creative_name</dataScope>
            </settings>
        </field>
        <field name="creative_slot" sortOrder="20" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Creative Slot</label>
                <dataScope>creative_slot</dataScope>
            </settings>
        </field>
        <field name="promotion_id" sortOrder="40" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Promotion ID</label>
                <dataScope>promotion_id</dataScope>
            </settings>
        </field>
        <field name="promotion_name" sortOrder="50" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Promotion Name</label>
                <dataScope>promotion_name</dataScope>
            </settings>
        </field>
    </fieldset>
</form>
