<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="branch8_helpdesk_ticket">
        <column xsi:type="int" name="ticket_id" unsigned="true"
                nullable="false" comment="Primary key" identity="true"/>
        <column xsi:type="varchar" name="title" length="512" nullable="false" comment="Title"/>
        <column xsi:type="varchar" name="code" length="64" nullable="true" comment="Ticket Code"/>
        <column xsi:type="varchar" name="attachment_ids" length="64" nullable="true"
                comment="First Attachment"/>

        <column xsi:type="int" name="category_id" unsigned="true"
                nullable="true" comment="Category Ticket Id"/>
        <column xsi:type="varchar" name="sku" length="128" nullable="true" comment="Product SKU"/>
        <column xsi:type="varchar" name="order" length="512" nullable="true" comment="Order"/>
        <column xsi:type="int" name="user_id" unsigned="true" nullable="true" comment="User ID"/>
        <column xsi:type="int" name="create_by" unsigned="true" nullable="true" comment="Create By User"/>

        <column xsi:type="varchar" name="user_email" length="128" nullable="true" comment="User email"/>
        <column xsi:type="varchar" name="user_name" length="128" nullable="true" comment="User Name"/>
        <column xsi:type="int" name="customer_id" unsigned="true" nullable="true" identity="false"
                comment="Customer ID"/>
        <column xsi:type="varchar" name="customer_email" length="128" nullable="false" comment="Customer email"/>
        <column xsi:type="varchar" name="customer_name" length="128" nullable="false" comment="Customer Name"/>
        <column xsi:type="varchar" name="phone" length="128" nullable="false" comment="Customer Phone"/>

        <column xsi:type="int" name="team_id" unsigned="true" nullable="true" comment="Team ID"/>

        <column xsi:type="smallint" name="priority"
                unsigned="false" nullable="false" identity="false"
                default="1"
        />
        <column xsi:type="mediumtext" name="content" nullable="false"
                comment="Content"/>
        <column xsi:type="smallint" name="status" unsigned="false"
                nullable="false" identity="false"
                default="5" comment="Ticket Status "/>
        <column xsi:type="smallint" name="frontend_status" unsigned="false"
                nullable="false" identity="false"
                default="1" comment="Frontend Ticket Status "/>

        <column xsi:type="varchar" name="last_reply_name"
                nullable="false" length="255" comment="Last Reply Name"/>
        <column xsi:type="timestamp" name="last_reply_date"
                on_update="false" nullable="false"
                default="0"
                comment="Last Reply At"/>
        <column xsi:type="timestamp" name="created_at" on_update="false"
                nullable="false" default="CURRENT_TIMESTAMP"
                comment="Ticket Creation Time"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true"
                nullable="false" default="CURRENT_TIMESTAMP"
                comment="Ticket Modification Time"/>
        <index referenceId="BRANCH8_HELPDESK_TICKET_CUSTOMER_NAME" indexType="btree">
            <column name="customer_name"/>
        </index>
        <index referenceId="b8_hd_ticket_title" indexType="btree">
            <column name="title"/>
        </index>
        <index referenceId="B8_HD_TICKET_PHONE" indexType="btree">
            <column name="phone"/>
        </index>
        <index referenceId="BRANCH8_HELPDESK_TICKET_CUSTOMER_EMAIl" indexType="btree">
            <column name="customer_email"/>
        </index>
        <index referenceId="BRANCH8_HELPDESK_TICKET_FULL_TEXT" indexType="fulltext">
            <column name="code"/>
            <column name="title"/>
        </index>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="ticket_id"/>
        </constraint>
        <constraint xsi:type="unique"
                    referenceId="BRANCH8_HELPDESK_TICKET_CODE">
            <column name="code"/>
        </constraint>
        <constraint xsi:type="foreign"
                    referenceId="branch8_helpdesk_ticket_category_id"
                    table="branch8_helpdesk_ticket"
                    column="category_id" referenceTable="branch8_helpdesk_category"
                    referenceColumn="category_id" onDelete="SET NULL"/>
        <constraint xsi:type="foreign"
                    referenceId="b8_hd_ticket_team_id_b8_hd_ticket_team_team_id"
                    table="branch8_helpdesk_ticket"
                    column="team_id" referenceTable="branch8_helpdesk_team"
                    referenceColumn="team_id" onDelete="SET NULL"/>
        <constraint xsi:type="foreign"
                    referenceId="b8_hd_ticket_user_id_admin_user_user_id"
                    table="branch8_helpdesk_ticket"
                    column="user_id" referenceTable="admin_user"
                    referenceColumn="user_id" onDelete="SET NULL"/>
        <constraint xsi:type="foreign"
                    referenceId="b8_hd_ticket_create_by_admin_user_user_id"
                    table="branch8_helpdesk_ticket"
                    column="create_by" referenceTable="admin_user"
                    referenceColumn="user_id" onDelete="SET NULL"/>
    </table>
    <table name="branch8_helpdesk_message">
        <column xsi:type="int" name="message_id" unsigned="true" nullable="false" comment="Primary key"
                identity="true"/>
        <column xsi:type="int" name="ticket_id" unsigned="true"
                nullable="false" comment="Primary key" identity="false"/>
        <column xsi:type="int" name="user_id" unsigned="true" nullable="true" comment="User ID"/>
        <column xsi:type="varchar" name="user_email" length="128" nullable="true" comment="User email"/>
        <column xsi:type="varchar" name="user_name" length="128" nullable="true" comment="User Name"/>
        <column xsi:type="int" name="customer_id" unsigned="true" nullable="true" comment="Customer ID"/>
        <column xsi:type="varchar" name="customer_email" length="128" nullable="true" comment="Customer email"/>
        <column xsi:type="varchar" name="customer_name" length="128" nullable="true" comment="Customer Name"/>
        <column xsi:type="varchar" name="remote_ip" nullable="true" length="64" comment="Remote Ip"/>
        <column xsi:type="smallint" name="belong_to" unsigned="false"
                nullable="false" identity="false"
                default="0" comment="Message Belong To Customer,Admin,Anomynous"/>
        <column xsi:type="mediumtext" name="content"
                nullable="true" comment="Message Content"/>
        <column xsi:type="smallint" name="is_read"
                unsigned="false" nullable="false" identity="false"
                default="0" comment="Is Read"/>
        <column xsi:type="timestamp" name="created_at" on_update="false"
                nullable="false" default="CURRENT_TIMESTAMP"
                comment="Message Created Time"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true"
                nullable="false" default="CURRENT_TIMESTAMP"
                comment="Message Modification Time"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="message_id"/>
        </constraint>
        <constraint xsi:type="foreign"
                    referenceId="b8_helpdesk_message_customer"
                    table="branch8_helpdesk_message"
                    column="customer_id" referenceTable="customer_entity"
                    referenceColumn="entity_id" onDelete="SET NULL"/>
        <constraint xsi:type="foreign"
                    referenceId="b8_helpdesk_message_admin_user_user_id"
                    table="branch8_helpdesk_message"
                    column="user_id" referenceTable="admin_user"
                    referenceColumn="user_id" onDelete="SET NULL"/>
        <constraint xsi:type="foreign"
                    referenceId="br8_hd_message_b8_hd_ticket_id"
                    table="branch8_helpdesk_message"
                    column="ticket_id" referenceTable="branch8_helpdesk_ticket"
                    referenceColumn="ticket_id" onDelete="CASCADE"/>
    </table>
    <table name="branch8_helpdesk_attachment">
        <column xsi:type="int" name="attachment_id" unsigned="true"
                nullable="false" comment="Primary key" identity="true"/>
        <column xsi:type="int" name="message_id" unsigned="true" identity="false"
                nullable="false" comment="Message Id"/>
        <column xsi:type="varchar" name="name" length="1024" nullable="true"
                comment="Attachment Name"/>
        <column xsi:type="varchar" name="path" length="1024" nullable="true"
                comment="Attachment Name"/>
        <column xsi:type="varchar" name="type" length="64" nullable="true"
                comment="Type Attachment"/>
        <column xsi:type="mediumtext" name="meta"
                nullable="true" comment="meta"/>
        <column xsi:type="timestamp" name="created_at" on_update="false"
                nullable="false" default="CURRENT_TIMESTAMP"
                comment="Attachment Creation Time"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true"
                nullable="false" default="CURRENT_TIMESTAMP"
                comment="Attachment Modification Time"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="attachment_id"/>
        </constraint>
        <constraint xsi:type="foreign"
                    referenceId="branch8_hd_attachment_mg_id_branch8_hd_msg_msg_id"
                    table="branch8_helpdesk_attachment"
                    column="message_id" referenceTable="branch8_helpdesk_message"
                    referenceColumn="message_id" onDelete="CASCADE"/>
    </table>
    <table name="branch8_helpdesk_category">
        <column xsi:type="int" name="category_id" unsigned="true"
                nullable="false" comment="Primary key" identity="true"/>
        <column xsi:type="timestamp" name="created_at" on_update="false"
                nullable="false" default="CURRENT_TIMESTAMP"
                comment="Category Ticket Creation Time"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true"
                nullable="false" default="CURRENT_TIMESTAMP"
                comment="Category Ticket Modification Time"/>
        <column xsi:type="int" name="position" unsigned="true"
                nullable="false"
                default="0"
                comment="Position"/>
        <column xsi:type="int" name="is_active" unsigned="true"
                nullable="false"
                default="1"
                comment="Is Active"/>
        <column xsi:type="varchar" name="title" length="64" nullable="true"
                comment="Category Title"/>
        <column xsi:type="mediumtext" name="description"
                nullable="true" comment="Category Description"/>
        <index referenceId="BRANCH8_HELPDESK_CATEGORY_TITLE" indexType="btree">
            <column name="title"/>
        </index>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="category_id"/>
        </constraint>
    </table>
    <table name="branch8_helpdesk_category_store">
        <column xsi:type="int" name="entity_id" unsigned="false"
                nullable="false" identity="true"
                comment="Entity ID"/>
        <column xsi:type="int" name="category_id" unsigned="true"
                nullable="false" identity="false"
                default="0" comment="Category ID"/>

        <column xsi:type="smallint" name="store_id" unsigned="true"
                nullable="false"
                comment="Store ID"/>
        <constraint xsi:type="unique"
                    referenceId="BRANCH8_HELPDESK_CATEGORY_STORE_CATEGORY_ID_STORE_ID">
            <column name="category_id"/>
            <column name="store_id"/>
        </constraint>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="foreign"
                    referenceId="branch8_helpdesk_category_store_category_id"
                    table="branch8_helpdesk_category"
                    column="category_id" referenceTable="branch8_helpdesk_category"
                    referenceColumn="category_id"
                    onDelete="CASCADE"/>
        <constraint xsi:type="foreign"
                    referenceId="branch8_helpdesk_category_store_store_store_id"
                    table="branch8_helpdesk_category_store"
                    column="store_id"
                    referenceTable="store"
                    referenceColumn="store_id" onDelete="CASCADE"/>
    </table>
    <table name="branch8_helpdesk_team">
        <column xsi:type="int" name="team_id" unsigned="true"
                nullable="false" comment="Primary key" identity="true"/>
        <column xsi:type="varchar" name="name" length="512" nullable="true"
                comment="Team Name"/>
        <column xsi:type="smallint" name="is_active" unsigned="false"
                nullable="false" identity="false"
                default="1" comment="Is Active"/>
        <column xsi:type="timestamp" name="created_at" on_update="false"
                nullable="false" default="CURRENT_TIMESTAMP"
                comment="Creation Time"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true"
                nullable="false" default="CURRENT_TIMESTAMP"
                comment="Modification Time"/>
        <index referenceId="BRANCH8_HELPDESK_TEAM_NAME" indexType="btree">
            <column name="name"/>
        </index>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="team_id"/>
        </constraint>
    </table>
    <table name="branch8_helpdesk_team_user">
        <column xsi:type="int" name="entity_id" unsigned="true"
                nullable="false" comment="Primary key" identity="true"/>
        <column xsi:type="int" name="team_id" unsigned="true"
                nullable="true" comment="Team ID"/>
        <column xsi:type="int" name="user_id" unsigned="true"
                nullable="true" comment="User ID"/>
        <constraint xsi:type="foreign"
                    referenceId="b8_hd_team_user_team_id_b8_helpdesk_team"
                    table="branch8_helpdesk_team_user"
                    column="team_id" referenceTable="branch8_helpdesk_team"
                    referenceColumn="team_id" onDelete="CASCADE"/>
        <constraint xsi:type="foreign"
                    referenceId="branch8_hd_team_user_admin_user_user_id"
                    table="branch8_helpdesk_team_user"
                    column="user_id" referenceTable="admin_user"
                    referenceColumn="user_id" onDelete="CASCADE"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
    </table>
</schema>
