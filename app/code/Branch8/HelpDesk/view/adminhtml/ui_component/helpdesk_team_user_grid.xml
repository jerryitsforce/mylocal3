<?xml version="1.0" encoding="UTF-8"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">helpdesk_team_user_grid.helpdesk_team_user_grid_data_source</item>
        </item>
    </argument>
    <settings>
        <spinner>helpdesk_team_user_grid_columns</spinner>
        <deps>
            <dep>helpdesk_team_user_grid.helpdesk_team_user_grid_data_source</dep>
        </deps>
    </settings>
    <dataSource name="helpdesk_team_user_grid_data_source"
                component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">user_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <dataProvider class="Branch8\HelpDesk\Model\ResourceModel\User\DataProvider"
                      name="helpdesk_team_user_grid_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>user_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="helpdesk_team_user_grid_columns">
        <selectionsColumn name="ids">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="indexField" xsi:type="string">user_id</item>
                </item>
            </argument>
        </selectionsColumn>
        <column name="user_id" >
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID</label>
                <sorting>asc</sorting>
            </settings>
        </column>
        <column name="name" >
            <settings>
                <filter>text</filter>
                <label translate="true">User Name</label>
                <sortable>false</sortable>
            </settings>
        </column>
        <column name="email">
            <settings>
                <filter>text</filter>
                <label translate="true">Email</label>
            </settings>
        </column>
    </columns>
</listing>
