<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
    	<referenceBlock name="customer_account_navigation">
    		<block class="Branch8\HelpDesk\Block\Account\Dashboard\Link\Ticket"
                   ifconfig="helpdesk/general_settings/enable"
                   name="customer-account-helpdesk">
                <arguments>
                    <argument name="path" xsi:type="string">helpdesk/ticket</argument>
                    <argument name="label" xsi:type="string">My Support Tickets</argument>
                </arguments>
            </block>
    	</referenceBlock>
    </body>
</page>
