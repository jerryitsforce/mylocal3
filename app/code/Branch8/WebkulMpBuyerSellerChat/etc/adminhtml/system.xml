<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="webkul" translate="label comment" sortOrder="10">
            <label>Webkul</label>
        </tab>
        <section id="buyer_seller_chat" translate="label comment" type="text" sortOrder="305" showInDefault="1"
                 showInWebsite="1" showInStore="1">
            <group id="general_settings" translate="label comment" type="text" sortOrder="1" showInDefault="1" showInWebsite="1" showInStore="1">
                <field id="enable" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="test_connection" translate="label" sortOrder="60" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label/>
                    <button_label>Ping</button_label>
                    <button_url>adminhtml/chat/ping</button_url>
                    <frontend_model>Branch8\WebkulMpBuyerSellerChat\Block\Adminhtml\System\Config\PingButton</frontend_model>
                    <depends>
                        <field id="buyer_seller_chat/general_settings/enabled">1</field>
                    </depends>
                </field>
            </group>
            <group id="email">
                <field id="offline_seller_email_template" translate="label comment" sortOrder="1" type="select" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Offline Seller Email Template</label>
                    <source_model>Magento\Config\Model\Config\Source\Email\Template</source_model>
                </field>
            </group>
            <group id="seller_setting" translate="label comment" type="text" sortOrder="1" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Seller Setting</label>
                <field id="ajax_load_conversation" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Ajax Load Conversation</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="ajax_load_conversation_pagesize" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Ajax Load Conversation Page Size</label>
                </field>
                <field id="notify_when_have_new_message" translate="label comment" type="select" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Notify When Have New Message</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="closeafter" translate="label comment" type="text" sortOrder="60" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Close Popup After(s)</label>
                </field>
            </group>
            <group id="messages" translate="label comment" type="text" sortOrder="1" showInDefault="1" showInWebsite="0" showInStore="0">
                <label>Messages Setting</label>
                <field id="auto_mark_read" translate="label comment" type="multiselect" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Auto Mark Read With Message Types</label>
                    <source_model>Branch8\WebkulMpBuyerSellerChat\Model\Config\Source\AutoMarkReadWithMessageTypes</source_model>
                </field>

            </group>
        </section>
        <section id="branch8_debug">
            <group id="branch8_webkulmpbuyersellerchat" translate="label" type="text" sortOrder="120" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Webkul MP Buyer Seller Chat</label>
                <field id="log_file" translate="label" type="multiselect" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Log Files</label>
                    <source_model>Branch8\WebkulMpBuyerSellerChat\Model\Config\Source\LogTypes</source_model>
                    <can_be_empty>1</can_be_empty>
                </field>
            </group>
        </section>
    </system>
</config>
