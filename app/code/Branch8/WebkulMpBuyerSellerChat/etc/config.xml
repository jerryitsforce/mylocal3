<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <buyer_seller_chat>
            <general_settings>
                <enable>1</enable>
            </general_settings>
            <customer>
                <contact_links>
                    <hide_for_order_statues>0</hide_for_order_statues>
                </contact_links>
            </customer>
            <email>
                <offline_seller_email_template>buyer_seller_chat_email_offline_seller_email_template</offline_seller_email_template>
            </email>
            <seller_setting>
                <ajax_load_conversation>1</ajax_load_conversation>
                <ajax_load_conversation_pagesize>1000</ajax_load_conversation_pagesize>
                <notify_when_have_new_message>1</notify_when_have_new_message>
                <close_popup_after>5</close_popup_after>
            </seller_setting>
            <messages>
                <auto_mark_read>image,video,html,file</auto_mark_read>
            </messages>
        </buyer_seller_chat>
        <branch8_debug>
            <branch8_webkulmpbuyersellerchat>
                <log_file>system,exception</log_file>
            </branch8_webkulmpbuyersellerchat>
        </branch8_debug>
    </default>
</config>
