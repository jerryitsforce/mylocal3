<script>
    require([
        'jquery',
        'mage/validation'
    ], function ($) {
        var delegateUser = $('#user_delegate_user_id');
        var startDate = $('#user_delegate_start_date');
        var endDate = $('#user_delegate_end_date');

        function updateRequired() {
            var isAnyFilled = delegateUser.val() || startDate.val() || endDate.val();

            if (isAnyFilled) {
                delegateUser.addClass('required-entry');
                startDate.addClass('required-entry');
                endDate.addClass('required-entry');
                $('label[for="user_delegate_user_id"]').addClass('required');
                $('label[for="user_delegate_start_date"]').addClass('required');
                $('label[for="user_delegate_end_date"]').addClass('required');
            } else {
                delegateUser.removeClass('required-entry');
                startDate.removeClass('required-entry');
                endDate.removeClass('required-entry');
                $('label[for="user_delegate_user_id"]').removeClass('required');
                $('label[for="user_delegate_start_date"]').removeClass('required');
                $('label[for="user_delegate_end_date"]').removeClass('required');
            }
        }

        // Delay event listener attachment to skip initial programmatic change events
        setTimeout(function() {
            delegateUser.on('change', updateRequired);
            startDate.on('change', updateRequired);
            endDate.on('change', updateRequired);
        }, 1000);
    });

</script>
