<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="role_delegate" translate="label" type="text" sortOrder="150" showInDefault="1"
                 showInWebsite="1"
                 showInStore="1">
            <label>Role Delegate Permission</label>
            <tab>branch8</tab>
            <resource>Branch8_RoleDelegate::config</resource>
            <group id="general" translate="label" type="text" sortOrder="0" showInDefault="1" showInWebsite="1"
                   showInStore="1">
                <label>General</label>
                <field id="user_role" translate="label" type="multiselect" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>User Role</label>
                    <source_model>Branch8\UserCustom\Model\Source\UserRole</source_model>
                    <can_be_empty>1</can_be_empty>
                </field>
            </group>
        </section>
    </system>
</config>
