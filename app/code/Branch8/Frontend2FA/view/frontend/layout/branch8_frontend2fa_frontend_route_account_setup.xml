<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="marketplace_account_login"/>
    <body>
        <referenceContainer name="seller.login.content">
            <block template="Branch8_Frontend2FA::setup.phtml" class="Branch8\Frontend2FA\Block\Authenticator" name="setup" cacheable="false" />
        </referenceContainer>
        <referenceBlock name="root">
            <action method="setHeaderTitle">
                <argument translate="true" name="title" xsi:type="string">Two-Factor Authentication Setup</argument>
            </action>
        </referenceBlock>
        <referenceBlock name="customer.login.container" remove="true" />
        <referenceBlock name="form.additional.infor" remove="true" />
        <referenceBlock name="seller-require-cookie" remove="true" />
        <referenceBlock name="seller.pageCache" remove="true" />
        <referenceBlock name="head.components" remove="true" />
    </body>
</page>
