<?xml version="1.0" ?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
	<preference for="Branch8\Hopes\Api\OrderStackDetailsManagementInterface" type="Branch8\Hopes\Model\OrderStackDetailsManagement"/>
	<preference for="Branch8\Hopes\Api\UpdateShippingTrackNumberManagementInterface" type="Branch8\Hopes\Model\UpdateShippingTrackNumberManagement"/>
	<preference for="Branch8\Hopes\Api\OrderStackShipmentSinManagementInterface" type="Branch8\Hopes\Model\OrderStackShipmentSinManagement"/>
	<preference for="Branch8\Hopes\Api\UpdateShipmentSrpManagementInterface" type="Branch8\Hopes\Model\UpdateShipmentSrpManagement"/>
	<preference for="Branch8\Hopes\Api\UpdateShipmentEtaManagementInterface" type="Branch8\Hopes\Model\UpdateShipmentEtaManagement"/>
	<preference for="Branch8\Hopes\Api\UpdateShipmentEinManagementInterface" type="Branch8\Hopes\Model\UpdateShipmentEinManagement"/>
	<preference for="Branch8\Hopes\Api\UpdateShipmentPPSManagementInterface" type="Branch8\Hopes\Model\UpdateShipmentPPSManagement"/>
	<preference for="Branch8\Hopes\Api\CreateRmaManagementInterface" type="Branch8\Hopes\Model\CreateRmaManagement"/>
	<preference for="Branch8\Hopes\Api\RmaDetailsManagementInterface" type="Branch8\Hopes\Model\RmaDetailsManagement"/>
	<preference for="Branch8\Hopes\Api\UpdateReturnStatusManagementInterface" type="Branch8\Hopes\Model\UpdateReturnStatusManagement"/>
	<preference for="Branch8\Hopes\Api\RmaVoidInvoiceManagementInterface" type="Branch8\Hopes\Model\RmaVoidInvoiceManagement"/>
	<preference for="Branch8\Hopes\Api\TCatEodManagementInterface" type="Branch8\Hopes\Model\TCatEodManagement"/>
	<preference for="Branch8\Hopes\Api\TCatSodManagementInterface" type="Branch8\Hopes\Model\TCatSodManagement"/>
	<preference for="Branch8\Hopes\Api\TCatCreateRmaShippingNumberManagementInterface" type="Branch8\Hopes\Model\TCatCreateRmaShippingNumberManagement"/>

	<!-- Logger -->
	<virtualType name="Branch8\Hopes\Logger\Logger">
        <arguments>
            <argument name="name" xsi:type="string">Hopes</argument>
            <argument name="handlers"  xsi:type="array">
                <item name="system" xsi:type="object">Branch8\Hopes\Logger\Handler</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="Branch8\Hopes\Logger\Handler">
        <arguments>
            <argument name="filesystem" xsi:type="object">Magento\Framework\Filesystem\Driver\File</argument>
        </arguments>
    </virtualType>

	<type name="Branch8\Hopes\Model\AbstractModel">
        <arguments>
            <argument name="logger" xsi:type="object">Branch8\Hopes\Logger\Logger</argument>
        </arguments>
    </type>
	<virtualType name="Magento\Framework\Console\CommandList">
		<arguments>
			<argument name="commands" xsi:type="array">
				<item name="HopesConsole" xsi:type="object">Branch8\Hopes\Console\Command\HopesData</item>
			</argument>
		</arguments>
	</virtualType>
</config>
