<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="customer_fullScreenChat"/>
    <body>
        <referenceContainer name="additional.product.info">
            <block class="Magento\Framework\View\Element\Template"
                   name="marketplace_seller_chat_link" template="Branch8_WebkulMpBuyerSellerChatForParentOrder::chatLink.phtml"
                   ifconfig="buyer_seller_chat/parent_order/enable"
            >
                <arguments>
                    <argument name="view_model" xsi:type="object">Branch8\WebkulMpBuyerSellerChatForParentOrder\ViewModel\ChatConfig</argument>
                </arguments>
            </block>
        </referenceContainer>
        <referenceContainer name="before.body.end">
            <!-- Begin chatLink Js-->
            <block class="Magento\Framework\View\Element\Template"
                   ifconfig="buyer_seller_chat/parent_order/enable"
                   name="customer_chat_link_js_init"
                   template="Branch8_WebkulMpBuyerSellerChatForParentOrder::jsInit.phtml">
                <arguments>
                    <argument name="view_model" xsi:type="object">Branch8\WebkulMpBuyerSellerChatForParentOrder\ViewModel\ChatConfig</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
