        <container name="customer_default_billing_address_wrapper">
            <component name="customer_default_billing_address_content"
                       component="Branch8_MaskCustomerInformation/js/address/secure-customer-address"
                       template="Branch8_MaskCustomerInformation/default-address">

            </component>
        </container>
        <container name="customer_default_shipping_address_wrapper" template="Magento_Customer/default-address-wrapper">
