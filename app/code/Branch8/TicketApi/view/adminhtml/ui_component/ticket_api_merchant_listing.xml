<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">ticket_api_merchant_listing.ticket_api_merchant_listing_data_source</item>
            <item name="deps" xsi:type="string">ticket_api_merchant_listing.ticket_api_merchant_listing_data_source</item>
        </item>
        <item name="spinner" xsi:type="string">ticket_api_merchant_listing_columns</item>
    </argument>
    <settings>
        <buttons>
            <button name="add">
                <url path="*/merchant/create"/>
                <class>primary</class>
                <label translate="true">Add New Merchant</label>
                <aclResource>Branch8_TicketApi::merchant_create</aclResource>
            </button>
        </buttons>
        <spinner>ticket_api_merchant_listing_columns</spinner>
        <deps>
            <dep>ticket_api_merchant_listing.ticket_api_merchant_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="ticket_api_merchant_listing_data_source">
        <argument name="dataProvider" xsi:type="configurableObject">
            <argument name="class" xsi:type="string">Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider</argument>
            <argument name="name" xsi:type="string">ticket_api_merchant_listing_data_source</argument>
            <argument name="primaryFieldName" xsi:type="string">entity_id</argument>
            <argument name="requestFieldName" xsi:type="string">id</argument>
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="component" xsi:type="string">Magento_Ui/js/grid/provider</item>
                    <item name="update_url" xsi:type="url" path="mui/index/render"/>
                    <item name="storageConfig" xsi:type="array">
                        <item name="indexField" xsi:type="string">entity_id</item>
                    </item>
                </item>
            </argument>
        </argument>
    </dataSource>
    <listingToolbar name="listing_top">
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="ticket_api_merchant_listing_columns">
        <column name="entity_id">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="filter" xsi:type="string">textRange</item>
                    <item name="label" xsi:type="string" translate="true">ID</item>
                </item>
            </argument>
        </column>
        <column name="merchant_name">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="filter" xsi:type="string">text</item>
                    <item name="label" xsi:type="string" translate="true">Merchant Name</item>
                </item>
            </argument>
        </column>
        <column name="merchant_id">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="filter" xsi:type="string">text</item>
                    <item name="label" xsi:type="string" translate="true">Merchant ID</item>
                </item>
            </argument>
        </column>
        <column name="is_active">
            <argument name="data" xsi:type="array">
                <item name="options" xsi:type="object">Branch8\TicketApi\Model\TicketApiBrand\Source\IsActive</item>
                <item name="config" xsi:type="array">
                    <item name="filter" xsi:type="string">select</item>
                    <item name="component" xsi:type="string">Magento_Ui/js/grid/columns/select</item>
                    <item name="dataType" xsi:type="string">select</item>
                    <item name="label" xsi:type="string" translate="true">Active</item>
                </item>
            </argument>
        </column>
        <actionsColumn class="Branch8\TicketApi\Ui\Component\EditMerchant" name="edit">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="indexField" xsi:type="string">entity_id</item>
                    <item name="label" xsi:type="string" translate="true">Edit</item>
                </item>
            </argument>
        </actionsColumn>
        <actionsColumn class="Branch8\TicketApi\Ui\Component\DeleteMerchant" name="delete">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="indexField" xsi:type="string">entity_id</item>
                    <item name="label" xsi:type="string" translate="true">Delete</item>
                </item>
            </argument>
        </actionsColumn>
    </columns>
</listing>