                </select>
            </formElements>
        </field> -->
        <field name="seller_ids" formElement="multiselect">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">ticket_api_merchant</item>
                </item>
            </argument>
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <dataType>text</dataType>
                <label translate="true">Seller</label>
                <dataScope>seller_ids</dataScope>
            </settings>
            <formElements>
                <multiselect>
                    <settings>
                        <options class="Branch8\TicketApi\Model\TicketApiMerchant\SellerOptions"/>
                    </settings>
                </multiselect>
            </formElements>
        </field>
        <field name="whitelist">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="string">Whitelist</item>
                    <item name="visible" xsi:type="boolean">true</item>
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="formElement" xsi:type="string">input</item>
                    <item name="source" xsi:type="string">ticket_api_merchant_edit</item>
                </item>
            </argument>
            <settings>
                <tooltip>
                    <description>example: 127.0.0.1,127.0.0.2,127.0.0.3</description>
                </tooltip>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="brand_permission">
            <argument name="data" xsi:type="array">
                <item name="options" xsi:type="object">Branch8\TicketApi\Model\TicketApiBrand\MultiSelectOptions</item>
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="string">Brand Permission</item>
                    <item name="visible" xsi:type="boolean">true</item>
                    <item name="dataType" xsi:type="string">int</item>
                    <item name="formElement" xsi:type="string">multiselect</item>
                    <item name="source" xsi:type="string">ticket_api_merchant_edit</item>
                </item>
            </argument>
        </field>
        <field name="merchant_id">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="string">Merchant ID</item>
                    <item name="visible" xsi:type="boolean">true</item>
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="formElement" xsi:type="string">input</item>
                    <item name="source" xsi:type="string">ticket_api_merchant_edit</item>
                </item>
            </argument>
            <settings>
                <disabled>true</disabled>
            </settings>
        </field>
        <field name="aes_key">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="string">AES Key</item>
                    <item name="visible" xsi:type="boolean">true</item>
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="formElement" xsi:type="string">input</item>
                    <item name="source" xsi:type="string">ticket_api_merchant_edit</item>
                </item>
            </argument>
            <settings>
                <disabled>true</disabled>
            </settings>
        </field>
        <field name="aes_iv">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="string">AES IV</item>
                    <item name="visible" xsi:type="boolean">true</item>
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="formElement" xsi:type="string">input</item>
                    <item name="source" xsi:type="string">ticket_api_merchant_edit</item>
                </item>
            </argument>
            <settings>
                <disabled>true</disabled>
            </settings>
        </field>
    </fieldset>
</form>