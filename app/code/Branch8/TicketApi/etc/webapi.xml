<?xml version="1.0" ?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <route url="/V1/ticket-api/use" method="POST">
        <service class="Branch8\TicketApi\Api\NotifyUsedInterface" method="handle"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
    <route url="/V1/ticket-api/check" method="POST">
        <service class="Branch8\TicketApi\Api\CheckInterface" method="handle"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
    <route url="/V1/ticket-api/cancel" method="POST">
        <service class="Branch8\TicketApi\Api\NotifyCancelInterface" method="handle"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
</routes>