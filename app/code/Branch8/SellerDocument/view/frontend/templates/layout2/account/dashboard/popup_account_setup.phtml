<script>
    require(
        [
            'jquery',
            'Magento_Ui/js/modal/modal',
            'jquery/jquery.cookie'
        ],
        function($, modal) {
            var options = {
                type: 'popup',
                responsive: true,
                innerScroll: true,
                modalClass: 'seller-account-setup-popup',
                buttons: []
            };

            var popup = modal(options, $('#seller-popup-modal-main'));
            $("#setup-button").on('click',function(){
                $("#seller-popup-modal-main").modal("openModal");
            });

            $("#skip-button").on('click',function(){
                $("#seller-popup-modal-main").modal("closeModal");
            });

            $(document).ready(function () {
                var showPopup = '<?=$showPopup?>';
                if(showPopup) {
                    /* show popup */
                    setTimeout(function(){ $('#seller-popup-modal-main').modal('openModal'); }, 2500);
                }
            });
        }
    );
</script>
