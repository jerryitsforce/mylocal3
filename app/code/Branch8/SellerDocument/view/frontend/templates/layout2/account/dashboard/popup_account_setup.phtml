        <form id="upload-document-form" class="upload-document-form" action="/marketplace/seller/uploadDestructionDocuments" enctype="multipart/form-data" method="POST">
            <label for="files"><?=__('Personal data destruction affidavit')?> :</label>
            <input type="file" id="personal_data_destruction_affidavit" name="personal_data_destruction_affidavit" required accept="application/pdf, application/msword, .doc, .docx">
