                       <?php if ($resolutionType === \Branch8\Rma\Model\Rma\Resolution::RESOLUTION_TYPE_EXCHANGE): ?>checked<?php endif; ?>
                       aria-required="true">
                <label for="resolution_<?= \Branch8\Rma\Model\Rma\Resolution::RESOLUTION_TYPE_EXCHANGE ?>">
                    <span><?= __('Replace') ?></span>
                </label>
