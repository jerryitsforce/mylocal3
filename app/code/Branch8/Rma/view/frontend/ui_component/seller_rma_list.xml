<?xml version="1.0" encoding="UTF-8"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <listingToolbar name="listing_top">
        <filters name="listing_filters" component="Branch8_SalesOrderGrid/js/grid/filters/filters">
            <filterSelect
                name="sale_person_id"
                provider="${ $.parentName }"
                sortOrder="10"
                component="Magento_Ui/js/grid/filters/elements/ui-select"
                template="ui/grid/filters/elements/ui-select"
            >
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="showPath" xsi:type="boolean">false</item>
                        <item name="identityColumn" xsi:type="string">entity_id</item>
                        <item name="filterOptions" xsi:type="boolean">true</item>
                        <item name="searchOptions" xsi:type="boolean">true</item>
                        <item name="filterPlaceholder" xsi:type="string"  translate="true">Please enter Sale Person</item>
                        <item name="selectedPlaceholders" xsi:type="array">
                            <item name="defaultPlaceholder" xsi:type="string" translate="true">Please enter Sale Person</item>
                        </item>
                        <item name="emptyOptionsHtml" xsi:type="string" translate="true">Start typing to find Saleperson</item>
                        <item name="filterRateLimit" xsi:type="string" translate="true">1000</item>
                        <item name="filterRateLimitMethod" xsi:type="string" translate="true">notifyWhenChangesStop</item>
                        <item name="searchUrl" xsi:type="url" path="mprmasystem/rma/SearchSalePersonOptions" />
                        <item name="validationUrl" xsi:type="url" path="mprmasystem/rma/GetSalePersonsSelected"/>
                        <item name="levelsVisibility" xsi:type="number">1</item>
                    </item>
                </argument>
                <settings>
                    <options class="Branch8\AdvancedPermissions\Model\Options\Salesperson"/>
                    <caption translate="true">– Please Select Salesperson –</caption>
                    <label translate="true">Salesperson</label>
                    <dataScope>sale_person_id</dataScope>
                </settings>
            </filterSelect>
        </filters>
    </listingToolbar>
    <columns name="message_columns">
        <column name="id">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="filterPlaceholder" xsi:type="string" translate="true">Please enter RMA ID</item>
                    <item name="label" xsi:type="string" translate="true">[GRID]RMA Id</item>
                </item>
            </argument>
        </column>
        <column name="status">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="filterPlaceholder" xsi:type="string" translate="true">Please select RMA Status</item>
                    <item name="selectedPlaceholders" xsi:type="array">
                        <item name="defaultPlaceholder" xsi:type="string" translate="true">Please select RMA Status</item>
                    </item>
                </item>
            </argument>
            <settings>
                <filter>select</filter>
                <label translate="true">[GRID]Rma Status</label>
                <dataType>select</dataType>
            </settings>
        </column>
        <column name="order_status"  component="Magento_Ui/js/grid/columns/select">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="filterPlaceholder" xsi:type="string" translate="true">Select...</item>
                    <item name="selectedPlaceholders" xsi:type="array">
                        <item name="defaultPlaceholder" xsi:type="string" translate="true">Select...</item>
                    </item>
                </item>
            </argument>
            <settings>
                <filter>select</filter>
                <label translate="true">[GRID]Shipping Status</label>
                <dataType>select</dataType>
                <options class="Webkul\MpRmaSystem\Model\Rma\Source\OrderStatus"/>
            </settings>
        </column>
        <column name="created_date" class="Branch8\Rma\Ui\Component\Columns\CreatedAt">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="sorting" xsi:type="string">desc</item>
                    <item name="label" xsi:type="string" translate="true">Created At</item>
                    <item name="sortOrder" xsi:type="number">1</item>
                </item>
            </argument>
        </column>
        <column name="resolution_type"  component="Magento_Ui/js/grid/columns/select">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="filterPlaceholder" xsi:type="string" translate="true">Please select resolution type</item>
                    <item name="selectedPlaceholders" xsi:type="array">
                        <item name="defaultPlaceholder" xsi:type="string" translate="true">Please select resolution type</item>
                    </item>
                </item>
            </argument>
            <settings>
                <filter>select</filter>
                <options class="Branch8\Rma\Ui\Component\Listing\Column\ResolutionType\Options"/>
                <label translate="true">[GRID]Resolution Type</label>
                <dataType>select</dataType>
            </settings>
        </column>
        <column name="order_ref">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="bodyTmpl" xsi:type="string">ui/grid/cells/html</item>
                    <item name="filterPlaceholder" xsi:type="string" translate="true">Please enter order ref</item>
                </item>
            </argument>
            <settings>
                <filter>text</filter>
                <!--  <options class="Branch8\RmaAdminUi\Ui\Component\Listing\Column\ResolutionType\Options"/>-->
                <label translate="true">[GRID]Order ref</label>
            </settings>
        </column>
        <column name="customer_name">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="filterPlaceholder" xsi:type="string" translate="true">Please enter Customer Name</item>
                </item>
            </argument>
            <settings>
                <filter>text</filter>
                <label translate="true">[GRID]Customer Name</label>
            </settings>
        </column>
        <column name="product_name">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="filterPlaceholder" xsi:type="string" translate="true">Please enter Product Name</item>
                </item>
            </argument>
            <settings>
                <filter>text</filter>
                <label translate="true">[GRID]Product Name</label>
            </settings>
        </column>
        <column name="product_sku">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="filterPlaceholder" xsi:type="string" translate="true">Please enter Product SKU</item>
                </item>
            </argument>
            <settings>
                <filter>text</filter>
                <label translate="true">[GRID]Product Sku</label>
            </settings>
        </column>
        <column name="supplier_sku">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="filterPlaceholder" xsi:type="string" translate="true">Please enter Supplier SKU</item>
                </item>
            </argument>
            <settings>
                <filter>text</filter>
                <label translate="true">[GRID]Supplier Sku</label>
            </settings>
        </column>
        <column name="salesperson" class="RmaSalespersonSelect">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="filterPlaceholder" xsi:type="string" translate="true">Please enter Sale Person</item>
                </item>
            </argument>
            <settings>
                <filter/>
                <dataType>select</dataType>
                <label translate="true">Salesperson</label>
                <visible>false</visible>
                <options class="Branch8\AdvancedPermissions\Model\Options\Salesperson"/>
            </settings>
        </column>
        <column name="rma_phone">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="filterPlaceholder" xsi:type="string" translate="true">Please enter Phone Number</item>
                </item>
            </argument>
            <settings>
                <filter>text</filter>
                <dataType>text</dataType>
                <label translate="true">[GRID]Phone Number</label>
                <visible>false</visible>
            </settings>
        </column>
        <column name="order_created_at" class="Magento\Ui\Component\Listing\Columns\Date"
                component="Magento_Ui/js/grid/columns/date">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="filterPlaceholder" xsi:type="string" translate="true">Please enter the order purchase date</item>
                </item>
            </argument>
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">[GRID]Order Purchase Date</label>
            </settings>
        </column>
        <column name="shipping_method" class="OrderGridShippingMethodSelect">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="filterPlaceholder" xsi:type="string" translate="true">Please select shipping method</item>
                </item>
            </argument>
            <settings>
                <filter>select</filter>
                <options class="Branch8\AdvancedPermissions\Model\Options\ShippingMethod"/>
                <dataType>select</dataType>
                <label translate="true">Shipping Method</label>
                <visible>false</visible>
            </settings>
        </column>
        <column name="rma_order_status">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="filterSelectType" xsi:type="string">multiselect</item>
                    <item name="filterPlaceholder" xsi:type="string" translate="true">Select...</item>
                    <item name="selectedPlaceholders" xsi:type="array">
                        <item name="defaultPlaceholder" xsi:type="string" translate="true">Select...</item>
                    </item>
                </item>
            </argument>
            <settings>
                <filter>select</filter>
                <label translate="true">[GRID]Order Status</label>
                <dataType>select</dataType>
                <options class="Branch8\RmaAdminUi\Ui\Component\Listing\Column\RmaOrderStatus\Options"/>
            </settings>
        </column>
    </columns>
</listing>
