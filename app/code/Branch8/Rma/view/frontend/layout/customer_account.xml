<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="customer_account_navigation">
            <block class="Magento\Customer\Block\Account\SortLinkInterface"
                   name="customer-account-navigation-parent-orders-link">
                <arguments>
                    <argument name="path" xsi:type="string">sales/parentOrder/history</argument>
                    <argument name="label" xsi:type="string" translate="true">Order Management</argument>
                    <argument name="sortOrder" xsi:type="number">220</argument>
                </arguments>
            </block>
        </referenceBlock>
        <referenceBlock name="mprmasystem-customer-rma" remove="true"/>
    </body>
</page>
