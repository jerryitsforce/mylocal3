<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="quote_item">
        <column xsi:type="int" name="seller_id" unsigned="true" nullable="true" comment="Seller Id"/>
        <column xsi:type="varchar" name="seller_code" length="255" nullable="true" comment="Seller Code"/>
        <column xsi:type="varchar" name="seller_company_name" length="255" nullable="true" comment="Seller Company Name"/>
        <column xsi:type="decimal" name="origin_cost" scale="4" precision="20" unsigned="false" nullable="true"
                comment="Product Origin Cost"/>
    </table>
    <table name="sales_order_item">
        <column xsi:type="int" name="seller_id" unsigned="true" nullable="true" comment="Seller Id"/>
        <column xsi:type="varchar" name="seller_code" length="255" nullable="true" comment="Seller Code"/>
        <column xsi:type="varchar" name="seller_company_name" length="255" nullable="true" comment="Seller Company Name"/>
        <column xsi:type="varchar" name="origin_sku" length="255" nullable="true" comment="Origin Sku"/>
        <column xsi:type="decimal" name="origin_cost" scale="4" precision="20" unsigned="false" nullable="true"
                comment="Product Origin Cost"/>
        <column xsi:type="decimal" name="variation_price" scale="4" precision="20" unsigned="false" nullable="true"
                comment="Product Variation Price"/>
    </table>
</schema>
