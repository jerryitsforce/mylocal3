<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd" extends="pagebuilder_products_form">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">pagebuilder_point_products_grid_form.pagebuilder_point_products_grid_form_data_source</item>
        </item>
    </argument>
    <settings>
        <deps>
            <dep>pagebuilder_point_products_grid_form.pagebuilder_point_products_grid_form_data_source</dep>
        </deps>
        <namespace>pagebuilder_point_products_grid_form</namespace>
    </settings>
    <dataSource name="pagebuilder_point_products_grid_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_PageBuilder/js/content-type/products/form/provider</item>
            </item>
        </argument>
        <dataProvider name="pagebuilder_point_products_grid_form_data_source" class="Magento\PageBuilder\Model\ContentType\DataProvider">
            <settings>
                <requestFieldName/>
                <primaryFieldName/>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="appearance_fieldset" sortOrder="10" component="Magento_PageBuilder/js/form/element/dependent-fieldset">
        <field name="appearance" formElement="select" sortOrder="10" component="Magento_PageBuilder/js/form/element/dependent-visual-select">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="default" xsi:type="string">point_grid</item>
                </item>
            </argument>
        </field>
        <htmlContent name="conditions_form" sortOrder="30" template="Magento_PageBuilder/form/element/widget-conditions">
            <block name="conditions_form" class="Magento\PageBuilder\Block\Adminhtml\Form\Element\ProductConditions">
                <arguments>
                    <argument name="formNamespace" xsi:type="string">pagebuilder_point_products_grid_form</argument>
                    <argument name="attribute" xsi:type="string">condition_source</argument>
                    <argument name="label" xsi:type="string" translate="true">Condition</argument>
                </arguments>
            </block>
        </htmlContent>
        <container name="product_count_group" component="Magento_Ui/js/form/components/group" sortOrder="80">
            <field name="products_count" sortOrder="20" formElement="input">
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="componentDisabled" xsi:type="boolean">true</item>
                    </item>
                </argument>
            </field>
            <field name="grid_products_count" sortOrder="10" formElement="input">
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="default" xsi:type="number">20</item>
                    </item>
                </argument>
                <settings>
                    <dataType>number</dataType>
                    <label translate="true">Number of Products per Column (3 columns)</label>
                    <additionalClasses>
                        <class name="admin__field-small">true</class>
                    </additionalClasses>
                    <dataScope>grid_products_count</dataScope>
                    <validation>
                        <rule name="required-entry" xsi:type="boolean">true</rule>
                        <rule name="validate-number" xsi:type="boolean">true</rule>
                        <rule name="less-than-equals-to" xsi:type="number">999</rule>
                        <rule name="greater-than-equals-to" xsi:type="number">1</rule>
                    </validation>
                </settings>
            </field>
        </container>
        <field name="title" sortOrder="20" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Title</label>
                <dataScope>title</dataScope>
                <notice translate="true">Point Range are defined in System > Configuration > Hotai Point (Page Builder)</notice>
                <elementTmpl>Magento_PageBuilder/form/element/input-no-maxlength</elementTmpl>
            </settings>
        </field>
        <field name="sub_title" sortOrder="21" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Sub-Title</label>
                <dataScope>sub_title</dataScope>
                <notice translate="true">Input [user_point] to fill user point</notice>
                <elementTmpl>Magento_PageBuilder/form/element/input-no-maxlength</elementTmpl>
            </settings>
        </field>
    </fieldset>
    <fieldset name="ga4_settings" sortOrder="20">
        <argument name="data" xsi:type="array">
            <item name="config" xsi:type="array">
                <item name="visible" xsi:type="boolean">false</item>
            </item>
        </argument>
    </fieldset>
</form>
