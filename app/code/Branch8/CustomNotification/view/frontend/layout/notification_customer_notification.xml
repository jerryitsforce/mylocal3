<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <title>My Notification</title>
    </head>
    <update handle="customer_account"/>
    <body>
        <referenceBlock name="page.main.title">
            <action method="setPageTitle">
                <argument translate="true" name="title" xsi:type="string">My Notification</argument>
            </action>
        </referenceBlock>
        <referenceContainer name="content">
            <block class="Branch8\CustomNotification\Block\Notification" name="notification_custom" cacheable="false"
                   template="Branch8_CustomNotification::customer/notificationTab.phtml">
            </block>
        </referenceContainer>
    </body>
</page>
