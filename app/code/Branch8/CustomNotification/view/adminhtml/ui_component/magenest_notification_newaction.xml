        <field name="customer_levels"
               component="Branch8_CustomNotification/js/form/element/customerLevels"
               class="Branch8\CustomNotification\Ui\Component\Form\Element\DataType\CustomerLevel"
               formElement="multiselect"
        >
            <argument name="data" xsi:type="array">
                <item name="options" xsi:type="object">Branch8\CustomNotification\Ui\Component\Notification\Levels</item>
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="string" translate="true">Customer Levels</item>
                    <item name="componentType" xsi:type="string">field</item>
                    <item name="dataType" xsi:type="string">string</item>
                    <item name="sortOrder" xsi:type="number">61</item>
                    <item name="required" xsi:type="boolean">true</item>
                    <item name="template" xsi:type="string">Branch8_CustomNotification/form/element/uploader/customerLevel</item>
                    <item name="listens" xsi:type="array">
                        <item name="${ $.provider }:data.notification_type" xsi:type="string">notifiTypeChange</item>
                    </item>
                </item>
            </argument>
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="oneid_uploader"
               component="Branch8_CustomNotification/js/form/element/oneIdUploader"
               formElement="fileUploader"
               class="Branch8\CustomNotification\Ui\Component\Form\Element\DataType\OneIdUploader"
        >
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="template" xsi:type="string">Branch8_CustomNotification/form/element/uploader/uploader</item>
                    <item name="elementTmpl" xsi:type="string">ui/form/element/uploader/image</item>
                    <item name="sortOrder" xsi:type="number">62</item>
                    <item name="notice" xsi:type="string" translate="true"><![CDATA[Only csv,xls,xlsx allows]]></item>
                    <item name="listens" xsi:type="array">
                        <item name="${ $.provider }:data.customer_levels" xsi:type="string">customerLevelChange</item>
                    </item>

                </item>
            </argument>
            <settings>
                <label translate="true">OneId Upload</label>
            </settings>
            <formElements>
                <fileUploader>
                    <settings>
                        <maxFileSize>10485760</maxFileSize>
                        <previewTmpl>ui/form/element/uploader/preview</previewTmpl>
                        <placeholderType>document</placeholderType>
                        <allowedExtensions>csv xls xlsx</allowedExtensions>
                        <uploaderConfig>
                            <param xsi:type="string" name="url">notibox/ajax/UploadOneIdList</param>
                        </uploaderConfig>
                    </settings>
                </fileUploader>
            </formElements>
        </field>
