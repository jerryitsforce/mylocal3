<?xml version="1.0" ?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
	<system>
		<section id="branch8_debug" translate="label" sortOrder="130" showInDefault="1" showInWebsite="1" showInStore="1">
			<class>separator-top</class>
			<label>Debug Log</label>
			<tab>branch8</tab>
			<resource>Branch8_HotaiCore::debug_log</resource>
			<group id="b8_ctbc" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="0" showInStore="0">
