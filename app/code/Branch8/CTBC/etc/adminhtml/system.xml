					<source_model>Branch8\CTBC\Model\Config\Source\LogClass</source_model>
					<can_be_empty>1</can_be_empty>
				</field>
			</group>
		</section>

		<tab id="branch8" translate="label" sortOrder="500">
            <label>Branch8</label>
        </tab>
