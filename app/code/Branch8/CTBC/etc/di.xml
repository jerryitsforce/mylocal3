<?xml version="1.0" ?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
	<!-- Logger -->
	<virtualType name="Branch8\CTBC\Logger\Logger">
        <arguments>
            <argument name="name" xsi:type="string">CTBC</argument>
            <argument name="handlers"  xsi:type="array">
                <item name="system" xsi:type="object">Branch8\CTBC\Logger\Handler</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="Branch8\CTBC\Logger\Handler">
        <arguments>
            <argument name="filesystem" xsi:type="object">Magento\Framework\Filesystem\Driver\File</argument>
        </arguments>
    </virtualType>
    <!-- CTBC_OrderStatus_Command -->
    <virtualType name="Magento\Framework\Console\CommandList">
		<arguments>
			<argument name="commands" xsi:type="array">
				<item name="CTBCOrderStatusConsole" xsi:type="object">Branch8\CTBC\Console\Command\OrderStatus</item>
			</argument>
		</arguments>
	</virtualType>
</config>
