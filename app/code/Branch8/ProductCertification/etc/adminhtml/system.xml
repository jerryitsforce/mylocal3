<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="branch8" translate="label" sortOrder="300">
            <label>BRANCH8</label>
        </tab>
        <section id="branch8_product_certification" translate="label" sortOrder="100" showInDefault="1"
                 showInWebsite="1" showInStore="1">
            <label>Product Certification Configuration</label>
            <tab>branch8</tab>
            <resource>Branch8_ProductCertification::config</resource>
            <group id="general" translate="label" type="text" sortOrder="10" showInDefault="1"
                   showInWebsite="1" showInStore="1">
                <label>General</label>
                <field id="enabled" translate="label comment" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Product Certification Feature</label>
                    <comment>When disabled, the 'Product Certification' section will not appear on product edit pages or the frontend.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
            </group>
        </section>
    </system>
</config>
