<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="customer_nav_top">
            <block ifconfig="gift_order/general/is_active" class="Branch8\Customer\Block\Account\Link" name="customer-nav-top-gift-box-form" template="Branch8_Customer::account/link.phtml" after="customer-nav-top-notification">
                <arguments>
                    <argument name="path" xsi:type="string">gift-order/giftbox/listing</argument>
                    <argument name="label" xsi:type="string" translate="true">禮物盒</argument>
                    <argument name="css_class" xsi:type="string">giftbox</argument>
                    <argument name="sortOrder" xsi:type="number">200</argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>
