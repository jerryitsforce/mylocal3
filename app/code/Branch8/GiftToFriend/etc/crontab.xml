<?xml version="1.0" ?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
	<group id="sales">
		<!-- minute(0-59) hour(0-23) dayOfMonth(1-31) month(1-12) dayOfWeek(0-7, sunday=0or7) -->
		<job name="sales_status_gift_order_cancel_not_confirmed" instance="Branch8\GiftToFriend\Cron\CancelNotConfirmedOrders" method="execute">
			<schedule>*/30 * * * *</schedule>
		</job>
		<job name="gift_order_update_customer_id" instance="Branch8\GiftToFriend\Cron\UpdateCustomerId" method="execute">
			<schedule>*/30 * * * *</schedule>
		</job>
	</group>
</config>