<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd" extends="pagebuilder_base_form">
    <fieldset name="ga4_settings" sortOrder="80">
        <settings>
            <label translate="true">Google Analytics 4</label>
            <collapsible>true</collapsible>
            <opened>true</opened>
        </settings>
        <field name="promotion_id" sortOrder="40" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Promotion ID</label>
                <dataScope>promotion_id</dataScope>
            </settings>
        </field>
        <field name="promotion_name" sortOrder="50" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Promotion Name</label>
                <dataScope>promotion_name</dataScope>
            </settings>
        </field>
        <field name="item_list_id" sortOrder="60" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Item List ID</label>
                <dataScope>item_list_id</dataScope>
            </settings>
        </field>
        <field name="item_list_name" sortOrder="70" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Item List Name</label>
                <dataScope>item_list_name</dataScope>
            </settings>
        </field>
    </fieldset>
    <fieldset name="appearance_fieldset" sortOrder="10" component="Magento_PageBuilder/js/form/element/dependent-fieldset">
        <field name="in_page" sortOrder="60" formElement="checkbox">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="default" xsi:type="string">0</item>
                </item>
            </argument>
            <settings>
                <dataType>boolean</dataType>
                <label translate="true">Load In Page</label>
                <dataScope>in_page</dataScope>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="string">0</map>
                            <map name="true" xsi:type="string">1</map>
                        </valueMap>
                        <prefer>toggle</prefer>
                    </settings>
                </checkbox>
            </formElements>
        </field>
    </fieldset>
</form>
