<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd" extends="pagebuilder_products_form">
    <fieldset name="settings">
        <field name="slidetoshow_desktop" sortOrder="70" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Number of slide to show (Desktop)</label>
                <additionalClasses>
                    <class name="admin__field-small">true</class>
                </additionalClasses>
                <dataScope>slidetoshow_desktop</dataScope>
            </settings>
        </field>
        <field name="slidetoshow_tablet" sortOrder="80" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Number of slide to show (Tablet)</label>
                <additionalClasses>
                    <class name="admin__field-small">true</class>
                </additionalClasses>
                <dataScope>slidetoshow_tablet</dataScope>
            </settings>
        </field>
        <field name="slidetoshow_mobile" sortOrder="90" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Number of slide to show (Mobile)</label>
                <additionalClasses>
                    <class name="admin__field-small">true</class>
                </additionalClasses>
                <dataScope>slidetoshow_mobile</dataScope>
            </settings>
        </field>
    </fieldset>
    <fieldset name="appearance_fieldset" sortOrder="10" component="Magento_PageBuilder/js/form/element/dependent-fieldset">
        <field name="in_page" sortOrder="60" formElement="checkbox">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="default" xsi:type="string">0</item>
                </item>
            </argument>
            <settings>
                <dataType>boolean</dataType>
                <label translate="true">Load In Page</label>
                <dataScope>in_page</dataScope>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="string">0</map>
                            <map name="true" xsi:type="string">1</map>
                        </valueMap>
                        <prefer>toggle</prefer>
                    </settings>
                </checkbox>
            </formElements>
        </field>
    </fieldset>
</form>
