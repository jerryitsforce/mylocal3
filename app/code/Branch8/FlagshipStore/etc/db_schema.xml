<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="flagship_store" resource="default" engine="innodb">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true"/>
        <column xsi:type="varchar" name="store_name" nullable="false"/>
        <column xsi:type="int" name="category_id" nullable="false" />
        <column xsi:type="int" name="main_seller" nullable="false" />
        <column xsi:type="int" name="is_active" nullable="false" default="0"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" />
        <column xsi:type="timestamp" name="updated_at" nullable="false" />
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id" />
        </constraint>
        <index referenceId="FLAGSHIP_STORE_CATEGORY_ID" indexType="btree">
            <column name="category_id"/>
        </index>
        <index referenceId="FLAGSHIP_STORE_MAIN_SELLER" indexType="btree">
            <column name="main_seller"/>
        </index>
    </table>
    <table name="flagship_store_seller" resource="default" engine="innodb">
        <column xsi:type="int" name="item_id" unsigned="true" nullable="false" identity="true"/>
        <column xsi:type="int" name="flagship_store_id" nullable="false"/>
        <column xsi:type="int" name="seller_id" nullable="false" />
        <column xsi:type="timestamp" name="created_at" nullable="false" />
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="item_id" />
        </constraint>
        <index referenceId="FLAGSHIP_STORE_SELLER_STORE_ID" indexType="btree">
            <column name="flagship_store_id"/>
        </index>
        <index referenceId="FLAGSHIP_STORE_SELLER_SELLER_ID" indexType="btree">
            <column name="seller_id"/>
        </index>
        <constraint xsi:type="unique" referenceId="FLAGSHIP_STORE_SELLER_STORE_ID_SELLER_ID">
            <column name="flagship_store_id"/>
            <column name="seller_id"/>
        </constraint>
    </table>
    <table name="sales_order">
        <column xsi:type="varchar" name="is_flagship_store_process_order" nullable="true"/>
        <index referenceId="SALES_ORDER_IS_FLAGHIP_STORE_PROCESS_ORDER" indexType="btree">
            <column name="is_flagship_store_process_order"/>
        </index>
    </table>
    <table name="sales_order_grid">
        <column xsi:type="varchar" name="is_flagship_store_process_order" nullable="true"/>
        <index referenceId="SALES_ORDER_GRID_IS_FLAGHIP_STORE_PROCESS_ORDER" indexType="btree">
            <column name="is_flagship_store_process_order"/>
        </index>
    </table>

</schema>