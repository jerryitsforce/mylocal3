<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="seller.main">
            <block name="core_config_model_layout2" class="Branch8\WebkulMpBuyerSellerChat\Block\CoreConfigModel"
                   template="Branch8_WebkulMpBuyerSellerChatSellerUi::core_model.phtml" >
            </block>
            <block class="Branch8\WebkulMpBuyerSellerChatSellerUi\Block\Seller\ActiveModel"
                   name="active_customer_model_layout2"
                   template="Branch8_WebkulMpBuyerSellerChatSellerUi::account/active_model.phtml" cacheable="false">
                <arguments>
                    <argument name="jsLayout" xsi:type="array">
                        <item name="components" xsi:type="array">
                            <item name="active-users" xsi:type="array">
                                <item name="component" xsi:type="string">Branch8_WebkulMpBuyerSellerChatSellerUi/js/view/active-model</item>
                                <item name="config" xsi:type="array">
                                    <item name="defaultCustomerSellerList" xsi:type="helper" helper="Branch8\WebkulMpBuyerSellerChatSellerUi\ViewModel\SellerConfig::getCustomerSellerChatData"/>
                                    <item name="chatProfile" xsi:type="helper" helper="Branch8\WebkulMpBuyerSellerChatSellerUi\ViewModel\SellerConfig::getSellerChatProfile"/>
                                    <item name="generalConfig" xsi:type="helper" helper="Branch8\WebkulMpBuyerSellerChatSellerUi\ViewModel\SellerConfig::getGeneralConfig"/>
                                </item>
                                <item name="children" xsi:type="array">
                                    <item name="change-profile-image" xsi:type="array">
                                        <item name="component" xsi:type="string">Branch8_WebkulMpBuyerSellerChat/js/view/changProfileImage</item>
                                        <item name="config" xsi:type="array">
                                            <item name="isMultipleFiles" xsi:type="boolean">false</item>
                                            <item name="maxFileSize" xsi:type="string">2097152</item>
                                            <item name="allowedExtensions" xsi:type="string">jpg jpeg gif png</item>
                                            <item name="template" xsi:type="string">Branch8_WebkulMpBuyerSellerChat/view/changProfileImage/form/element/image</item>
                                            <item name="previewTmpl" xsi:type="string">Branch8_WebkulMpBuyerSellerChat/view/changProfileImage/form/element/attachment-preview</item>
                                            <item name="elementTmpl" xsi:type="string">Branch8_WebkulMpBuyerSellerChat/view/changProfileImage/form/element/image</item>
                                            <item name="uploaderConfig" xsi:type="helper" helper="Branch8\WebkulMpBuyerSellerChat\ViewModel\CoreConfig::getChangProfileUploadConfig"/>
                                        </item>
                                        <item name="dataScope" xsi:type="string">changeProfileImage</item>
                                        <item name="displayArea" xsi:type="string">changeProfileImage</item>
                                    </item>
                                </item>
                            </item>
                        </item>
                    </argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
