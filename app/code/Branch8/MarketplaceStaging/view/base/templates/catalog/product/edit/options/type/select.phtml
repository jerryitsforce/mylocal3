                <?php endif; ?>
                <td class="col-sku">
                    <input name="product[options][<%- data.id %>][values][<%- data.select_id %>][sku]" data-store-label="<%- data.sku %>"
                    <% if (typeof data.is_bought != 'undefined' && data.is_bought == 1) { %> disabled="disabled" <% } %>
                    class="input-text<?php if(!$hideCustomOptions): ?> required-entry<?php endif; ?> sku-unique" type="text" value="<%- data.sku %>">
                </td>
                <td class="col-visible">
                    <input name="product[options][<%- data.id %>][values][<%- data.select_id %>][is_bought]" data-store-label="<%- data.is_bought %>"
