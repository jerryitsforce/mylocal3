                <?php if ($block->getCanReadPrice() !== false) : ?>
                    <th class="col-price col-hide required"><?php /* @escapeNotVerified */ echo __('Price') ?></th>
                    <th class="col-price-type col-hide"><?php /* @escapeNotVerified */ echo __('Price Type') ?></th>
                <?php endif; ?>
                <th class="col-sku<?php if(!$hideCustomOptions): ?> required<?php endif; ?>"><?php /* @escapeNotVerified */ echo __('SKU') ?><?php if(!$hideCustomOptions): ?><span class="required">*</span><?php endif; ?></th>
                <th class="col-visible"><?php /* @escapeNotVerified */ echo __('Is Visible') ?></th>
                <th class="col-actions">&nbsp;</th>
