            </tr>
            <tr>
                <td colspan="6" class="note">
                    <p class="nm"><?php /* @escapeNotVerified */ echo __('Please set the specification price in Management Specifications (Variation SKU).') ?></p>
                </td>
            </tr>
            </tfoot>
        </table>
    </div>
