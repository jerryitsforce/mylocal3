                    <input name="product[options][<%- data.id %>][values][<%- data.select_id %>][is_visible]" data-store-label="<%- data.is_visible %>"
                    <% if (typeof data.is_visible != 'undefined' && data.is_visible == 1) { %> checked="checked" <% } %>
                    class="input-text" type="checkbox" value="1">
                </td>
                <td class="col-actions col-delete">
                    <% if (typeof data.is_bought != 'undefined' && data.is_bought != 1) { %>
