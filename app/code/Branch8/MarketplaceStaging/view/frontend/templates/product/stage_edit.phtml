                                if (!empty($categories)) {
                                    foreach ($categories as $category) {
                                        ?>
                                        <option value="<?= $category['value'];?>"<?php echo ($productColl->getMainCategory() == $category['value']) ? ' selected' : '' ?>><?php echo $block->escapeHtml($category['label']) ?></option>
                                        <?php
                                    }
                                }
                            endif;
                            ?>
                        </select>
                    <?php else: ?>
