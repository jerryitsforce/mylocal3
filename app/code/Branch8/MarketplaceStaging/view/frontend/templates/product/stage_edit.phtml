                            ->escapeHtmlAttr($attribute->getAttributeCode()) ?>]"
                               id="staging_<?= $block->escapeHtmlAttr($attribute->getAttributeCode()) ?>"
                               value="<?= $block->escapeHtml($productColl[$attribute->getAttributeCode()]) ?>"/>
                    <?php endif; ?>
                    <?= $hint ?>
                </div>
            </div>
