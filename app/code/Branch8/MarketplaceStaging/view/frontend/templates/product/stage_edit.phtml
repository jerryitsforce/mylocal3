                    <?php elseif ($attribute->getFrontendInput() == 'multiselect'): ?>
                        <?php $values = $productColl[$attribute->getAttributeCode()];
                        if ($values && is_string($values)) {
                            $values = explode(',', $values);
                        } elseif (!is_array($values)) {
                            $values = [$values];
                        } ?>
                        <select name="product[<?= $block->escapeHtmlAttr($attribute->getAttributeCode()) ?>][]"
                                id="staging_<?= $block->escapeHtmlAttr($attribute->getAttributeCode()) ?>"
                                title="<?= $block->escapeHtmlAttr($attribute->getStoreLabel()) ?>"
                                class="multiselect<?php if ($attribute->getIsRequired()): ?> required-entry<?php endif; ?>" multiple="multiple">
                            <?php
                            $options = $attribute->getSource()->getAllOptions();
                            $shippingMethodsArr = [];
                            $shippingMethodToCompare = [];
                            if($attribute->getAttributeCode() == 'shipping_method'){
                                //limit method by seller setting
                                $shippingMethods = $sellerSetting->getShippingMethods();
                                $shippingMethodsArr = explode(',', $shippingMethods);
                                $mappingMethods = $hotaiShippingHelper->mappingMethod();

                                foreach ($mappingMethods as $methodCode => $_mapMethod){
                                    if(in_array($_mapMethod, $shippingMethodsArr)){
                                        $shippingMethodToCompare[] = $methodCode;
                                    }
                                }
                            }
                            foreach ($options as $option):
                                if($attribute->getAttributeCode() == 'shipping_method' && (!isset($option['value'][0]['value']) || !in_array($option['value'][0]['value'], $shippingMethodToCompare))){
                                    continue;
                                }
                                ?>
                                <?php
                                if(!is_array($option['value'])){
                                    if ($option['value'] == '') {
                                        continue;
                                    }
                                    ?>
                                    <option value="<?= $block->escapeHtml($option['value']) ?>"
                                        <?php if (in_array($option['value'], $values)) {
                                            echo 'selected="selected"';
                                        } ?>>
                                        <?= $block->escapeHtml($option['label']) ?></option>
                                <?php } else{?>
                                    <optgroup label="<?php echo $block->escapeHtml($option['label']);?>"></optgroup>
                                    <?php
                                    foreach($option['value'] as $_option){
                                        if ($_option['value'] == '') {
                                            continue;
                                        }
                                        ?>
                                        <option value="<?= $block->escapeHtml($_option['value']) ?>"
                                            <?php if (in_array($_option['value'], $values)) {
                                                echo 'selected="selected"';
                                            } ?>>
                                            <?= $block->escapeHtml($_option['label']) ?></option>
                                        <?php
                                    }
                                    ?>
                                    <?php
                                }
                                ?>
                            <?php endforeach; ?>
                        </select>
                    <?php elseif($attribute->getAttributeCode() == 'main_category'):?>
