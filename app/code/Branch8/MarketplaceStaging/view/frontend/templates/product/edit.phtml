<script>
(function() {
    // 1. Force override browser scroll restoration iteratively just in case Magento routers reset it
    var enforceScrollRestoration = function() {
        if ('scrollRestoration' in history && history.scrollRestoration !== 'manual') {
            history.scrollRestoration = 'manual';
        }
    };
    enforceScrollRestoration();
    var scrollInterval = setInterval(enforceScrollRestoration, 500);

    // 2. Add flag on save intent (use mousedown to absolutely beat any jQuery preventDefault/stopImmediatePropagation)
    document.addEventListener('DOMContentLoaded', function() {
        var saveBtn = document.getElementById('save-btn');
        if (saveBtn) {
            saveBtn.addEventListener('mousedown', function() {
                sessionStorage.setItem('seller_product_saved_v3', '1');
            });
            // Also listen on purely form submission
            var form = document.getElementById('edit-product');
            if (form) {
                form.addEventListener('submit', function() {
                    sessionStorage.setItem('seller_product_saved_v3', '1');
                });
            }
        }
    });

    // 3. Centralized aggressive scroll-locker
    if (sessionStorage.getItem('seller_product_saved_v3')) {
        sessionStorage.removeItem('seller_product_saved_v3');
        var userScrolled = false;
        var startTime = Date.now();
        var lockDuration = 10000; // 10 FULL SECONDS: Outlasts even the slowest Knockout/AJAX responses

        // Listen for intent to abandon the lock
        var stopLock = function() { userScrolled = true; };
        window.addEventListener('wheel', stopLock, { passive: true });
        window.addEventListener('touchmove', stopLock, { passive: true });
        window.addEventListener('keydown', function(e) {
            // Space, PageUp, PageDown, End, Home, ArrowUp, ArrowDown
            if ([32, 33, 34, 35, 36, 38, 40].indexOf(e.keyCode) > -1) {
                userScrolled = true;
            }
        }, { passive: true });

        var lockScroll = function() {
            if (userScrolled || (Date.now() - startTime) > lockDuration) {
                clearInterval(scrollInterval); // Clean up memory and CPU usage
                window.removeEventListener('wheel', stopLock);
                window.removeEventListener('touchmove', stopLock);
                return; // Stop locking
            }
            if (window.scrollY > 0 || document.documentElement.scrollTop > 0) {
                window.scrollTo(0, 0);
            }
            requestAnimationFrame(lockScroll);
        };
        requestAnimationFrame(lockScroll);
    } else {
        // If not a saved reload, clear interval early
        setTimeout(function() { clearInterval(scrollInterval); }, 5000);
    }
})();

