<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="seller-2columns-left" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="seller.content">
            <referenceBlock name="marketplace_product_add">
                <arguments>
                    <argument name="view_helper" xsi:type="object">Branch8\MarketplaceStaging\Helper\Data</argument>
                </arguments>
                <action method="setTemplate">
                    <argument name="template" xsi:type="string">Branch8_MarketplaceStaging::product/add.phtml</argument>
                </action>
                <block class="Branch8\MarketplaceStaging\Block\CustomOption\Options" name="b8.custom.options.template.options" cacheable="false"/>
                <block class="Branch8\MarketplaceStaging\Block\CustomOption\Variation" name="managevariation" template="Branch8_MarketplaceStaging::catalog/product/edit/managevariation.phtml" cacheable="false"/>
            </referenceBlock>
        </referenceContainer>
        <referenceBlock name="marketplace_product_cart_limit" remove="true"/>
        <referenceBlock name="marketplace_product_add_downloadable_links" template="Branch8_MarketplaceStaging::product/webkul/edit/downloadable/links.phtml"/>
        <referenceBlock name="marketplace_product_add_downloadable_samples" template="Branch8_MarketplaceStaging::product/webkul/edit/downloadable/samples.phtml"/>
        <referenceBlock name="step1" template="Branch8_MarketplaceStaging::product/edit/attribute/steps/wk_select_attributes.phtml"/>
    </body>
</page>
