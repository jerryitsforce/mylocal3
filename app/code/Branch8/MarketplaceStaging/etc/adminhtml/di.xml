<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Webkul\Marketplace\Controller\Adminhtml\Product\Deny"
                type="Branch8\MarketplaceStaging\Controller\Adminhtml\Product\Deny"/>
    <virtualType name="productApproveUpdateSave" type="Magento\Staging\Model\Entity\Update\Save">
        <arguments>
            <argument name="entityName" xsi:type="string">Magento\Catalog\Api\Data\ProductInterface</argument>
        </arguments>
    </virtualType>
    <type name="Branch8\MarketplaceStaging\Model\Product\SaveProductStagingWithChanges">
        <arguments>
            <argument name="stagingUpdateSave" xsi:type="object">productApproveUpdateSave</argument>
        </arguments>
    </type>
    <virtualType name="productUpdateSaveSaveAction" type="Magento\Staging\Model\Entity\Update\Action\Save\SaveAction">
        <arguments>
            <argument name="entityHydrator" xsi:type="object">Branch8\MarketplaceStaging\Model\Product\HydratorHandle</argument>
        </arguments>
    </virtualType>
    <virtualType name="productUpdateSaveAssignAction" type="Magento\Staging\Model\Entity\Update\Action\Save\AssignAction">
        <arguments>
            <argument name="entityHydrator" xsi:type="object">Branch8\MarketplaceStaging\Model\Product\HydratorHandle</argument>
        </arguments>
    </virtualType>
    <virtualType name="Magento\Catalog\Ui\DataProvider\Product\Form\Modifier\Pool">
        <arguments>
            <argument name="modifiers" xsi:type="array">
                <item name="change_custom_option_component" xsi:type="array">
                    <item name="class" xsi:type="string">Branch8\MarketplaceStaging\Ui\DataProvider\Product\Form\Modifier\CustomOptionModifier</item>
                    <item name="sortOrder" xsi:type="number">1400</item>
                </item>
            </argument>
        </arguments>
    </virtualType>
</config>
