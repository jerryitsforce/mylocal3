<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Branch8\MarketplaceStaging\Block\Update\Upcoming">
        <arguments>
            <argument name="entityProvider" xsi:type="object">Branch8\MarketplaceStaging\Block\Update\Provider</argument>
        </arguments>
    </type>
    <virtualType name="marketplaceStagingUpcomingGridActions" type="Branch8\MarketplaceStaging\Ui\Component\Listing\Column\Entity\Actions">
        <arguments>
            <argument name="entityIdentifier" xsi:type="string">id</argument>
            <argument name="entityColumn" xsi:type="string">entity_id</argument>
            <argument name="jsModalProvider" xsi:type="string">marketplacestaging_upcoming_form.marketplacestaging_upcoming_form.marketplacestaging_update_form_modal</argument>
            <argument name="jsLoaderProvider" xsi:type="string">marketplacestaging_upcoming_form.marketplacestaging_upcoming_form.marketplacestaging_update_form_modal.update_form_loader</argument>
            <argument name="urlProviderInterface" xsi:type="object">Branch8\MarketplaceStaging\Ui\Component\Listing\Column\Product\UrlProvider</argument>
        </arguments>
    </virtualType>
    <type name="Branch8\MarketplaceStaging\Model\Product\Identifier\DataProvider">
        <plugin name="marketplaceStagingIdentifierDataProvider" type="Magento\Staging\Model\Entity\DataProvider\Identifier\DataProviderPlugin"/>
    </type>
    <virtualType name="stagingCatalogUpdateCancelButton" type="Magento\Staging\Block\Adminhtml\Update\Entity\CancelButton">
        <arguments>
            <argument name="jsUpdateModal" xsi:type="string">index=marketplacestaging_update_form_modal</argument>
        </arguments>
    </virtualType>
    <virtualType name="stagingCatalogUpdatePreviewButton" type="Magento\Staging\Block\Adminhtml\Update\Entity\PreviewButton">
        <arguments>
            <argument name="entityProvider" xsi:type="object">Branch8\MarketplaceStaging\Block\Adminhtml\Update\Provider</argument>
        </arguments>
    </virtualType>
    <virtualType name="Branch8\MarketplaceStaging\Ui\DataProvider\Product\Form\Modifier\System" type="Magento\Catalog\Ui\DataProvider\Product\Form\Modifier\System">
        <arguments>
            <argument name="productUrls" xsi:type="array">
                <item name="submit_url" xsi:type="string">marketplacestaging/product/save</item>
                <item name="reloadUrl" xsi:type="string">marketplacestaging/product/reload</item>
            </argument>
        </arguments>
    </virtualType>
    <type name="Branch8\MarketplaceStaging\Model\Product\Locator\StagingLocator">
        <arguments>
            <argument name="requestFieldName" xsi:type="string">id</argument>
        </arguments>
    </type>
    <preference for="Magento\Catalog\Model\Locator\LocatorInterface" type="Branch8\MarketplaceStaging\Model\Product\Locator\StagingLocator"/>
    <type name="Magento\Staging\Model\Entity\Update\Action\Pool">
        <arguments>
            <argument name="actions" xsi:type="array">
                <item name="Magento\Catalog\Api\Data\ProductInterface" xsi:type="array">
                    <item name="save" xsi:type="array">
                        <item name="save" xsi:type="string">productUpdateSaveSaveAction</item>
                        <item name="assign" xsi:type="string">productUpdateSaveAssignAction</item>
                    </item>
                    <item name="delete" xsi:type="array">
                        <item name="save" xsi:type="string">productUpdateDeleteSaveAction</item>
                        <item name="assign" xsi:type="string">productUpdateDeleteAssignAction</item>
                        <item name="remove" xsi:type="string">productUpdateDeleteRemoveAction</item>
                    </item>
                </item>
            </argument>
        </arguments>
    </type>

    <!-- Product save controller -->
    <virtualType name="productUpdateSaveSaveAction" type="Magento\Staging\Model\Entity\Update\Action\Save\SaveAction">
        <arguments>
            <argument name="entityHydrator" xsi:type="object">Branch8\MarketplaceStaging\Model\Product\Hydrator</argument>
        </arguments>
    </virtualType>
    <virtualType name="productUpdateSaveAssignAction" type="Magento\Staging\Model\Entity\Update\Action\Save\AssignAction">
        <arguments>
            <argument name="entityHydrator" xsi:type="object">Branch8\MarketplaceStaging\Model\Product\Hydrator</argument>
        </arguments>
    </virtualType>
    <virtualType name="productUpdateDeleteSaveAction" type="Magento\Staging\Model\Entity\Update\Action\Delete\SaveAction">
        <arguments>
            <argument name="entityRetriever" xsi:type="object">Branch8\MarketplaceStaging\Model\Product\Retriever</argument>
            <argument name="entityName" xsi:type="string">Magento\Catalog\Api\Data\ProductInterface</argument>
        </arguments>
    </virtualType>
    <virtualType name="productUpdateDeleteAssignAction" type="Magento\Staging\Model\Entity\Update\Action\Delete\AssignAction">
        <arguments>
            <argument name="entityRetriever" xsi:type="object">Branch8\MarketplaceStaging\Model\Product\Retriever</argument>
            <argument name="entityName" xsi:type="string">Magento\Catalog\Api\Data\ProductInterface</argument>
        </arguments>
    </virtualType>
    <virtualType name="productUpdateDeleteRemoveAction" type="Magento\Staging\Model\Entity\Update\Action\Delete\RemoveAction">
        <arguments>
            <argument name="entityRetriever" xsi:type="object">Branch8\MarketplaceStaging\Model\Product\Retriever</argument>
            <argument name="entityName" xsi:type="string">Magento\Catalog\Api\Data\ProductInterface</argument>
        </arguments>
    </virtualType>
    <virtualType name="productUpdateSave" type="Magento\Staging\Model\Entity\Update\Save">
        <arguments>
            <argument name="entityName" xsi:type="string">Magento\Catalog\Api\Data\ProductInterface</argument>
        </arguments>
    </virtualType>
    <type name="Branch8\MarketplaceStaging\Controller\Product\Save">
        <arguments>
            <argument name="stagingUpdateSave" xsi:type="object">productUpdateSave</argument>
        </arguments>
    </type>
    <type name="Magento\CatalogStaging\Model\Product\Locator\StagingLocator">
        <arguments>
            <argument name="requestFieldName" xsi:type="string">id</argument>
        </arguments>
    </type>

    <!-- Product delete controller -->
    <type name="Branch8\MarketplaceStaging\Controller\Product\Delete">
        <arguments>
            <argument name="stagingUpdateDelete" xsi:type="object">productUpdateDelete</argument>
        </arguments>
    </type>
    <virtualType name="productUpdateDelete" type="Magento\Staging\Model\Entity\Update\Delete">
        <arguments>
            <argument name="entityName" xsi:type="string">Magento\Catalog\Api\Data\ProductInterface</argument>
        </arguments>
    </virtualType>
    <preference for="Branch8\MarketplaceStaging\Model\Image\UploadResizeConfigInterface" type="Branch8\MarketplaceStaging\Model\Image\UploadResizeConfig" />
    <type name="Magento\CatalogInventory\Helper\Stock">
        <plugin name="Branch8_MarketplaceStaging::skipFilterStock" type="Branch8\MarketplaceStaging\Plugin\Magento\CatalogInventory\Helper\Stock" />
    </type>
    <type name="Webkul\Marketplace\Block\Order\View">
        <plugin name="Branch8_MarketplaceStaging::orderView" type="Branch8\MarketplaceStaging\Plugin\Webkul\Marketplace\Block\Order\View" />
    </type>
    <type name="Webkul\Marketplace\Helper\Orders">
        <plugin name="Branch8_MarketplaceStaging::helperOrders" type="Branch8\MarketplaceStaging\Plugin\Webkul\Marketplace\Helper\Orders" />
    </type>
    <type name="Magento\ConfigurableProduct\Model\ResourceModel\Attribute\OptionSelectBuilderInterface">
        <plugin name="option_select_website_filter" disabled="true"/>
        <plugin name="b8_option_select_website_filter" type="Branch8\MarketplaceStaging\Plugin\Magento\ConfigurableProduct\Model\ResourceModel\Attribute\ScopedOptionSelectBuilder"/>
    </type>
</config>
