<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="catalog_product_view_type_downloadable"/>
    <body>
        <referenceContainer name="product.info.main">
            <referenceBlock name="product.info.downloadable.samples" remove="true"/>
            <block class="Branch8\MarketplaceProduct\Block\Catalog\Product\Samples" name="branch8.product.info.downloadable.samples" template="Magento_Downloadable::catalog/product/samples.phtml" after="product.price.tier" />
        </referenceContainer>
        <referenceBlock name="product.info.options.wrapper">
            <referenceBlock name="product.info.downloadable.options" remove="true"/>
            <block class="Branch8\MarketplaceProduct\Block\Catalog\Product\Links" name="branch8.product.info.downloadable.options" before="-" template="Magento_Downloadable::catalog/product/links.phtml">
                <block class="Magento\Catalog\Pricing\Render" name="product.price.link" after="product.info.downloadable.options">
                    <arguments>
                        <argument name="price_render" xsi:type="string">product.price.render.default</argument>
                        <argument name="price_type_code" xsi:type="string">link_price</argument>
                    </arguments>
                </block>
            </block>
        </referenceBlock>
    </body>
</page>
