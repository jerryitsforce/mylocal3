<?xml version="1.0" encoding="UTF-8"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Ui/etc/ui_configuration.xsd"
    extends="marketplacectrl_products_list">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">marketplacectrl_manager_products_list.manager_product_approval_management_listing_data_source</item>
            <item name="deps" xsi:type="string">marketplacectrl_manager_products_list.manager_product_approval_management_listing_data_source</item>
        </item>
        <item name="spinner" xsi:type="string">marketplacectrl_products_columns</item>
    </argument>
    <dataSource name="manager_product_approval_management_listing_data_source">
        <argument name="dataProvider" xsi:type="configurableObject">
            <argument name="class" xsi:type="string">Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider</argument>
            <argument name="name" xsi:type="string">manager_product_approval_management_listing_data_source</argument>
            <argument name="primaryFieldName" xsi:type="string">entity_id</argument>
            <argument name="requestFieldName" xsi:type="string">id</argument>
            <argument name="addFilterStrategies" xsi:type="array">
                <item name="is_new_product" xsi:type="object">Branch8\MarketplaceProduct\Ui\DataProvider\IsNewProduct</item>
            </argument>
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="component" xsi:type="string">Magento_Ui/js/grid/provider</item>
                    <item name="update_url" xsi:type="url" path="mui/index/render"/>
                    <item name="storageConfig" xsi:type="array">
                        <item name="indexField" xsi:type="string">entity_id</item>
                    </item>
                </item>
            </argument>
        </argument>
    </dataSource>
    <listingToolbar name="listing_top">
        <massaction name="listing_massaction">
            <action name="manager_approve" class="Branch8\MarketplaceProduct\Ui\Component\Listing\Columns\MassActionManagerApprove">
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="type" xsi:type="string">manager_approve</item>
                        <item name="label" xsi:type="string" translate="true">Manager Approve</item>
                        <item name="url" xsi:type="url" path="marketplacectrl/managerProduct/massActionManagerApprove"/>
                        <item name="aclResource" xsi:type="string">Branch8_MarketplaceProduct::manager_product_approval</item>
                        <item name="confirm" xsi:type="array">
                            <item name="title" xsi:type="string" translate="true">Manager Approve Product</item>
                            <item name="message" xsi:type="string" translate="true">Are you sure you want to approve selected items?</item>
                        </item>
                    </item>
                </argument>
            </action>
            <action name="manager_disapprove" class="Branch8\MarketplaceProduct\Ui\Component\Listing\Columns\MassActionManagerDenny">
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="type" xsi:type="string">manager_disapprove</item>
                        <item name="label" xsi:type="string" translate="true">Manager Disapprove</item>
                        <item name="url" xsi:type="url" path="marketplacectrl/managerProduct/massActionManagerDenny"/>
                        <item name="aclResource" xsi:type="string">Branch8_MarketplaceProduct::manager_product_approval</item>
                        <item name="confirm" xsi:type="array">
                            <item name="title" xsi:type="string" translate="true">Manager Disapprove Product</item>
                            <item name="message" xsi:type="string" translate="true">Are you sure you want to disapprove selected items?</item>
                        </item>
                    </item>
                </argument>
            </action>
        </massaction>
    </listingToolbar>
    <columns name="marketplacectrl_products_columns">
        <actionsColumn name="manager_approve" class="Branch8\MarketplaceProduct\Ui\Component\Listing\Columns\ManagerApprove">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="component" xsi:type="string">Branch8_MarketplaceProduct/js/grid/columns/proapprove</item>
                    <item name="indexField" xsi:type="string">mageproduct_id</item>
                    <item name="sortable" xsi:type="boolean">false</item>
                    <item name="label" xsi:type="string" translate="true">Manager Approve</item>
                    <item name="aclResource" xsi:type="string">Branch8_MarketplaceProduct::manager_product_approval</item>
                    <item name="sortOrder" xsi:type="number">19</item>
                </item>
            </argument>
        </actionsColumn>
        <actionsColumn name="manager_deny" class="Branch8\MarketplaceProduct\Ui\Component\Listing\Columns\ManagerDeny">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="component" xsi:type="string">Branch8_MarketplaceProduct/js/grid/columns/prodeny</item>
                    <item name="indexField" xsi:type="string">mageproduct_id</item>
                    <item name="sortable" xsi:type="boolean">false</item>
                    <item name="label" xsi:type="string" translate="true">Manager Deny</item>
                    <item name="aclResource" xsi:type="string">Branch8_MarketplaceProduct::manager_product_approval</item>
                    <item name="sortOrder" xsi:type="number">21</item>
                </item>
            </argument>
        </actionsColumn>
    </columns>
</listing>