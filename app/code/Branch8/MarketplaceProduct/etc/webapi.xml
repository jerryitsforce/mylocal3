<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">

    <!-- Product Service -->
    <route url="/V1/mpapi/sellers/me/product" method="POST">
        <service class="Branch8\MarketplaceProduct\Api\ProductRepositoryInterface" method="saveSellerProduct"/>
        <resources>
            <resource ref="self"/>
        </resources>
        <data>
            <parameter name="id" force="true">%customer_id%</parameter>
        </data>
    </route>
    <route url="/V1/mpapi/sellers/me/product/:sku" method="PUT">
        <service class="Branch8\MarketplaceProduct\Api\ProductRepositoryInterface" method="saveSellerProduct" />
        <resources>
            <resource ref="self"/>
        </resources>
        <data>
            <parameter name="id" force="true">%customer_id%</parameter>
        </data>
    </route>
</routes>
