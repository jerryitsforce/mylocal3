if($customer){
    $nickname = $customer->getFirstName() . ' ' . $customer->getLastName();
    if($customer->getCustomAttribute('nickname')){
        $nickname = $customer->getCustomAttribute('nickname')->getValue();
    } else {
      if (!empty($nickname)) {
          $nickname = mb_convert_encoding($nickname, 'UTF-8', 'auto');
          $nickname = trim($nickname);
          $infoLength = mb_strlen($nickname, 'UTF-8');
          
          if ($infoLength > 1) {
              $maskedPart = str_repeat('○', 2);
              $unmaskedPart = mb_substr($nickname, -1, 1, 'UTF-8');
              $nickname = $maskedPart . $unmaskedPart . ' ';
          }
      }
    }
    $credit_cards = $block->getCreditcardList();
}
