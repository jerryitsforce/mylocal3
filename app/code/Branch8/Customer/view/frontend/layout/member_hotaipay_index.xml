<?xml version="1.0" ?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="1column" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
	<head>
        <title>會員制度</title>
    </head>
	<body>
		<referenceContainer name="after.body.start">
			<block name="info.loader" class="Magento\Framework\View\Element\Template" template="Branch8_Customer::info/loader.phtml"/>
		</referenceContainer>
		<referenceContainer name="content">
			<block name="hotaipay.index" class="Branch8\Customer\Block\Hotaipay\Index" cacheable="false" template="Branch8_Customer::hotaipay/index.phtml">
				<!-- <block class="Magento\Theme\Block\Html\Breadcrumbs" name="breadcrumbs"/>  -->
				<block name="hotaipay.popup.card.binding.fail" class="Branch8\Customer\Block\Hotaipay\Index" template="Branch8_Customer::hotaipay/popup/card_binding_failed.phtml"/>
				<block name="hotaipay.popup.card.binding.complete" class="Branch8\Customer\Block\Hotaipay\PopupComplete" template="Branch8_Customer::hotaipay/popup/card_binding_completed.phtml"/>
				<block name="hotaipay.popup.quick.card" class="Branch8\HotaiPay\Block\CreditCard\ListAction" template="Branch8_Customer::hotaipay/popup/quick_card.phtml"/>
				<block name="hotaipay.popup.reminder.guide" class="Magento\Framework\View\Element\Template" template="Branch8_Customer::hotaipay/popup/reminder_guide.phtml"/>
			</block>
		</referenceContainer>
		<referenceBlock name="breadcrumbs">
			<action method="addCrumb">
					<argument name="crumbName" xsi:type="string" translate="true">Home</argument>
					<argument name="crumbInfo" xsi:type="array">
							<item name="label" xsi:type="string" translate="true">Home</item>
							<item name="title" xsi:type="string" translate="true">Go to Home Page</item>
							<item name="link" xsi:type="string">/</item>
					</argument>
			</action>
			<action method="addCrumb">
					<argument name="crumbName" xsi:type="string" translate="true">認識HOTAI購商城</argument>
					<argument name="crumbInfo" xsi:type="array">
							<item name="label" xsi:type="string" translate="true">認識HOTAI購商城</item>
							<item name="title" xsi:type="string" translate="true">認識HOTAI購商城</item>
					</argument>
			</action>
		</referenceBlock>
		<move element="breadcrumbs" destination="hotaipay.index"/>
		<referenceContainer name="page.bottom">
			<block name="hotaipay.bottom" class="Branch8\Customer\Block\Hotaipay\Index" template="Branch8_Customer::hotaipay/bottom.phtml"/>
		</referenceContainer>
	</body>
</page>