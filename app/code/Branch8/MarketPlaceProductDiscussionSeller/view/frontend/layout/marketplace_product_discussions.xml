<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="seller-2columns-left" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="customer_account"/>
    <update handle="marketplace_styles"/>
    <head>
        <css src="Branch8_MarketPlaceProductDiscussionSeller::css/layout.css"/>
    </head>
    <body>
        <referenceBlock name="seller.page.main.title">
            <action method="setPageTitle">
                <argument translate="true" name="title" xsi:type="string"><![CDATA[Q&A]]></argument>
            </action>
        </referenceBlock>
        <referenceContainer name="seller.content">
            <block class="Magento\Framework\View\Element\Template"
                   name="form"
                   template="Branch8_MarketPlaceProductDiscussionSeller::discussions.phtml"
                   cacheable="false">
                <arguments>
                    <argument name="jsLayout" xsi:type="array">
                        <item name="components" xsi:type="array">
                            <item name="form" xsi:type="array">
                                <item name="component" xsi:type="string">Branch8_MarketPlaceProductDiscussionSeller/js/questioning</item>
                                <item name="config" xsi:type="array">
                                    <item name="configurations" xsi:type="helper"
                                          helper="Branch8\MarketPlaceProductDiscussionSeller\ViewModel\Thread::getConfig"/>
                                </item>
                            </item>
                        </item>
                    </argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
