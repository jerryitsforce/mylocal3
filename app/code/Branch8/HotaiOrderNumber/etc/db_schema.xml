<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
        <table name="sales_parent_order_detail">
                <column xsi:type="varchar" name="hotai_parent_order_number" nullable="true" comment="和泰主訂單編號" />
                <column xsi:type="boolean" name="is_auto_cancelled" nullable="true" default="0" comment="Is Auto Cancelled" />
                <index referenceId="INDEX_HOTAI_PARENT_ORDER_NUMBER" indexType="btree">
                        <column name="hotai_parent_order_number"/>
                </index>
        </table>
        <table name="sales_order">
                <column xsi:type="varchar" name="hotai_child_order_number" nullable="true" comment="和泰子訂單編號" />
                <index referenceId="INDEX_HOTAI_CHILD_ORDER_NUMBER" indexType="btree">
                        <column name="hotai_child_order_number"/>
                </index>
        </table>
        <table name="sales_order_item">
                <column xsi:type="varchar" name="hotai_child_order_item_number" nullable="true" comment="和泰孫訂單編號" />
        </table>

        <table name="marketplace_mpsplitorder" resource="default" engine="innodb" comment="Marketplace Split Order Table">
            <column xsi:type="varchar"
                    nullable="false" length="255"
                    name="hotai_reserved_order_id"
                    comment="Reserved Order ID" />
        </table>
</schema>
