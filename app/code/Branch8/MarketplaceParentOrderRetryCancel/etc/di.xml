<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <virtualType name="retryCancelParentHandleLoggerDebug" type="Magento\Framework\Logger\Handler\Base">
        <arguments>
            <argument name="fileName" xsi:type="string">/var/log/retryCancelParentHandleLoggerDebug.log</argument>
        </arguments>
    </virtualType>
    <virtualType name="retryCancelParentHandleLoggerDebugLogger" type="Magento\Framework\Logger\Monolog">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="debug" xsi:type="object">retryCancelParentHandleLoggerDebug</item>
            </argument>
        </arguments>
    </virtualType>

    <type name="Branch8\MarketplaceParentOrderRetryCancel\Helper\Logger">
        <arguments>
            <argument name="logger" xsi:type="object">retryCancelParentHandleLoggerDebugLogger</argument>
        </arguments>
    </type>
</config>
