<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="marketplace_chat_notification_queue" resource="default" engine="innodb" comment="Chat Notification Queue">
        <column xsi:type="int" name="id" padding="10" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="customer_id" padding="10" unsigned="true" nullable="false" comment="Customer ID"/>
        <column xsi:type="varchar" name="conversation_id" length="128" nullable="false" comment="Conversation ID"/>
        <column xsi:type="int" name="seller_id" padding="10" unsigned="true" nullable="true" comment="Seller ID"/>
        <column xsi:type="smallint" name="store_id" padding="5" unsigned="true" nullable="false" default="0" comment="Store ID"/>
        <column xsi:type="text" name="messages" nullable="true" comment="Pending messages in JSON format"/>
        <column xsi:type="timestamp" name="scheduled_at" on_update="false" nullable="false" comment="Scheduled at"/>
        <column xsi:type="varchar" name="status" length="24" nullable="false" default="pending" comment="Status: pending, sent, cancelled"/>
        <column xsi:type="varchar" name="sender" length="128" nullable="true" comment="Sender Name"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="id"/>
        </constraint>
        <index referenceId="MARKETPLACE_CHAT_NOTIFICATION_QUEUE_CUSTOMER_CONV_STATUS" indexType="btree">
            <column name="customer_id"/>
            <column name="conversation_id"/>
            <column name="status"/>
        </index>
        <index referenceId="MARKETPLACE_CHAT_NOTIFICATION_QUEUE_SCHEDULED_AT" indexType="btree">
            <column name="scheduled_at"/>
        </index>
        <index referenceId="MARKETPLACE_CHAT_NOTIFICATION_QUEUE_STATUS" indexType="btree">
            <column name="status"/>
        </index>
        <index referenceId="MARKETPLACE_CHAT_NOTIFICATION_QUEUE_SELLER_ID" indexType="btree">
            <column name="seller_id"/>
        </index>
        <index referenceId="MARKETPLACE_CHAT_NOTIFICATION_QUEUE_STORE_ID" indexType="btree">
            <column name="store_id"/>
        </index>
        <index referenceId="MARKETPLACE_CHAT_NOTIFICATION_QUEUE_SENDER" indexType="btree">
            <column name="sender"/>
        </index>
        <index referenceId="MARKETPLACE_CHAT_NOTIFICATION_QUEUE_CONVERSATION_ID" indexType="btree">
            <column name="conversation_id"/>
        </index>
    </table>
</schema>
