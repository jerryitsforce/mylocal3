                   name="cancel_form_template"
                   template="Branch8_MarketPlaceParentOrderAdminUi::order/view/actions/cancel_form.phtml">
                <arguments>
                    <argument name="cancel_model" xsi:type="object">Branch8\MarketPlaceParentOrderAdminUi\ViewModel\CancelModel</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
