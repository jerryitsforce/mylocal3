<?xml version="1.0" encoding="UTF-8"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">sales_parent_order_grid.sales_parent_order_grid_data_source</item>
        </item>
    </argument>
    <settings>
        <spinner>sales_parent_order_columns</spinner>
        <deps>
            <dep>sales_parent_order_grid.sales_parent_order_grid_data_source</dep>
        </deps>
    </settings>
    <dataSource name="sales_parent_order_grid_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>Magento_Sales::sales_order</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider"
                      name="sales_parent_order_grid_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>main_table.entity_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <exportButton name="export_button"/>
        <filterSearch name="fulltext"/>
        <filters name="listing_filters">
            <filterSelect name="store_id" provider="${ $.parentName }">
                <settings>
                    <options class="Magento\Store\Ui\Component\Listing\Column\Store\Options"/>
                    <caption translate="true">All Store Views</caption>
                    <label translate="true">Purchase Point</label>
                    <dataScope>store_id</dataScope>
                    <imports>
                        <link name="visible">ns = ${ $.ns }, index = ${ $.index }:visible</link>
                    </imports>
                </settings>
            </filterSelect>
        </filters>
        <massaction name="listing_massaction" component="Magento_Ui/js/grid/tree-massactions">
            <action name="cancel">
                <settings>
                    <url path="sales/parent_order/massCancel"/>
                    <type>cancel</type>
                    <label translate="true">Cancel</label>
                </settings>
            </action>
     <!--       <action name="hold_order">
                <settings>
                    <url path="sales/parent_order/massHold"/>
                    <type>hold_order</type>
                    <label translate="true">Hold</label>
                </settings>
            </action>-->
        </massaction>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="sales_parent_order_columns">
        <settings>
            <childDefaults>
                <param name="fieldAction" xsi:type="array">
                    <item name="provider" xsi:type="string">sales_parent_order_grid.sales_parent_order_grid.sales_parent_order_columns.actions</item>
                    <item name="target" xsi:type="string">applyAction</item>
                    <item name="params" xsi:type="array">
                        <item name="0" xsi:type="string">view</item>
                        <item name="1" xsi:type="string">${ $.$data.rowIndex }</item>
                    </item>
                </param>
            </childDefaults>
        </settings>
        <selectionsColumn name="ids" component="Magento_Sales/js/grid/columns/multiselect">
            <settings>
                <indexField>entity_id</indexField>
            </settings>
        </selectionsColumn>
        <column name="increment_id">
            <settings>
                <filter>text</filter>
                <label translate="true">Order Number</label>
            </settings>
        </column>
        <column name="store_id" class="Magento\Store\Ui\Component\Listing\Column\Store">
            <settings>
                <label translate="true">Purchase Point</label>
                <bodyTmpl>ui/grid/cells/html</bodyTmpl>
                <sortable>false</sortable>
            </settings>
        </column>
        <column name="created_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Purchase Date</label>
                <sorting>desc</sorting>
            </settings>
        </column>
        <column name="customer_email">
            <settings>
                <filter>text</filter>
                <label translate="true">Customer Email</label>
                <visible>true</visible>
            </settings>
        </column>
        <column name="customer_group_id" component="Magento_Ui/js/grid/columns/select">
            <settings>
                <filter>select</filter>
                <options class="Magento\Customer\Ui\Component\Listing\Column\Group\Options"/>
                <dataType>select</dataType>
                <label translate="true">Customer Group</label>
                <visible>true</visible>
            </settings>
        </column>
        <column name="customer_name">
            <settings>
                <filter>text</filter>
                <label translate="true">Customer Name</label>
                <visible>true</visible>
            </settings>
        </column>
        <column name="billing_address">
            <settings>
                <filter>text</filter>
                <label translate="true">Billing Address</label>
            </settings>
        </column>
        <column name="shipping_address">
            <settings>
                <filter>text</filter>
                <label translate="true">Shipping Address</label>
            </settings>
        </column>
        <column name="status" component="Magento_Ui/js/grid/columns/select"
            class="Branch8\MarketPlaceParentOrderAdminUi\Ui\Component\Listing\Column\Status"
        >
            <settings>
                <filter>select</filter>
                <options class="Magento\Sales\Ui\Component\Listing\Column\Status\Options"/>
                <dataType>select</dataType>
                <label translate="true">Order Status</label>
            </settings>
        </column>
        <column name="shipping_method" class="ParentOrderGridShippingMethodSelect">
            <settings>
                <filter>select</filter>
                <options class="Branch8\AdvancedPermissions\Model\Options\ShippingMethod"/>
                <bodyTmpl>ui/grid/cells/html</bodyTmpl>
                <dataType>select</dataType>
                <label translate="true">Shipping Method</label>
                <visible>false</visible>
            </settings>
        </column>
        <column name="seller" class="Branch8\MarketPlaceParentOrderAdminUi\Ui\Component\Listing\Column\Seller">
            <settings>
                <bodyTmpl>ui/grid/cells/html</bodyTmpl>
                <filter>text</filter>
                <label translate="true">Seller Name</label>
                <visible>false</visible>
            </settings>
        </column>
        <column name="nickname" class="Branch8\MarketPlaceParentOrderAdminUi\Ui\Component\Listing\Column\Seller">
            <settings>
                <filter>text</filter>
                <label translate="true">Nickname</label>
                <visible>false</visible>
            </settings>
        </column>
        <column name="phone_number" class="Branch8\MarketPlaceParentOrderAdminUi\Ui\Component\Listing\Column\Seller">
            <settings>
                <filter>text</filter>
                <label translate="true">Mobile Number</label>
                <visible>false</visible>
            </settings>
        </column>
        <column name="salesperson" class="ParentOrderGridSalespersonSelect">
            <settings>
                <filter>select</filter>
                <options class="Branch8\AdvancedPermissions\Model\Options\Salesperson"/>
                <bodyTmpl>ui/grid/cells/html</bodyTmpl>
                <dataType>select</dataType>
                <label translate="true">Salesperson</label>
                <visible>false</visible>
            </settings>
        </column>
        <column name="product_sku" class="ParentOrderGridProductTypeSelect">
            <settings>
                <bodyTmpl>ui/grid/cells/html</bodyTmpl>
                <filter>text</filter>
                <label translate="true">Product SKU</label>
                <visible>false</visible>
            </settings>
        </column>
        <column name="product_name" class="ParentOrderGridProductTypeSelect">
            <settings>
                <bodyTmpl>ui/grid/cells/html</bodyTmpl>
                <filter>text</filter>
                <label translate="true">Product Name</label>
                <visible>false</visible>
            </settings>
        </column>
        <column name="product_type" class="ParentOrderGridProductTypeSelect">
            <settings>
                <bodyTmpl>ui/grid/cells/html</bodyTmpl>
                <filter>select</filter>
                <options class="Magento\Catalog\Model\Product\Type"/>
                <dataType>select</dataType>
                <label translate="true">Product Type</label>
                <visible>false</visible>
            </settings>
        </column>
        <column name="invoice_status" class="Branch8\MarketPlaceParentOrderAdminUi\Ui\Component\Listing\Column\Invoice">
            <settings>
                <bodyTmpl>ui/grid/cells/html</bodyTmpl>
                <filter>select</filter>
                <options class="Magento\Sales\Ui\Component\Listing\Column\Invoice\State\Options"/>
                <dataType>select</dataType>
                <label translate="true">Invoice Status</label>
                <visible>false</visible>
            </settings>
        </column>
        <column name="invoice_modification_date" class="Branch8\MarketPlaceParentOrderAdminUi\Ui\Component\Listing\Column\Date">
            <settings>
                <bodyTmpl>ui/grid/cells/html</bodyTmpl>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Invoice Modification Date</label>
                <visible>false</visible>
            </settings>
        </column>
        <column name="rma_status" sortOrder="76" component="Magento_Ui/js/grid/columns/select">
            <settings>
                <filter>select</filter>
                <dataType>select</dataType>
                <sortable>false</sortable>
                <options class="Branch8\HotaiCore\Model\Config\Source\RmaStatus" />
                <label translate="true">RMA Status</label>
            </settings>
        </column>
        <column name="is_gift_order" component="Magento_Ui/js/grid/columns/select">
            <settings>
                <filter>select</filter>
                <options class="Branch8\GiftToFriend\Model\Config\Source\OrderType"/>
                <dataType>select</dataType>
                <label translate="true">Order Type</label>
                <visible>true</visible>
            </settings>
        </column>
        <actionsColumn name="actions" class="Branch8\MarketPlaceParentOrderAdminUi\Ui\Component\Listing\Column\ViewAction">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="viewUrlPath" xsi:type="string">sales/parent_order/view</item>
                    <item name="pdfUrlPath" xsi:type="string">sales/parent_order/DownLoadPDF</item>
                    <item name="urlEntityParamName" xsi:type="string">id</item>
                </item>
            </argument>
            <settings>
                <indexField>entity_id</indexField>
            </settings>
        </actionsColumn>
    </columns>
</listing>
