<?xml version="1.0" ?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magento_Sales::sales" title="Sales" translate="title" sortOrder="20">
                    <resource id="Magento_Sales::sales_operation" title="Operations" translate="title" sortOrder="10">
                        <resource id="Branch8_MarketPlaceParentOrderAdminUi::parent_orders"
                                  title="Manage Parent Orders" translate="title" sortOrder="10">
                            <resource id="Branch8_MarketPlaceParentOrderAdminUi::actions" title="Actions"
                                      translate="title" sortOrder="10">
                                <resource id="Branch8_MarketPlaceParentOrderAdminUi::actions_view"
                                          title="View Parent Order" translate="title"
                                          sortOrder="20"/>
                                <resource id="Branch8_MarketPlaceParentOrderAdminUi::email"
                                          title="Send Parent Order Email" translate="title"
                                          sortOrder="30"/>
                                <resource id="Branch8_MarketPlaceParentOrderAdminUi::reorder"
                                          title="Reorder Parent Order" translate="title" sortOrder="40"/>
                                <resource id="Branch8_MarketPlaceParentOrderAdminUi::hold"
                                          title="Hold Parent Order" translate="title"
                                          sortOrder="100"/>
                                <resource id="Branch8_MarketPlaceParentOrderAdminUi::unHold"
                                          title="Un Hold Parent Order" translate="title"
                                          sortOrder="150"/>
                                <resource id="Branch8_MarketPlaceParentOrderAdminUi::cancel" title="Cancel Parent Order"
                                          translate="title" sortOrder="60"/>
                                <resource id="Branch8_MarketPlaceParentOrderAdminUi::comment"
                                          title="Comment Parent Order" translate="title"
                                          sortOrder="200"/>
                                <resource id="Branch8_MarketPlaceParentOrderAdminUi::edit"
                                          title="Edit Parent Order" translate="title"
                                          sortOrder="250"/>
                            </resource>
                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
