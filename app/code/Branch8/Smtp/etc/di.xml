<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Mageplaza\Smtp\Controller\Adminhtml\Smtp\AbandonedCart\Send"
                type="Branch8\Smtp\Controller\Adminhtml\Smtp\AbandonedCart\Send"/>
    <type name="Magento\Framework\Mail\TransportInterface">
        <plugin name="mageplaza_mail_transport" disabled="true"/>
        <plugin name="b8_smtp_mail_transport" type="Branch8\Smtp\Mail\Transport" sortOrder="1" disabled="false"/>
    </type>
    <type name="Mageplaza\Smtp\Model\Log">
        <plugin name="b8_smtp_mail_transport_log" type="Branch8\Smtp\Plugin\Mageplaza\Smtp\Model\Log" sortOrder="1" disabled="false"/>
    </type>
    <type name="Mageplaza\Smtp\Cron\ClearLog">
        <plugin name="b8_smtp_mail_transport_log" type="Branch8\Smtp\Plugin\Mageplaza\Smtp\Cron\ClearLog" sortOrder="1" disabled="false"/>
    </type>
    <preference for="Magento\Framework\Mail\Template\TransportBuilder"
                type="Branch8\Smtp\Framework\Mail\Template\TransportBuilder"/>
</config>
