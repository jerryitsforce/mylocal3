<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="marketplace_userdata" resource="default" engine="innodb" comment="Marketplace User Data">
        <column xsi:type="smallint" name="shipping_subsidy_enabled" unsigned="true" nullable="true" default="0" comment="Enable Custom Shipping Subsidy"/>
        <column xsi:type="smallint" name="use_default_shipping_subsidy_enabled" unsigned="true" nullable="true" default="1" comment="Use Default Shipping Subsidy Enabled"/>
        <column xsi:type="varchar" name="shipping_subsidy_mode" length="10" nullable="true" default="percent" comment="Subsidy Mode (percent/fixed)"/>
        <column xsi:type="smallint" name="use_default_subsidy_mode" unsigned="true" nullable="true" default="1" comment="Use Default Subsidy Mode"/>
        <column xsi:type="decimal" name="shipping_subsidy_home_delivery" scale="4" precision="12" unsigned="true" nullable="true" comment="Shipping Subsidy for Home Delivery"/>
        <column xsi:type="smallint" name="use_default_home_delivery" unsigned="true" nullable="true" default="1" comment="Use Default Home Delivery"/>
        <column xsi:type="decimal" name="shipping_subsidy_store_pickup" scale="4" precision="12" unsigned="true" nullable="true" comment="Shipping Subsidy for Store Pickup"/>
        <column xsi:type="smallint" name="use_default_store_pickup" unsigned="true" nullable="true" default="1" comment="Use Default Store Pickup"/>
    </table>

    <table name="quote_item" resource="default" engine="innodb" comment="Quote Item">
        <column xsi:type="decimal" name="seller_shipping_amount" scale="4" precision="12" unsigned="false" nullable="true" comment="Seller Shipping Amount"/>
        <column xsi:type="decimal" name="platform_shipping_amount" scale="4" precision="12" unsigned="false" nullable="true" comment="Platform Shipping Amount"/>
        <column xsi:type="text" name="shipping_subsidy_config" nullable="true"  comment="shipping Subsidy config"/>
    </table>

    <table name="sales_order_item" resource="default" engine="innodb" comment="Sales Order Item">
        <column xsi:type="decimal" name="seller_shipping_amount" scale="4" precision="12" unsigned="false" nullable="true" comment="Seller Shipping Amount"/>
        <column xsi:type="decimal" name="platform_shipping_amount" scale="4" precision="12" unsigned="false" nullable="true" comment="Platform Shipping Amount"/>
        <column xsi:type="text" name="shipping_subsidy_config" nullable="true"  comment="shipping Subsidy config"/>
    </table>

    <table name="quote">
        <column xsi:type="tinyint" name="is_sub_quote" default="0" nullable="false" unsigned="false"/>
        <column xsi:type="decimal" name="seller_shipping_amount" scale="4" precision="12" unsigned="false" nullable="true" comment="Seller Shipping Amount"/>
        <column xsi:type="decimal" name="platform_shipping_amount" scale="4" precision="12" unsigned="false" nullable="true" comment="Platform Shipping Amount"/>
        <column xsi:type="text" name="shipping_subsidy_config" nullable="true" comment="Shipping Subsidy Config"/>
    </table>

    <table name="sales_order">
        <column xsi:type="decimal" name="seller_shipping_amount" scale="4" precision="12" unsigned="false" nullable="true" comment="Seller Shipping Amount"/>
        <column xsi:type="decimal" name="platform_shipping_amount" scale="4" precision="12" unsigned="false" nullable="true" comment="Platform Shipping Amount"/>
        <column xsi:type="text" name="shipping_subsidy_config" nullable="true" comment="Shipping Subsidy Config"/>
    </table>
</schema>
