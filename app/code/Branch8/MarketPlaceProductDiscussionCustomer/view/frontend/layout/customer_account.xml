<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="sidebar.main">
            <referenceBlock  name="customer_nav_top">
                <block class="Branch8\Customer\Block\Account\Link"
                       name="customer-nav-top-product-question-link" template="Branch8_Customer::account/link.phtml"
                       ifconfig="product_discussion/general/enabled"
                >
                    <arguments>
                        <argument name="path" xsi:type="string">product_discussion/member/questioning</argument>
                        <argument name="label" xsi:type="string" translate="true"><![CDATA[Product Q&A]]></argument>
                        <argument name="css_class" xsi:type="string">product-question</argument>
                        <argument name="sortOrder" xsi:type="number">60</argument>
                    </arguments>
                </block>
            </referenceBlock>
        </referenceContainer>
    </body>
</page>
