<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <attribute name="class" value="thread-custom-page"/>
        <referenceContainer name="content">
            <block class="Branch8\MarketPlaceProductDiscussionCustomer\Block\Product\Discussions\ListDiscussions"
                   name="branch8_product_list_disscussion_block"
                   template="Branch8_MarketPlaceProductDiscussionCustomer::product/list.phtml"
            >
                <arguments>
                    <argument name="jsLayout" xsi:type="array">
                        <item name="components" xsi:type="array">
                            <item name="threadsComponent" xsi:type="array">
                                <item name="component" xsi:type="string">Branch8_MarketPlaceProductDiscussionCustomer/js/product/list</item>
                                <item name="configurations" xsi:type="helper"
                                      helper="Branch8\MarketPlaceProductDiscussionCustomer\ViewModel\Thread::getConfigForListPage"/>
                                <item name="children" xsi:type="array">
                                    <item name="askQuestionComponent" xsi:type="array">
                                        <item name="component" xsi:type="string">Branch8_MarketPlaceProductDiscussionCustomer/js/view/askQuestion</item>
                                        <item name="displayArea" xsi:type="string">askQuestionComponent</item>
                                        <item name="configurations" xsi:type="helper"
                                              helper="Branch8\MarketPlaceProductDiscussionCustomer\ViewModel\Thread::getAskForQuestionConfig"/>
                                        <item name="config" xsi:type="array">
                                            <item name="template" xsi:type="string">Branch8_MarketPlaceProductDiscussionCustomer/ask-question</item>
                                        </item>
                                        <item name="createThreadUrl" xsi:type="string">marketplace/discussion/thread/create</item>
                                    </item>
                                </item>
                            </item>
                        </item>
                    </argument>
                </arguments>
            </block>
        </referenceContainer>

    </body>
</page>
