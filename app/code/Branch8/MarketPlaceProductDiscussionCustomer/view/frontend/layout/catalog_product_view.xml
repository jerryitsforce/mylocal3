<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="review_product_form_component"/>
    <body>
        <referenceBlock name="product.info.details">
            <block class="Branch8\MarketPlaceProductDiscussionCustomer\Block\Product\Discussion"
                   name="discussion.tab" as="discussions" template="Branch8_MarketPlaceProductDiscussionCustomer::product/disscustions.phtml"
                   group="detailed_info" >
                <arguments>
                    <argument name="sort_order" xsi:type="string">25</argument>
                    <argument name="jsLayout" xsi:type="array">
                        <item name="components" xsi:type="array">
                            <item name="threadsComponent" xsi:type="array">
                                <item name="component" xsi:type="string">Branch8_MarketPlaceProductDiscussionCustomer/js/product/list</item>
                                <item name="configurations" xsi:type="helper"
                                      helper="Branch8\MarketPlaceProductDiscussionCustomer\ViewModel\Thread::getConfigForProductPage"/>
                            </item>
                            <item name="askQuestionComponent" xsi:type="array">
                                <item name="component" xsi:type="string">Branch8_MarketPlaceProductDiscussionCustomer/js/view/askQuestion</item>
                                <item name="configurations" xsi:type="helper"
                                      helper="Branch8\MarketPlaceProductDiscussionCustomer\ViewModel\Thread::getAskForQuestionConfig"/>
                                <item name="config" xsi:type="array">
                                    <item name="template" xsi:type="string">Branch8_MarketPlaceProductDiscussionCustomer/ask-question</item>
                                </item>
                                <item name="createThreadUrl" xsi:type="string">marketplace/discussion/thread/create</item>
                            </item>
                        </item>
                    </argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>
