<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="branch8" translate="label" sortOrder="400">
            <label>Branch8</label>
        </tab>
        <section id="product_discussion" sortOrder="100" showInWebsite="0" showInStore="0" showInDefault="1"
                 translate="label">
            <group id="general" sortOrder="10" showInWebsite="1" showInStore="1" showInDefault="1" translate="label">
                <label>General</label>
                <field id="max_length_input" translate="label" type="text" sortOrder="5" showInDefault="1" showInWebsite="1"
                       showInStore="1">
                    <label>Max Content Input</label>
                </field>
                <field id="submit_rate_limit" translate="label" type="text" sortOrder="5" showInDefault="1" showInWebsite="1"
                       showInStore="1">
                    <label>Submit Rate Limit</label>
                </field>
            </group>
            <group id="customer" sortOrder="10" showInWebsite="1" showInStore="1" showInDefault="1" translate="label">
                <label>Customer</label>
                <field id="page_size" translate="label" type="text" sortOrder="5" showInDefault="1" showInWebsite="1"
                       showInStore="1">
                    <label>Page Size</label>
                </field>
                <field id="enable_email_notification" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Email Notification to Seller</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="email_template" translate="label" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Email Template</label>
                    <source_model>Magento\Config\Model\Config\Source\Email\Template</source_model>
                    <comment>Email template sent to seller when customer creates a new question.</comment>
                    <depends>
                        <field id="enable_email_notification">1</field>
                    </depends>
                </field>
            </group>
        </section>
    </system>
</config>
