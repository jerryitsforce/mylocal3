        <item name="importSeller" xsi:type="object">Branch8\SellerContactInformation\Console\Command\ImportSeller</item>
        <item name="importAdminUser" xsi:type="object">Branch8\SellerContactInformation\Console\Command\ImportAdminUser</item>
			</argument>
		</arguments>
	</type>
    <type name="Magento\Ui\Model\Export\MetadataProvider">
