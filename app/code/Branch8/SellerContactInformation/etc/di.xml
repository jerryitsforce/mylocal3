<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Webkul\Marketplace\Block\Adminhtml\Customer\Edit\Tabs" type="Branch8\SellerContactInformation\Block\Adminhtml\Customer\Edit\Tabs"/>
