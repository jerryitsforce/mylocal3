        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="seller_contract_history_data_source" xsi:type="string">SellerContractHistoryCollection</item>
            </argument>
        </arguments>
    </type>
    <virtualType name="SellerContractHistoryCollection" type="Branch8\SellerContactInformation\DataProvider\History\Collection">
        <arguments>
            <argument name="mainTable" xsi:type="string">seller_contract_logs</argument>
            <argument name="resourceModel" xsi:type="string">Branch8\SellerContactInformation\Model\ResourceModel\ContractLog</argument>
        </arguments>
    </virtualType>
