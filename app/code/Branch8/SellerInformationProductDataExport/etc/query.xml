<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_QueryXml:etc/query.xsd">
    <query name="sellerIdQuery">
        <source name="marketplace_product">
            <attribute name="seller_id" alias="IndexSellerId"/>
            <attribute name="mage_pro_row_id"/>
            <attribute name="mageproduct_id" alias="ProductId"/>
            <link-source name="catalog_product_entity" link-type="inner">
                <attribute name="sku"/>
                <attribute name="entity_id" alias="productID"/>
                <using glue="and">
                    <condition attribute="row_id" operator="eq" type="identifier">mage_pro_row_id</condition>
                </using>
                <filter glue="and">
                    <condition attribute="entity_id" operator="in" type="placeholder">ids</condition>
                </filter>
            </link-source>
        </source>
    </query>
</config>
