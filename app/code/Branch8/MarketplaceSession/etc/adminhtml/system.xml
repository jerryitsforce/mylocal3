<?xml version="1.0" ?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="marketplace_session" translate="label" type="text" sortOrder="1000" showInDefault="1" showInWebsite="1" showInStore="1">
            <class>separator-top</class>
            <label>Marketplace Session</label>
            <tab>branch8</tab>
            <resource>Branch8_MarketplaceSession::config</resource>
            <group id="general" translate="label" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General</label>
                <field id="enable" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Enable</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>If enabled, frontend customer and seller will use different session, which means user can login both account at the same time.</comment>
                </field>
                <field id="additional_routes" translate="label" type="textarea" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Additional Routes</label>
                    <comment>Enter additional routes (one per line) that should use marketplace session. These routes will be checked along with the default target routes.(ex: /johndoe/marketplace)</comment>
                </field>
            </group>
        </section>
    </system>
</config>