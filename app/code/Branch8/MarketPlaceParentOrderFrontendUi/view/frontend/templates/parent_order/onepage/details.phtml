                            $telephone = $order->getShippingAddress()->getTelephone();
                        }
                        if($order->getShippingAddress()->getFirstName() || $order->getShippingAddress()->getLastName()){
                            $receiptionName = $order->getShippingAddress()->getFirstName();
                        }
                    }elseif($order->getBillingAddress()){
                        if($order->getBillingAddress()->getTelephone()){
                        // Fallback to billing address if no shipping address or shipping address phone is missing
                            $telephone = $order->getBillingAddress()->getTelephone();
                        }

                        if($order->getBillingAddress()->getFirstName() || $order->getBillingAddress()->getLastName()){
                            $receiptionName = $order->getBillingAddress()->getFirstName();
                        }
                    }

                    ?>
                    <?php if($receiptionName): ?>
