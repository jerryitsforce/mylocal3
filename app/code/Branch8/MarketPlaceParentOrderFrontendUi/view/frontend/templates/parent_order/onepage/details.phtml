$giftHelper = $this->helper(\Branch8\GiftToFriend\Helper\Data::class);
$giftConfirmHelper = $this->helper(\Branch8\GiftToFriend\Helper\Confirm::class);
$customerInfoHelper = $this->helper('Branch8\Customer\Helper\Info');
$flagshipStoreSaleHelper = $this->helper(\Branch8\FlagshipStore\Helper\Sales::class);
$totals = $block->getTotals(); // Retrieve all totals from the block

// Initialize variables to hold specific totals
$grandTotal = 0;
$shippingAmount = 0;
$discountAmount = 0;
$subtotal = 0;
$discountValue = 0;
foreach ($totals as $total) {
    switch ($total->getCode()) {
        case 'grand_total':
            $grandTotal = $total->getValue();
            break;
        case 'shipping_include_tax':
            $shippingAmount = $total->getValue();
            break;
        case 'point_discount':
            $discountAmount = $total->getValue();
            break;
        case 'discount':
            $discountValue = $total->getValue();
            break;
        case 'subtotal_include_tax':
            $subtotal = $total->getValue();
            break;
    }
}

$block->getCartData($block->getOrder()->getDetail()->getCustomerId());
$giftEnabled = $giftHelper->isFeatureEnable();
$showShippingInfo = true;
if($giftEnabled && $block->getOrder()->getDetail()->getIsGiftOrder() && !$block->getOrder()->getDetail()->getIsGiftConfirmed()) {
    $showShippingInfo = false;
}
?>
