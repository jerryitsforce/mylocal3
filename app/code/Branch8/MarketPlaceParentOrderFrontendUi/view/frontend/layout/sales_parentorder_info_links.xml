<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content">
            <block class="Magento\Framework\View\Element\Html\Links" as="links" name="sales.parentorder.info.links" before="-">
                <arguments>
                    <argument name="css_class" xsi:type="string">items order-links</argument>
                </arguments>
                <block class="Branch8\MarketPlaceParentOrderFrontendUi\Block\ParentOrder\Link" name="sales.parentorder.info.links.information">
                    <arguments>
                        <argument name="path" xsi:type="string">sales/parentOrder/view</argument>
                        <argument name="label" xsi:type="string" translate="true">Items Ordered</argument>
                    </arguments>
                </block>
                <block class="Branch8\MarketPlaceParentOrderFrontendUi\Block\ParentOrder\Link" name="sales.parentorder.info.links.invoice">
                    <arguments>
                        <argument name="key" xsi:type="string">Invoices</argument>
                        <argument name="path" xsi:type="string">sales/parentOrder/invoice</argument>
                        <argument name="label" xsi:type="string" translate="true">Invoices</argument>
                    </arguments>
                </block>
                <block class="Branch8\MarketPlaceParentOrderFrontendUi\Block\ParentOrder\Link" name="sales.parentorder.info.links.shipment">
                    <arguments>
                        <argument name="key" xsi:type="string">Shipments</argument>
                        <argument name="path" xsi:type="string">sales/parentOrder/shipment</argument>
                        <argument name="label" xsi:type="string" translate="true">Order Shipments</argument>
                    </arguments>
                </block>
                <block class="Branch8\MarketPlaceParentOrderFrontendUi\Block\ParentOrder\Link" name="sales.parentorder.info.links.creditmemo">
                    <arguments>
                        <argument name="key" xsi:type="string">Creditmemos</argument>
                        <argument name="path" xsi:type="string">sales/parentOrder/creditmemo</argument>
                        <argument name="label" xsi:type="string" translate="true">Refunds</argument>
                    </arguments>
                </block>
            </block>
        </referenceContainer>
    </body>
</page>
