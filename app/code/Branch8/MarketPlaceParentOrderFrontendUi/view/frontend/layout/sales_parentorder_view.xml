<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="customer_account"/>
    <update handle="sales_order_item_renderers"/>
    <update handle="sales_order_item_price"/>
    <update handle="sales_parentorder_info_links"/>
    <body>
        <referenceContainer name="page.main.title">
            <block class="Branch8\MarketPlaceParentOrderFrontendUi\Block\ParentOrder\Info" name="parentorder.status"
                   template="Branch8_MarketPlaceParentOrderFrontendUi::parent_order/order_status.phtml"/>
            <block class="Branch8\MarketPlaceParentOrderFrontendUi\Block\ParentOrder\Info" name="parentorder.date"
                   template="Branch8_MarketPlaceParentOrderFrontendUi::parent_order/order_date.phtml"/>
            <container name="order.actions.container" htmlTag="div" htmlClass="actions-toolbar order-actions-toolbar">
                <block class="Branch8\MarketPlaceParentOrderFrontendUi\Block\ParentOrder\Info\Buttons" as="buttons"
                       name="sales.parentorder.info.buttons"
                       cacheable="false"/>
            </container>
        </referenceContainer>
        <referenceContainer name="sales.parentorder.info.buttons">
            <block class="Branch8\MarketPlaceParentOrderFrontendUi\Block\ParentOrder\Info\Buttons\Rss"
                   as="buttons.rss"
                   name="sales.parentorder.info.buttons.rss" cacheable="false"/>
        </referenceContainer>
        <referenceContainer name="content">
            <block class="Branch8\MarketPlaceParentOrderFrontendUi\Block\ParentOrder\View"
                   name="parent.order.comments"
                   template="Branch8_MarketPlaceParentOrderFrontendUi::parent_order/order_comments.phtml"
                   before="sales.parentorder.info.links"/>
            <block class="Branch8\MarketPlaceParentOrderFrontendUi\Block\ParentOrder\View"
                   name="sales.parentorder.view" cacheable="false"
                   after="sales.parentorder.info.links">
                <block class="Branch8\MarketPlaceParentOrderFrontendUi\Block\ParentOrder\Items"
                       name="order_items"
                       template="Branch8_MarketPlaceParentOrderFrontendUi::parent_order/order_items.phtml">
                    <block class="Magento\Framework\View\Element\RendererList"
                           name="sales.order.items.renderers"
                           as="renderer.list"/>
                    <block class="Magento\Theme\Block\Html\Pager"
                           name="sales_order_item_pager"/>
                    <block class="Branch8\MarketPlaceParentOrderFrontendUi\Block\ParentOrder\Totals"
                           name="order_totals"
                           template="Branch8_MarketPlaceParentOrderFrontendUi::parent_order/totals.phtml">
                        <arguments>
                            <argument name="label_properties" xsi:type="string">colspan="4" class="mark"</argument>
                            <argument name="value_properties" xsi:type="string">class="amount"</argument>
                        </arguments>
                        <!-- <block class="Magento\Tax\Block\Sales\Order\Tax" name="tax"
                                template="Magento_Tax::order/tax.phtml"/>-->
                    </block>
                    <!-- <block class="Branch8\MarketPlaceParentOrderFrontendUi\Block\ParentOrder\Totals"
                           name="order_progress"
                           template="Branch8_MarketPlaceParentOrderFrontendUi::parent_order/order_progress.phtml">
                    </block> -->
                </block>
            </block>

            <block class="Branch8\MarketPlaceParentOrderFrontendUi\Block\ParentOrder\Info"
                   as="info" name="sales.parentorder.info"
                   after="sales.parentorder.view"/>
        </referenceContainer>

        <referenceBlock name="additional.product.info">
            <block class="Magento\Framework\View\Element\Template"
                   name="marketplace_seller_sales_item"/>
        </referenceBlock>
        <referenceBlock name="marketplace_seller_sales_item">
            <action method="setTemplate" ifconfig="marketplace/profile_settings/seller_profile_display">
                <argument name="template" xsi:type="string">Webkul_Marketplace::sales/item/default.phtml</argument>
            </action>
            <arguments>
                <argument name="profile_helper" xsi:type="object">Webkul\Marketplace\ViewModel\Profile</argument>
            </arguments>
        </referenceBlock>
        <block class="Magento\Framework\View\Element\Template" name="additional.product.info" template="Magento_Theme::template.phtml"/>
    </body>
</page>
