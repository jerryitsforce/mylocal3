?>

<div class="wk-row action">
    <span><?= $escaper->escapeHtml(__("Resolution Type")); ?> :</span>
    <?php if ($canAdjustShippingStatus): ?>
    <a href="javascript:void(0)" data-role="trigger-show-resolution-popup">
        <?php endif ?>
        <?= $escaper->escapeHtml($resolution); ?>
        <span class="icon-edit edit" aria-hidden="true"></span>
        <?php if ($canAdjustShippingStatus): ?>
    </a>
<?php endif ?>
</div>

<?php
$data = [
    'rmaId' => $rmaModel->getHelper()->encrypt($rmaDetails->getId()),
    'submitUrl' => $rmaModel->getChangResolutionTypeUrl(),
    'currentResolutionType' => $resolutionType,
    'form_key' => $rmaModel->getFormKey(),
];
?>
<script type="text/x-magento-init">
    {
        "body": {
            "Branch8_Rma/js/SwitchResolution": <?= $rmaModel->jsonEncode($data) ?>
    }
}
</script>
<?php if ($canAdjustShippingStatus): ?>
