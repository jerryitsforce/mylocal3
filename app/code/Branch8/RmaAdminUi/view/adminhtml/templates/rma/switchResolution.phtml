?>
<?php
$statusResolver = $block->getStatusModel() ? $block->getStatusModel() : \Magento\Framework\App\ObjectManager::getInstance()->get(
    \Branch8\Sales\ViewModel\StatusResolver::class
);
$rmaModel = $block->getData('rma_model');
$resolutionOptions = $rmaModel->getResolutionOptions();
$rmaDetails = $rmaModel->getRmaDetails();
$resolutionType = (int)$rmaDetails->getResolutionType();
$resolution = $rmaModel->getHelper()->getResolutionTypeTitle($resolutionType);
