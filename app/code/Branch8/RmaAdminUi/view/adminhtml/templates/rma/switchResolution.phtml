        <fieldset class="fieldset admin__fieldset " id="base_fieldset">
            <div class="admin__field field field-entity  with-addon admin__field field field-entity">
                <label class="label admin__field-label"
                       for="resolution_<?= \Branch8\Rma\Model\Rma\Resolution::RESOLUTION_TYPE_RETURN_REFUND ?>">
                    <span><?= __('Return') ?></span>
                </label>
                <div class="admin__field-control control">
                    <div class="admin__field">
                        <input type="radio" name="resolutiontype[]"
                               id="resolution_<?= \Branch8\Rma\Model\Rma\Resolution::RESOLUTION_TYPE_RETURN_REFUND ?>"
                               value="<?= \Branch8\Rma\Model\Rma\Resolution::RESOLUTION_TYPE_RETURN_REFUND ?>"
                               <?php if ($resolutionType === \Branch8\Rma\Model\Rma\Resolution::RESOLUTION_TYPE_RETURN_REFUND): ?>checked<?php endif; ?>
