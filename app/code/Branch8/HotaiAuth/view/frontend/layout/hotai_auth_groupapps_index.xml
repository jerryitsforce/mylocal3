<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="customer_account"/>
    <body>
        <referenceBlock name="page.main.title">
            <action method="setPageTitle">
                <argument translate="true" name="title" xsi:type="string">Hotai Group About Services</argument>
            </action>
        </referenceBlock>
        <referenceContainer name="content">
            <block
                class="Branch8\HotaiAuth\Block\Account\GroupApps"
                name="hotai.auth.account.groupapps"
                template="Branch8_HotaiAuth::Account/GroupApps.phtml">
            </block>
        </referenceContainer>
    </body>
</page>
