<?xml version="1.0" encoding="UTF-8"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd" class="Branch8\MarketPlaceOrderExportAdminUi\Ui\Component\Listing">
    <settings>
        <buttons>
            <button name="excel_downloadOrderNotification">
                <url path="sales/order/downloadOrderNotification"/>
                <label translate="true">Download Order Notification</label>
                <aclResource>Magento_Sales::sales_download_order_notification</aclResource>
            </button>
        </buttons>
    </settings>
    <listingToolbar name="listing_top">
        <massaction name="listing_massaction" class="Branch8\MarketPlaceOrderExportAdminUi\Ui\Component\Sales\Order\MassAction">
            <action name="excel_downloadOrderFile">
                <settings>
                    <url path="sales/order/downloadOrderFile"/>
                    <type>excel_downloadOrderFile</type>
                    <label translate="true">Download Order File</label>
                </settings>
            </action>
        </massaction>
    </listingToolbar>
</listing>
